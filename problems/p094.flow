# Project Euler 094
# Sum of perimeters of almost equilateral triangles with integer sides ≤ 1e9.

function is_square(n: i64) -> bool {
    if n < 0 { return false }
    let mut x: i64 = n
    while x > 1 {
        let y: i64 = (x + n / x) / 2
        if y >= x { break }
        x = y
    }
    let mut r: i64 = x
    while r * r > n { r = r - 1 }
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r * r == n
}

function main() -> i32 {
    let limit: i64 = 1000000000
    let mut total: i64 = 0
    # solutions of u^2 - 3v^2 = 4 generated by multiplying by 2+√3
    let mut u: i64 = 2
    let mut v: i64 = 0
    let mut iter: i32 = 0
    while iter < 40 {
        let nu: i64 = 2 * u + 3 * v
        let nv: i64 = u + 2 * v
        u = nu
        v = nv
        # u = 3a±1 ⇒ candidate odd a
        if (u - 1) % 3 == 0 {
            let a: i64 = (u - 1) / 3
            if a > 1 {
                let mut d: i64 = 0 - 1
                while d <= 1 {
                    if d != 0 {
                        let perim: i64 = 3 * a + d
                        if perim > 0 && perim <= limit {
                            let base: i64 = a + d
                            let h2: i64 = 4 * a * a - base * base
                            if h2 % 4 == 0 && is_square(h2 / 4) {
                                total = total + perim
                            }
                        }
                    }
                    d = d + 2
                }
            }
        }
        if (u + 1) % 3 == 0 {
            let a: i64 = (u + 1) / 3
            if a > 1 {
                let mut d: i64 = 0 - 1
                while d <= 1 {
                    if d != 0 {
                        let perim: i64 = 3 * a + d
                        if perim > 0 && perim <= limit {
                            let base: i64 = a + d
                            let h2: i64 = 4 * a * a - base * base
                            if h2 % 4 == 0 && is_square(h2 / 4) {
                                total = total + perim
                            }
                        }
                    }
                    d = d + 2
                }
            }
        }
        iter = iter + 1
    }
    printf("%lld\n", total)
    return 0
}
