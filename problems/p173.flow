# Project Euler 173
# Hollow square laminae with up to 10^6 tiles.

function isqrt(n: i64) -> i64 {
    let mut x: i64 = 1
    while x * x <= n {
        x = x + 1
    }
    return x - 1
}

function main() -> i32 {
    let tiles: i64 = 1000000
    let c: i64 = tiles / 4
    let xm: i64 = isqrt(c)
    let mut total: i64 = 0
    let mut x: i64 = 1
    while x <= xm {
        total = total + c / x
        x = x + 1
    }
    total = total - xm * (xm + 1) / 2
    printf("%lld\n", total)
    return 0
}
