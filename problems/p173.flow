# Project Euler 173
# Hollow square laminae with up to 10^6 tiles.

import euler.nt { isqrt }

function main() -> i32 {
    let tiles: i64 = 1000000
    let c: i64 = tiles / 4
    let xm: i64 = isqrt(c)
    let mut total: i64 = 0
    for x in 1..(xm + 1) {
        total = total + c / x
    }
    total = total - xm * (xm + 1) / 2
    printf("%lld\n", total)
    return 0
}
