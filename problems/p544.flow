# Project Euler 544
# Chromatic Conundrum — S(9,10,1112131415) mod 10^9+7.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

const MOD: i64 = 1000000007
const EMPTY: i64 = -1
const R: i64 = 9
const C: i64 = 10
const TARGET: i64 = 1112131415
const MAXDEG: i64 = 92
const CAP: i64 = 131072

function modpow(b0: i64, e0: i64, mod: i64) -> i64 {
    let mut r: i64 = 1
    let mut b: i64 = b0 % mod
    let mut e: i64 = e0
    while e > 0 {
        if (e & 1) != 0 { r = ((r as i128) * (b as i128) % (mod as i128)) as i64 }
        b = ((b as i128) * (b as i128) % (mod as i128)) as i64
        e = e >> 1
    }
    return r
}

function encode(st: ptr<i64>, n: i64) -> i64 {
    let mut key: i64 = 0
    let mut mul: i64 = 1
    let mut i: i64 = 0
    while i < n {
        key = key + (st[i] + 1) * mul
        mul = mul * 10
        i = i + 1
    }
    return key
}

function decode(key: i64, st: ptr<i64>, n: i64) -> void {
    let mut i: i64 = 0
    let mut k: i64 = key
    while i < n {
        st[i] = (k % 10) - 1
        k = k / 10
        i = i + 1
    }
}

function canon(st: ptr<i64>, out: ptr<i64>, n: i64) -> void {
    let mp: ptr<i64> = calloc(n + 1, 8)
    if mp == null { return }
    let mut i: i64 = 0
    while i <= n { mp[i] = -1; i = i + 1 }
    let mut nxt: i64 = 0
    i = 0
    while i < n {
        let x: i64 = st[i]
        if x == EMPTY {
            out[i] = EMPTY
        } else {
            let mut y: i64 = mp[x]
            if y == -1 {
                y = nxt
                mp[x] = y
                nxt = nxt + 1
            }
            out[i] = y
        }
        i = i + 1
    }
    free(mp)
}

function max_label(st: ptr<i64>, n: i64) -> i64 {
    let mut mx: i64 = EMPTY
    let mut i: i64 = 0
    while i < n {
        if st[i] > mx { mx = st[i] }
        i = i + 1
    }
    return mx
}

function hslot(key: i64, keys: ptr<i64>, used: ptr<i8>) -> i64 {
    let mut h: i64 = key % CAP
    if h < 0 { h = h + CAP }
    while used[h] == 1 && keys[h] != key {
        h = h + 1
        if h == CAP { h = 0 }
    }
    return h
}

function poly_copy(src: ptr<i64>, slen: i64, dst: ptr<i64>) -> i64 {
    let mut i: i64 = 0
    while i < slen { dst[i] = src[i]; i = i + 1 }
    return slen
}

function add_poly(tgt: ptr<i64>, tlen: ptr<i64>, poly: ptr<i64>, plen: i64) -> void {
    if tlen[0] < plen { tlen[0] = plen }
    let mut j: i64 = 0
    while j < plen {
        let mut x: i64 = tgt[j] + poly[j]
        if x >= MOD { x = x - MOD }
        tgt[j] = x
        j = j + 1
    }
}

function add_q_minus_m(tgt: ptr<i64>, tlen: i64, poly: ptr<i64>, plen: i64, m: i64) -> i64 {
    let need: i64 = plen + 1
    let mut out_len: i64 = tlen
    if out_len < need { out_len = need }
    let mm: i64 = m % MOD
    let mut j: i64 = 0
    while j < plen {
        let mut x: i64 = tgt[j] - (mm * poly[j]) % MOD
        if x < 0 { x = x + MOD }
        tgt[j] = x
        x = tgt[j + 1] + poly[j]
        if x >= MOD { x = x - MOD }
        tgt[j + 1] = x
        j = j + 1
    }
    return out_len
}

function dp_get(key: i64, keys: ptr<i64>, used: ptr<i8>, polys: ptr<i64>, plens: ptr<i64>, out: ptr<i64>) -> i64 {
    let slot: i64 = hslot(key, keys, used)
    if used[slot] == 0 { return 0 }
    let mut i: i64 = 0
    while i < plens[slot] { out[i] = polys[slot * MAXDEG + i]; i = i + 1 }
    return plens[slot]
}

function dp_set(key: i64, keys: ptr<i64>, used: ptr<i8>, polys: ptr<i64>, plens: ptr<i64>, poly: ptr<i64>, plen: i64) -> void {
    let slot: i64 = hslot(key, keys, used)
    used[slot] = 1
    keys[slot] = key
    plens[slot] = plen
    let mut i: i64 = 0
    while i < plen { polys[slot * MAXDEG + i] = poly[i]; i = i + 1 }
}

function dp_add(key: i64, keys: ptr<i64>, used: ptr<i8>, polys: ptr<i64>, plens: ptr<i64>, poly: ptr<i64>, plen: i64) -> void {
    let slot: i64 = hslot(key, keys, used)
    if used[slot] == 0 {
        used[slot] = 1
        keys[slot] = key
        plens[slot] = 0
    }
    add_poly(polys + slot * MAXDEG, plens + slot, poly, plen)
}

function process_cell(row: i64, col: i64,
                      src_keys: ptr<i64>, src_used: ptr<i8>, src_polys: ptr<i64>, src_plens: ptr<i64>,
                      dst_keys: ptr<i64>, dst_used: ptr<i8>, dst_polys: ptr<i64>, dst_plens: ptr<i64>,
                      st: ptr<i64>, tmp: ptr<i64>, nst: ptr<i64>, cur: ptr<i64>, n: i64) -> void {
    let mut slot: i64 = 0
    while slot < CAP {
        if src_used[slot] == 1 {
            decode(src_keys[slot], st, n)
            let plen: i64 = src_plens[slot]
            let mut j: i64 = 0
            while j < plen { cur[j] = src_polys[slot * MAXDEG + j]; j = j + 1 }
            let mx: i64 = max_label(st, n)
            let mut m: i64 = 0
            if mx != EMPTY { m = mx + 1 }
            let mut up: i64 = -2
            let mut left: i64 = -2
            if row > 0 { up = st[row - 1] }
            if col > 0 { left = st[row] }
            let mut lab: i64 = 0
            while lab < m {
                if lab != up && lab != left {
                    let mut i: i64 = 0
                    while i < n { tmp[i] = st[i]; i = i + 1 }
                    tmp[row] = lab
                    canon(tmp, nst, n)
                    dp_add(encode(nst, n), dst_keys, dst_used, dst_polys, dst_plens, cur, plen)
                }
                lab = lab + 1
            }
            let mut i2: i64 = 0
            while i2 < n { tmp[i2] = st[i2]; i2 = i2 + 1 }
            tmp[row] = m
            canon(tmp, nst, n)
            dp_add_q(encode(nst, n), dst_keys, dst_used, dst_polys, dst_plens, cur, plen, m)
        }
        slot = slot + 1
    }
}

function forget_pos(pos: i64,
                    src_keys: ptr<i64>, src_used: ptr<i8>, src_polys: ptr<i64>, src_plens: ptr<i64>,
                    dst_keys: ptr<i64>, dst_used: ptr<i8>, dst_polys: ptr<i64>, dst_plens: ptr<i64>,
                    st: ptr<i64>, tmp: ptr<i64>, nst: ptr<i64>, cur: ptr<i64>, n: i64) -> void {
    let mut slot: i64 = 0
    while slot < CAP {
        if src_used[slot] == 1 {
            decode(src_keys[slot], st, n)
            let plen: i64 = src_plens[slot]
            let mut j: i64 = 0
            while j < plen { cur[j] = src_polys[slot * MAXDEG + j]; j = j + 1 }
            let mut i: i64 = 0
            while i < n { tmp[i] = st[i]; i = i + 1 }
            tmp[pos] = EMPTY
            canon(tmp, nst, n)
            dp_add(encode(nst, n), dst_keys, dst_used, dst_polys, dst_plens, cur, plen)
        }
        slot = slot + 1
    }
}

function dp_clear(used: ptr<i8>) -> void {
    let mut i: i64 = 0
    while i < CAP { used[i] = 0; i = i + 1 }
}

function dp_add_q(key: i64, keys: ptr<i64>, used: ptr<i8>, polys: ptr<i64>, plens: ptr<i64>, poly: ptr<i64>, plen: i64, m: i64) -> void {
    let slot: i64 = hslot(key, keys, used)
    if used[slot] == 0 {
        used[slot] = 1
        keys[slot] = key
        plens[slot] = 0
        let mut i: i64 = 0
        while i < MAXDEG { polys[slot * MAXDEG + i] = 0; i = i + 1 }
    }
    let buf: ptr<i64> = calloc(MAXDEG, 8)
    if buf == null { return }
    let mut zi: i64 = 0
    while zi < MAXDEG { buf[zi] = 0; zi = zi + 1 }
    let mut tlen: i64 = 0
    tlen = add_q_minus_m(buf, tlen, poly, plen, m)
    add_poly(polys + slot * MAXDEG, plens + slot, buf, tlen)
    free(buf)
}

function chromatic_poly(coeffs: ptr<i64>, coeff_len: ptr<i64>) -> void {
    let keys_a: ptr<i64> = calloc(CAP, 8)
    let used_a: ptr<i8> = calloc(CAP, 1)
    let polys_a: ptr<i64> = calloc(CAP * MAXDEG, 8)
    let plens_a: ptr<i64> = calloc(CAP, 8)
    let keys_b: ptr<i64> = calloc(CAP, 8)
    let used_b: ptr<i8> = calloc(CAP, 1)
    let polys_b: ptr<i64> = calloc(CAP * MAXDEG, 8)
    let plens_b: ptr<i64> = calloc(CAP, 8)
    let st: ptr<i64> = calloc(R, 8)
    let tmp: ptr<i64> = calloc(R, 8)
    let nst: ptr<i64> = calloc(R, 8)
    let buf: ptr<i64> = calloc(MAXDEG, 8)
    let one: ptr<i64> = calloc(MAXDEG, 8)
    let cur: ptr<i64> = calloc(MAXDEG, 8)
    if keys_a == null { return }
    one[0] = 1
    let mut i: i64 = 0
    while i < R { st[i] = EMPTY; i = i + 1 }
    let start_key: i64 = encode(st, R)
    dp_set(start_key, keys_a, used_a, polys_a, plens_a, one, 1)
    let mut use_b: i32 = 0
    let mut col: i64 = 0
    while col < C {
        let mut row: i64 = 0
        while row < R {
            if use_b == 0 {
                dp_clear(used_b)
                process_cell(row, col, keys_a, used_a, polys_a, plens_a, keys_b, used_b, polys_b, plens_b, st, tmp, nst, cur, R)
            } else {
                dp_clear(used_a)
                process_cell(row, col, keys_b, used_b, polys_b, plens_b, keys_a, used_a, polys_a, plens_a, st, tmp, nst, cur, R)
            }
            use_b = 1 - use_b
            row = row + 1
        }
        col = col + 1
    }
    let mut pos: i64 = 0
    while pos < R {
        if use_b == 0 {
            dp_clear(used_b)
            forget_pos(pos, keys_a, used_a, polys_a, plens_a, keys_b, used_b, polys_b, plens_b, st, tmp, nst, cur, R)
        } else {
            dp_clear(used_a)
            forget_pos(pos, keys_b, used_b, polys_b, plens_b, keys_a, used_a, polys_a, plens_a, st, tmp, nst, cur, R)
        }
        use_b = 1 - use_b
        pos = pos + 1
    }
    if use_b == 0 {
        coeff_len[0] = dp_get(start_key, keys_a, used_a, polys_a, plens_a, coeffs)
    } else {
        coeff_len[0] = dp_get(start_key, keys_b, used_b, polys_b, plens_b, coeffs)
    }
    free(keys_a); free(used_a); free(polys_a); free(plens_a)
    free(keys_b); free(used_b); free(polys_b); free(plens_b)
    free(st); free(tmp); free(nst); free(buf); free(one); free(cur)
}

function poly_eval(coeffs: ptr<i64>, clen: i64, x0: i64) -> i64 {
    let mut x: i64 = x0 % MOD
    if x < 0 { x = x + MOD }
    let mut res: i64 = 0
    let mut p: i64 = 1
    let mut i: i64 = 0
    while i < clen {
        res = (res + coeffs[i] * p) % MOD
        p = (p * x) % MOD
        i = i + 1
    }
    return res
}

function lagrange_eval(values: ptr<i64>, n: i64, x0: i64) -> i64 {
    if x0 >= 0 && x0 <= n { return values[x0] % MOD }
    let mut x: i64 = x0 % MOD
    if x < 0 { x = x + MOD }
    let fac: ptr<i64> = calloc(n + 2, 8)
    let invfac: ptr<i64> = calloc(n + 2, 8)
    let pre: ptr<i64> = calloc(n + 3, 8)
    let suf: ptr<i64> = calloc(n + 3, 8)
    if fac == null { return 0 }
    fac[0] = 1
    let mut i: i64 = 1
    while i <= n {
        fac[i] = (fac[i - 1] * i) % MOD
        i = i + 1
    }
    invfac[n] = modpow(fac[n], MOD - 2, MOD)
    i = n
    while i > 0 {
        invfac[i - 1] = (invfac[i] * i) % MOD
        i = i - 1
    }
    pre[0] = 1
    i = 0
    while i <= n {
        pre[i + 1] = (pre[i] * (x - i)) % MOD
        i = i + 1
    }
    suf[n + 1] = 1
    i = n
    while i >= 0 {
        suf[i] = (suf[i + 1] * (x - i)) % MOD
        i = i - 1
    }
    let mut ans: i64 = 0
    i = 0
    while i <= n {
        let num: i64 = (pre[i] * suf[i + 1]) % MOD
        let mut den: i64 = (invfac[i] * invfac[n - i]) % MOD
        if ((n - i) & 1) != 0 { den = (MOD - den) % MOD }
        ans = (ans + values[i] * num % MOD * den) % MOD
        i = i + 1
    }
    free(fac); free(invfac); free(pre); free(suf)
    return ans
}

function main() -> i32 {
    let coeffs: ptr<i64> = calloc(MAXDEG, 8)
    let clen: ptr<i64> = calloc(1, 8)
    if coeffs == null || clen == null { return 1 }
    chromatic_poly(coeffs, clen)
    let m: i64 = R * C + 1
    let prefix: ptr<i64> = calloc(m + 1, 8)
    if prefix == null { return 1 }
    let mut acc: i64 = 0
    let mut k: i64 = 1
    while k <= m {
        acc = (acc + poly_eval(coeffs, clen[0], k)) % MOD
        prefix[k] = acc
        k = k + 1
    }
    printf("%lld\n", lagrange_eval(prefix, m, TARGET))
    free(coeffs); free(clen); free(prefix)
    return 0
}
