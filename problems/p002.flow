# Project Euler 002
# Sum of even Fibonacci numbers not exceeding four million.
#
# Even Fibonaccis are every third term; a tight while-loop is enough
# and compiles to the same tight C loop you'd write by hand.

function solve(limit: i64) -> i64 {
    let mut a: i64 = 1
    let mut b: i64 = 2
    let mut total: i64 = 0
    while a <= limit {
        if a % 2 == 0 {
            total = total + a
        }
        let next: i64 = a + b
        a = b
        b = next
    }
    return total
}

function main() -> i32 {
    printf("%lld\n", solve(4000000))
    return 0
}
