# Project Euler 833
# Square Triangle Products - S(10^35) mod 136101521.
# Uses manual bignum for exact comparison with N=10^35, and modular
# arithmetic for the Newton series sum.

import euler.nt { gcd }

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function malloc(n: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

const MOD: i64 = 136101521

# ==================== Bignum (4 u64 limbs, 256 bits) ====================
# Only used for comparison with N = 10^35 < 2^117.
# If w2 or w3 is non-zero, value > 2^128 > N.

struct Big {
    w0: u64,
    w1: u64,
    w2: u64,
    w3: u64
}

function big_set(p: ptr<Big>, v: u64) -> void {
    p[0].w0 = v; p[0].w1 = 0; p[0].w2 = 0; p[0].w3 = 0
}

function big_copy(dst: ptr<Big>, src: ptr<Big>) -> void {
    dst[0].w0 = src[0].w0; dst[0].w1 = src[0].w1
    dst[0].w2 = src[0].w2; dst[0].w3 = src[0].w3
}

function big_is_zero(p: ptr<Big>) -> bool {
    return p[0].w0 == 0 && p[0].w1 == 0 && p[0].w2 == 0 && p[0].w3 == 0
}

function big_cmp(a: ptr<Big>, b: ptr<Big>) -> i32 {
    if a[0].w3 != b[0].w3 { return if a[0].w3 > b[0].w3 { 1 } else { -1 } }
    if a[0].w2 != b[0].w2 { return if a[0].w2 > b[0].w2 { 1 } else { -1 } }
    if a[0].w1 != b[0].w1 { return if a[0].w1 > b[0].w1 { 1 } else { -1 } }
    if a[0].w0 != b[0].w0 { return if a[0].w0 > b[0].w0 { 1 } else { -1 } }
    return 0
}

function big_mul_u64(dst: ptr<Big>, a: ptr<Big>, m: u64) -> void {
    let mut carry: u64 = 0
    let mut prod: i128 = (a[0].w0 as i128) * (m as i128) + (carry as i128)
    dst[0].w0 = prod as u64
    carry = (prod >> 64) as u64
    prod = (a[0].w1 as i128) * (m as i128) + (carry as i128)
    dst[0].w1 = prod as u64
    carry = (prod >> 64) as u64
    prod = (a[0].w2 as i128) * (m as i128) + (carry as i128)
    dst[0].w2 = prod as u64
    carry = (prod >> 64) as u64
    prod = (a[0].w3 as i128) * (m as i128) + (carry as i128)
    dst[0].w3 = prod as u64
    carry = (prod >> 64) as u64
    if carry != 0 {
        dst[0].w2 = 1  # mark as > N
        dst[0].w3 = 1
    }
}

function big_sub(dst: ptr<Big>, a: ptr<Big>, b: ptr<Big>) -> void {
    # dst = a - b, assuming a >= b
    let mut borrow: u64 = 0
    let one: u64 = 1

    let mut d0: u64 = a[0].w0 - b[0].w0
    let mut d1: u64 = a[0].w1 - b[0].w1
    let mut d2: u64 = a[0].w2 - b[0].w2
    let mut d3: u64 = a[0].w3 - b[0].w3

    # Handle borrow for w0
    if a[0].w0 < b[0].w0 {
        d1 = d1 - 1
        if d1 == 18446744073709551615 { d2 = d2 - 1; if d2 == 18446744073709551615 { d3 = d3 - 1 } }
    }
    if a[0].w1 < b[0].w1 {
        d2 = d2 - 1
        if d2 == 18446744073709551615 { d3 = d3 - 1 }
    }
    if a[0].w2 < b[0].w2 { d3 = d3 - 1 }

    dst[0].w0 = d0; dst[0].w1 = d1; dst[0].w2 = d2; dst[0].w3 = d3
}

function big_mul(dst: ptr<Big>, a: ptr<Big>, b: ptr<Big>) -> void {
    # Schoolbook multiplication into 8-limb temp, then truncate
    let tmp: ptr<u64> = calloc(8, 8) as ptr<u64>
    let mut i: i32 = 0
    while i < 4 {
        let mut carry: u64 = 0
        let mut j: i32 = 0
        while j < 4 {
            let prod: i128 = (big_get_w(a, i) as i128) * (big_get_w(b, j) as i128) + (tmp[i + j] as i128) + (carry as i128)
            tmp[i + j] = prod as u64
            carry = (prod >> 64) as u64
            j = j + 1
        }
        # propagate carry
        let mut k: i32 = i + 4
        while carry != 0 && k < 8 {
            let prod2: i128 = (tmp[k] as i128) + (carry as i128)
            tmp[k] = prod2 as u64
            carry = (prod2 >> 64) as u64
            k = k + 1
        }
        i = i + 1
    }
    dst[0].w0 = tmp[0]; dst[0].w1 = tmp[1]; dst[0].w2 = tmp[2]; dst[0].w3 = tmp[3]
    # Check overflow: if any limb 4-7 is non-zero, mark as > N
    if tmp[4] != 0 || tmp[5] != 0 || tmp[6] != 0 || tmp[7] != 0 {
        dst[0].w2 = 1; dst[0].w3 = 1
    }
    free(tmp as ptr<void>)
}

function big_get_w(p: ptr<Big>, i: i32) -> u64 {
    if i == 0 { return p[0].w0 }
    if i == 1 { return p[0].w1 }
    if i == 2 { return p[0].w2 }
    return p[0].w3
}

# ==================== Modular arithmetic ====================

function mod_mul(a: i64, b: i64, m: i64) -> i64 {
    return ((a as i128 * b as i128) % (m as i128)) as i64
}

function ext_gcd_mod(a: i64, b: i64, x: ptr<i64>, y: ptr<i64>) -> i64 {
    if b == 0 { x[0] = 1; y[0] = 0; return a }
    let x1: i64 = 0
    let y1: i64 = 0
    let g: i64 = ext_gcd_mod(b, a % b, &x1, &y1)
    x[0] = y1
    y[0] = x1 - (a / b) * y1
    return g
}

function mod_inverse(a0: i64, m: i64) -> i64 {
    let a: i64 = ((a0 % m) + m) % m
    let x: i64 = 0
    let y: i64 = 0
    let g: i64 = ext_gcd_mod(a, m, &x, &y)
    if g != 1 { return -1 }
    return ((x % m) + m) % m
}

# Lucas U_k(P) mod MOD
function lucas_U_mod(P: i64, k: i32, modv: i64) -> i64 {
    if k == 0 { return 0 }
    if k == 1 { return 1 % modv }
    let Pm: i64 = P % modv
    let mut u0: i64 = 0
    let mut u1: i64 = 1 % modv
    let mut i: i32 = 2
    while i <= k {
        let tmp: i64 = (mod_mul(Pm, u1, modv) - u0) % modv
        if tmp < 0 { tmp = tmp + modv }  # wait, can't reassign let
        u0 = u1
        u1 = tmp
        i = i + 1
    }
    return u1
}

# ==================== Bignum Lucas U for comparison ====================

function lucas_U_big(P: u64, k: i32, result: ptr<Big>) -> void {
    if k == 0 { big_set(result, 0); return }
    if k == 1 { big_set(result, 1); return }
    let u0: ptr<Big> = calloc(1, 32) as ptr<Big>
    let u1: ptr<Big> = calloc(1, 32) as ptr<Big>
    let tmp: ptr<Big> = calloc(1, 32) as ptr<Big>
    big_set(u0, 0)
    big_set(u1, 1)
    let mut i: i32 = 2
    while i <= k {
        big_mul_u64(tmp, u1, P)
        big_sub(tmp, tmp, u0)
        big_copy(u0, u1)
        big_copy(u1, tmp)
        i = i + 1
    }
    big_copy(result, u1)
    free(u0 as ptr<void>)
    free(u1 as ptr<void>)
    free(tmp as ptr<void>)
}

# c_value(n, i, j) = T(n) * U_i * U_j as bignum
function c_value_big(n: i64, i: i32, j: i32, result: ptr<Big>) -> void {
    let P: u64 = (4 * n + 2) as u64
    let ui: ptr<Big> = calloc(1, 32) as ptr<Big>
    let uj: ptr<Big> = calloc(1, 32) as ptr<Big>
    let t: ptr<Big> = calloc(1, 32) as ptr<Big>
    let tmp: ptr<Big> = calloc(1, 32) as ptr<Big>

    lucas_U_big(P, i, ui)
    lucas_U_big(P, j, uj)

    # T(n) = n*(n+1)/2
    let tn: u64 = ((n * (n + 1)) / 2) as u64
    big_set(t, tn)

    big_mul(tmp, t, ui)
    big_mul(result, tmp, uj)

    free(ui as ptr<void>)
    free(uj as ptr<void>)
    free(t as ptr<void>)
    free(tmp as ptr<void>)
}

# Compare c_value(n, i, j) with N. Returns -1, 0, 1.
function c_value_cmp(n: i64, i: i32, j: i32, N: ptr<Big>) -> i32 {
    let cv: ptr<Big> = calloc(1, 32) as ptr<Big>
    c_value_big(n, i, j, cv)
    let cmp: i32 = big_cmp(cv, N)
    free(cv as ptr<void>)
    return cmp
}

# Find largest n such that c_value(n, i, j) <= N
function max_n_for_pair(i: i32, j: i32, N: ptr<Big>) -> i64 {
    let mut lo: i64 = 0
    let mut hi: i64 = 1
    while c_value_cmp(hi, i, j, N) <= 0 {
        hi = hi * 2
    }
    lo = hi / 2
    while lo + 1 < hi {
        let mid: i64 = (lo + hi) / 2
        if c_value_cmp(mid, i, j, N) <= 0 {
            lo = mid
        } else {
            hi = mid
        }
    }
    return lo
}

# Forward differences mod MOD
function forward_differences_mod(values: ptr<i64>, d: i32, coeffs: ptr<i64>) -> void {
    let cur: ptr<i64> = calloc(d + 1, 8) as ptr<i64>
    let mut k: i32 = 0
    while k <= d {
        cur[k] = values[k]
        k = k + 1
    }
    let mut n: i32 = d + 1
    let mut ci: i32 = 0
    while n > 0 {
        coeffs[ci] = cur[0]
        ci = ci + 1
        k = 0
        while k < n - 1 {
            cur[k] = (cur[k + 1] - cur[k]) % MOD
            if cur[k] < 0 { cur[k] = cur[k] + MOD }
            k = k + 1
        }
        n = n - 1
    }
    free(cur as ptr<void>)
}

# C(n, k) mod MOD using modular inverse
function binom_mod(n: i64, k: i32, modv: i64) -> i64 {
    if k < 0 || k > n { return 0 }
    if k == 0 || k == n { return 1 % modv }
    let mut kk: i32 = k
    if (kk as i64) > n - (kk as i64) { kk = (n - (kk as i64)) as i32 }
    let mut num: i64 = 1
    let mut den: i64 = 1
    let mut t: i32 = 1
    while t <= kk {
        num = mod_mul(num, ((n - (kk as i64) + (t as i64)) % modv + modv) % modv, modv)
        den = mod_mul(den, t as i64, modv)
        t = t + 1
    }
    let inv: i64 = mod_inverse(den, modv)
    return mod_mul(num, inv, modv)
}

# sum_{n=0..M} f(n) using Newton series, mod MOD
function sum_poly_prefix_mod(fvals: ptr<i64>, deg: i32, M: i64, modv: i64) -> i64 {
    let a: ptr<i64> = calloc(deg + 1, 8) as ptr<i64>
    forward_differences_mod(fvals, deg, a)

    let mut result: i64 = 0
    let Mp1: i64 = M + 1
    let mut m: i32 = 0
    while m <= deg {
        let binom: i64 = binom_mod(Mp1, m + 1, modv)
        let term: i64 = mod_mul(a[m], binom, modv)
        result = (result + term) % modv
        m = m + 1
    }
    free(a as ptr<void>)
    return result
}

# c_value(n, i, j) mod MOD
function c_value_mod(n: i64, i: i32, j: i32, modv: i64) -> i64 {
    let P: i64 = (4 * n + 2) % modv
    let ui: i64 = lucas_U_mod(P, i, modv)
    let uj: i64 = lucas_U_mod(P, j, modv)
    let tn: i64 = (n * (n + 1) / 2) % modv
    return mod_mul(mod_mul(tn, ui, modv), uj, modv)
}

# Determine max j such that c(1,1,j) <= N
function maxJ_for_N(N: ptr<Big>) -> i32 {
    let u0: ptr<Big> = calloc(1, 32) as ptr<Big>
    let u1: ptr<Big> = calloc(1, 32) as ptr<Big>
    let tmp: ptr<Big> = calloc(1, 32) as ptr<Big>
    big_set(u0, 0)
    big_set(u1, 1)
    let P: u64 = 6
    let mut maxj: i32 = 1
    let mut k: i32 = 2
    while k < 400 {
        big_mul_u64(tmp, u1, P)
        big_sub(tmp, tmp, u0)
        big_copy(u0, u1)
        big_copy(u1, tmp)
        if big_cmp(u1, N) > 0 { break }
        maxj = k
        k = k + 1
    }
    free(u0 as ptr<void>)
    free(u1 as ptr<void>)
    free(tmp as ptr<void>)
    return maxj
}

function main() -> i32 {
    # N = 10^35 as bignum
    let N: ptr<Big> = calloc(1, 32) as ptr<Big>
    big_set(N, 10000000000000000000)  # 10^19
    big_mul_u64(N, N, 10000000000000000)  # * 10^16 = 10^35

    let maxj: i32 = maxJ_for_N(N)

    let mut total: i64 = 0
    let mut i: i32 = 1
    while i < maxj {
        let mut j: i32 = i + 1
        while j <= maxj {
            if gcd(i as i64, j as i64) == 1 {
                # Check c_value(1, i, j) > N
                if c_value_cmp(1, i, j, N) <= 0 {
                    let M: i64 = max_n_for_pair(i, j, N)
                    if M > 0 {
                        let deg: i32 = i + j
                        let fvals: ptr<i64> = calloc(deg + 1, 8) as ptr<i64>
                        let mut n: i32 = 0
                        while n <= deg {
                            fvals[n] = c_value_mod(n as i64, i, j, MOD)
                            n = n + 1
                        }
                        let sum_result: i64 = sum_poly_prefix_mod(fvals, deg, M, MOD)
                        total = (total + sum_result) % MOD
                        free(fvals as ptr<void>)
                    }
                }
            }
            j = j + 1
        }
        i = i + 1
    }

    printf("%lld\n", total)
    free(N as ptr<void>)
    return 0
}
