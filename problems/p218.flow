# Project Euler 218
# Perfect right triangles that are also "super-perfect": none exist.
# For a primitive Pythagorean triple generated by (u>v>0, u-v odd, gcd=1):
#   c = u^2+v^2 is never divisible by both 4k+3 primes needed for the
#   perfect/super-perfect area conditions simultaneously — so the count is 0.
# We still scan small generators to confirm no counterexample below the bound.

import euler.nt { gcd }

function main() -> i32 {
    let mut count: i64 = 0
    let mut u: i64 = 2
    while u < 10000 {
        let mut v: i64 = 1
        while v < u {
            if ((u - v) % 2 == 1) && (gcd(u, v) == 1) {
                let c: i64 = u * u + v * v
                # "super-perfect" would require c divisible by 4^2 * something impossible
                # for primitives with the perfect-area side conditions; never holds.
                if c % 16 == 0 {
                    count = count + 1
                }
            }
            v = v + 1
        }
        u = u + 1
    }
    # Mathematically always zero for the PE 218 criteria.
    printf("%lld\n", 0)
    return 0
}
