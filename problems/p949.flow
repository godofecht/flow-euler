# Project Euler 949
# Ported from native C to pure Flow.
# Compute G(20, 7, 1001001011).
# Binary tree DP, histograms, convolution, pair counting.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function malloc(n: i64) -> ptr<void>
}

const MOD: i64 = 1001001011
const NEG_INF: i64 = -1000000000000
const POS_INF: i64 = 1000000000000

struct Histogram {
    val: ptr<i64>,
    cnt: ptr<i64>,
    size: i64,
    cap: i64
}

# Global arrays for compute_u_hot
let mut u_full_arr: ptr<i64> = null
let mut hot_arr: ptr<i32> = null

function ceil_div_pow2(x: i64, s: i64) -> i64 {
    if s == 0 {
        return x
    }
    let d: i64 = 1 << s
    if x >= 0 {
        return (x + d - 1) >> s
    }
    return 0 - ((0 - x) >> s)
}

function safe_shl(val: i64, amt: i64) -> i64 {
    if val >= 0 {
        return val << amt
    }
    return 0 - ((0 - val) << amt)
}

function simplest_between(u: i64, d: i64, e: i64) -> i64 {
    let mut m: i64 = 0
    while m <= e {
        let s: i64 = e - m
        let p_min: i64 = (u >> s) + 1
        let p_max: i64 = ceil_div_pow2(d, s) - 1
        if p_min <= p_max {
            let mut p: i64 = 0
            if p_min > 0 {
                p = p_min
            } else {
                if p_max < 0 {
                    p = p_max
                } else {
                    p = 0
                }
            }
            if m > 0 && p != 0 && (p & 1) == 0 {
                if p + 1 <= p_max && ((p + 1) & 1) != 0 {
                    p = p + 1
                } else {
                    if p - 1 >= p_min && ((p - 1) & 1) != 0 {
                        p = p - 1
                    }
                }
            }
            return safe_shl(p, s)
        }
        m = m + 1
    }
    return 0
}

function compute_u_hot(n: i64) -> void {
    let e: i64 = n
    let scale: i64 = 1 << e
    let total: i64 = (1 << (n + 1)) - 1

    let dp_u: ptr<i64> = calloc(total, 8) as ptr<i64>
    let dp_d: ptr<i64> = calloc(total, 8) as ptr<i64>

    # Root's children at index 1, 2
    dp_u[1] = scale
    dp_d[1] = scale
    dp_u[2] = 0 - scale
    dp_d[2] = 0 - scale

    u_full_arr = calloc(1 << n, 8) as ptr<i64>
    hot_arr = calloc(1 << n, 4) as ptr<i32>

    let mut length: i64 = 2
    while length <= n {
        let size: i64 = 1 << length
        let start: i64 = (1 << length) - 1

        let mut bits: i64 = 0
        while bits < size {
            # u_raw = max over suffixes of dp_d
            let mut u_raw: i64 = NEG_INF
            let mut s_len: i64 = 1
            while s_len < length {
                let suf: i64 = bits & ((1 << s_len) - 1)
                let cand: i64 = dp_d[(1 << s_len) - 1 + suf]
                if cand > u_raw {
                    u_raw = cand
                }
                s_len = s_len + 1
            }

            # d_raw = min over prefixes of dp_u
            let mut d_raw: i64 = POS_INF
            let mut p_len: i64 = 1
            while p_len < length {
                let pre: i64 = bits >> (length - p_len)
                let cand: i64 = dp_u[(1 << p_len) - 1 + pre]
                if cand < d_raw {
                    d_raw = cand
                }
                p_len = p_len + 1
            }

            let idx: i64 = start + bits
            if u_raw < d_raw {
                let x: i64 = simplest_between(u_raw, d_raw, e)
                dp_u[idx] = x
                dp_d[idx] = x
                if length == n {
                    u_full_arr[bits] = x
                    hot_arr[bits] = 0
                }
            } else {
                dp_u[idx] = u_raw
                dp_d[idx] = d_raw
                if length == n {
                    u_full_arr[bits] = u_raw
                    hot_arr[bits] = 1
                }
            }
            bits = bits + 1
        }
        length = length + 1
    }

    free(dp_u as ptr<void>)
    free(dp_d as ptr<void>)
}

# ---- Histogram operations ----

function hist_init() -> Histogram {
    let cap: i64 = 16
    let val: ptr<i64> = malloc(cap * 8) as ptr<i64>
    let cnt: ptr<i64> = malloc(cap * 8) as ptr<i64>
    return Histogram { val: val, cnt: cnt, size: 0, cap: cap }
}

function hist_free(h: Histogram) -> void {
    free(h.val as ptr<void>)
    free(h.cnt as ptr<void>)
}

function hist_find(h: Histogram, val: i64) -> i64 {
    let mut lo: i64 = 0
    let mut hi: i64 = h.size
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2
        if h.val[mid] < val {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < h.size && h.val[lo] == val {
        return lo
    }
    return -1
}

function hist_resize(h: Histogram) -> Histogram {
    let new_cap: i64 = h.cap * 2
    let new_val: ptr<i64> = malloc(new_cap * 8) as ptr<i64>
    let new_cnt: ptr<i64> = malloc(new_cap * 8) as ptr<i64>
    let mut i: i64 = 0
    while i < h.size {
        new_val[i] = h.val[i]
        new_cnt[i] = h.cnt[i]
        i = i + 1
    }
    free(h.val as ptr<void>)
    free(h.cnt as ptr<void>)
    return Histogram { val: new_val, cnt: new_cnt, size: h.size, cap: new_cap }
}

function hist_insert_sorted(h0: Histogram, val: i64, cnt: i64) -> Histogram {
    if cnt == 0 {
        return h0
    }
    let mut h: Histogram = h0
    let pos: i64 = hist_find(h, val)
    if pos >= 0 {
        h.cnt[pos] = (h.cnt[pos] + cnt) % MOD
        if h.cnt[pos] == 0 {
            # Remove zero entry by shifting
            let mut i: i64 = pos
            while i < h.size - 1 {
                h.val[i] = h.val[i + 1]
                h.cnt[i] = h.cnt[i + 1]
                i = i + 1
            }
            h.size = h.size - 1
        }
        return h
    }
    # Insert at sorted position
    let mut lo: i64 = 0
    let mut hi: i64 = h.size
    while lo < hi {
        let mid: i64 = lo + (hi - lo) / 2
        if h.val[mid] < val {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if h.size >= h.cap {
        h = hist_resize(h)
    }
    # Shift elements right
    let mut i: i64 = h.size
    while i > lo {
        h.val[i] = h.val[i - 1]
        h.cnt[i] = h.cnt[i - 1]
        i = i - 1
    }
    h.val[lo] = val
    h.cnt[lo] = cnt % MOD
    if h.cnt[lo] == 0 {
        return h
    }
    h.size = h.size + 1
    return h
}

function hist_from_values(values: ptr<i64>, n: i64) -> Histogram {
    let mut h: Histogram = hist_init()
    let mut i: i64 = 0
    while i < n {
        let pos: i64 = hist_find(h, values[i])
        if pos >= 0 {
            h.cnt[pos] = (h.cnt[pos] + 1) % MOD
            if h.cnt[pos] == 0 {
                let mut j: i64 = pos
                while j < h.size - 1 {
                    h.val[j] = h.val[j + 1]
                    h.cnt[j] = h.cnt[j + 1]
                    j = j + 1
                }
                h.size = h.size - 1
            }
        } else {
            h = hist_insert_sorted(h, values[i], 1)
        }
        i = i + 1
    }
    return h
}

function hist_convolve(a: Histogram, b: Histogram) -> Histogram {
    let mut out: Histogram = hist_init()

    # Iterate over smaller
    let mut smaller: Histogram = a
    let mut larger: Histogram = b
    if a.size > b.size {
        smaller = b
        larger = a
    }

    let mut i: i64 = 0
    while i < smaller.size {
        let mut j: i64 = 0
        while j < larger.size {
            let key: i64 = smaller.val[i] + larger.val[j]
            let cnt: i64 = (((smaller.cnt[i] as i128) * (larger.cnt[j] as i128)) % (MOD as i128)) as i64
            out = hist_insert_sorted(out, key, cnt)
            j = j + 1
        }
        i = i + 1
    }
    return out
}

function hist_pow(h: Histogram, t: i64) -> Histogram {
    if t == 0 {
        let r: Histogram = hist_init()
        return hist_insert_sorted(r, 0, 1)
    }
    let mut result: Histogram = hist_init()
    let mut i: i64 = 0
    while i < h.size {
        result = hist_insert_sorted(result, h.val[i], h.cnt[i])
        i = i + 1
    }

    let mut step: i64 = 1
    while step < t {
        let next: Histogram = hist_convolve(result, h)
        hist_free(result)
        result = next
        step = step + 1
    }
    return result
}

function count_sum_lt_zero(a: Histogram, b: Histogram) -> i64 {
    let b_sums: ptr<i64> = malloc(b.size * 8) as ptr<i64>
    let pref: ptr<i64> = malloc((b.size + 1) * 8) as ptr<i64>

    let mut i: i64 = 0
    while i < b.size {
        b_sums[i] = b.val[i]
        i = i + 1
    }
    pref[0] = 0
    i = 0
    while i < b.size {
        pref[i + 1] = (pref[i] + b.cnt[i]) % MOD
        i = i + 1
    }

    let mut ans: i64 = 0
    i = 0
    while i < a.size {
        let sa: i64 = a.val[i]
        let ca: i64 = a.cnt[i]
        # bisect_left for -sa in b_sums
        let mut lo: i64 = 0
        let mut hi: i64 = b.size
        while lo < hi {
            let mid: i64 = lo + (hi - lo) / 2
            if b_sums[mid] < 0 - sa {
                lo = mid + 1
            } else {
                hi = mid
            }
        }
        ans = (ans + (((ca as i128) * (pref[lo] as i128)) % (MOD as i128))) as i64
        i = i + 1
    }

    free(b_sums as ptr<void>)
    free(pref as ptr<void>)
    return ans
}

function count_sum_eq_zero(a: Histogram, b: Histogram) -> i64 {
    let mut smaller: Histogram = a
    let mut larger: Histogram = b
    if a.size > b.size {
        smaller = b
        larger = a
    }

    let mut ans: i64 = 0
    let mut i: i64 = 0
    while i < smaller.size {
        let s: i64 = smaller.val[i]
        let ca: i64 = smaller.cnt[i]
        let pos: i64 = hist_find(larger, 0 - s)
        if pos >= 0 {
            ans = (ans + (((ca as i128) * (larger.cnt[pos] as i128)) % (MOD as i128))) as i64
        }
        i = i + 1
    }
    return ans
}

function main() -> i32 {
    let n: i64 = 20
    let k: i64 = 7

    compute_u_hot(n)

    let total: i64 = 1 << n

    # u_hist from all u_full values
    let u_hist: Histogram = hist_from_values(u_full_arr, total)

    # cold_hist from cold values only
    let cold_values: ptr<i64> = malloc(total * 8) as ptr<i64>
    let mut n_cold: i64 = 0
    let mut i: i64 = 0
    while i < total {
        if hot_arr[i] == 0 {
            cold_values[n_cold] = u_full_arr[i]
            n_cold = n_cold + 1
        }
        i = i + 1
    }
    let cold_hist: Histogram = hist_from_values(cold_values, n_cold)

    let a_pow: i64 = k / 2
    let b_pow: i64 = k - a_pow

    let dist_a: Histogram = hist_pow(u_hist, a_pow)
    let dist_b: Histogram = hist_pow(u_hist, b_pow)

    let neg: i64 = count_sum_lt_zero(dist_a, dist_b)

    let cold_a: Histogram = hist_pow(cold_hist, a_pow)
    let cold_b: Histogram = hist_pow(cold_hist, b_pow)

    let zero_cold: i64 = count_sum_eq_zero(cold_a, cold_b)

    let mut result: i64 = (neg + zero_cold) % MOD
    if result < 0 {
        result = result + MOD
    }

    printf("%lld\n", result)

    # Cleanup
    hist_free(u_hist)
    hist_free(cold_hist)
    hist_free(dist_a)
    hist_free(dist_b)
    hist_free(cold_a)
    hist_free(cold_b)
    free(cold_values as ptr<void>)
    free(u_full_arr as ptr<void>)
    free(hot_arr as ptr<void>)
    return 0
}
