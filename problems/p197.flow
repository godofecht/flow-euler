# Project Euler 197
# u_{n+1}=floor(2^(30.403243784-u_n^2))*1e-9; find u_n+u_{n+1} at n=10^12.

extern {
    function pow(x: f64, y: f64) -> f64
    function floor(x: f64) -> f64
}

function f(x: f64) -> f64 {
    return floor(pow(2.0, 30.403243784 - x * x)) * 0.000000001
}

function main() -> i32 {
    let mut a: f64 = -1.0
    let mut i: i32 = 0
    while i < 2000 {
        a = f(a)
        i = i + 1
    }
    let b: f64 = f(a)
    printf("%.9f\n", a + b)
    return 0
}
