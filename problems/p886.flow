# Project Euler 886
# Coprime Permutations: P(34) mod 83456729.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function memset(p: ptr<void>, c: i32, n: i64) -> ptr<void>
}

const MOD: i64 = 83456729
const MAXN: i32 = 34

# Binomial table (flat 35*35)
let mut g_comb: ptr<i64> = null

# Grouped permanent context
let mut g_row_class_count: i32 = 0
let mut g_col_class_count: i32 = 0
let mut g_row_class_rep: ptr<i32> = null
let mut g_row_class_count_arr: ptr<i32> = null
let mut g_col_class_rep: ptr<i32> = null
let mut g_col_class_count_arr: ptr<i32> = null
let mut g_class_entry: ptr<i32> = null
let mut g_row_supports: ptr<i32> = null

# Permanent cache (hash table)
const PERM_CACHE_CAP: i64 = 1048576
const PERM_CACHE_MASK: i64 = 1048575
let mut g_perm_key: ptr<i64> = null
let mut g_perm_val: ptr<i64> = null
let mut g_perm_used: ptr<i8> = null

# rec_perm context
let mut g_active_col_classes: ptr<i32> = null
let mut g_active_col_counts: ptr<i32> = null
let mut g_active_count: i32 = 0
let mut g_supports: ptr<i32> = null
let mut g_row_counts_arr: ptr<i32> = null
let mut g_row_sums: ptr<i32> = null
let mut g_num_supports: i32 = 0
let mut g_row_total: i32 = 0
let mut g_total: i64 = 0

# affected arrays for rec_perm, indexed by col_pos * 256
let mut g_affected: ptr<i32> = null
let mut g_n_affected: ptr<i32> = null

function mulmod(a0: i64, b0: i64, m: i64) -> i64 {
    let a_w: i128 = a0 as i128
    let b_w: i128 = b0 as i128
    let m_w: i128 = m as i128
    let r: i128 = (a_w * b_w) % m_w
    return r as i64
}

function powmod(a0: i64, e0: i64, m: i64) -> i64 {
    let mut r: i64 = 1 % m
    let mut a: i64 = a0 % m
    if a < 0 { a = a + m }
    let mut e: i64 = e0
    while e > 0 {
        if (e & 1) == 1 { r = mulmod(r, a, m) }
        a = mulmod(a, a, m)
        e = e >> 1
    }
    return r
}

function gcd_ll(a0: i64, b0: i64) -> i64 {
    let mut a: i64 = a0
    let mut b: i64 = b0
    while b != 0 {
        let t: i64 = a % b
        a = b
        b = t
    }
    return a
}

function init_comb(n: i32) -> void {
    let mut i: i32 = 0
    while i <= n {
        g_comb[i * (MAXN + 1) + 0] = 1
        g_comb[i * (MAXN + 1) + i] = 1
        let mut j: i32 = 1
        while j < i {
            g_comb[i * (MAXN + 1) + j] = g_comb[(i - 1) * (MAXN + 1) + j - 1] + g_comb[(i - 1) * (MAXN + 1) + j]
            j = j + 1
        }
        i = i + 1
    }
}

function determinant_mod(mat: ptr<i64>, size: i32, mod: i64) -> i64 {
    if size == 0 { return 1 }
    let a: ptr<i64> = calloc((MAXN * MAXN) as i64, 8)
    let mut i: i32 = 0
    while i < size {
        let mut j: i32 = 0
        while j < size {
            a[i * MAXN + j] = mat[i * size + j] % mod
            if a[i * MAXN + j] < 0 { a[i * MAXN + j] = a[i * MAXN + j] + mod }
            j = j + 1
        }
        i = i + 1
    }
    let mut det: i64 = 1
    let mut col: i32 = 0
    while col < size {
        let mut pivot: i32 = -1
        let mut row: i32 = col
        while row < size {
            if a[row * MAXN + col] % mod != 0 { pivot = row; break }
            row = row + 1
        }
        if pivot < 0 { free(a); return 0 }
        if pivot != col {
            let mut j: i32 = 0
            while j < size {
                let t: i64 = a[col * MAXN + j]
                a[col * MAXN + j] = a[pivot * MAXN + j]
                a[pivot * MAXN + j] = t
                j = j + 1
            }
            det = 0 - det
        }
        let mut pv: i64 = a[col * MAXN + col] % mod
        if pv < 0 { pv = pv + mod }
        det = mulmod(det, pv, mod)
        let inv: i64 = powmod(pv, mod - 2, mod)
        let mut row2: i32 = col + 1
        while row2 < size {
            if a[row2 * MAXN + col] % mod != 0 {
                let factor: i64 = mulmod(a[row2 * MAXN + col], inv, mod)
                let mut j: i32 = col
                while j < size {
                    a[row2 * MAXN + j] = (a[row2 * MAXN + j] - mulmod(factor, a[col * MAXN + j], mod)) % mod
                    if a[row2 * MAXN + j] < 0 { a[row2 * MAXN + j] = a[row2 * MAXN + j] + mod }
                    j = j + 1
                }
            }
            row2 = row2 + 1
        }
        col = col + 1
    }
    det = det % mod
    if det < 0 { det = det + mod }
    free(a)
    return det
}

function perm_hash(key: i64) -> i64 {
    let h: i64 = key ^ (key >> 16)
    let h2: i64 = h * 2654435761
    let h3: i64 = h2 ^ (h2 >> 16)
    return h3 & PERM_CACHE_MASK
}

function perm_cache_lookup(key: i64, out: ptr<i64>) -> i32 {
    let mut h: i64 = perm_hash(key)
    while g_perm_used[h] != 0 {
        if g_perm_key[h] == key {
            out[0] = g_perm_val[h]
            return 1
        }
        h = (h + 1) & PERM_CACHE_MASK
    }
    return 0
}

function perm_cache_insert(key: i64, val: i64) -> void {
    let mut h: i64 = perm_hash(key)
    while g_perm_used[h] != 0 {
        if g_perm_key[h] == key {
            g_perm_val[h] = val
            return
        }
        h = (h + 1) & PERM_CACHE_MASK
    }
    g_perm_used[h] = 1
    g_perm_key[h] = key
    g_perm_val[h] = val
}

function rec_perm(col_pos: i32, chosen: i32, coeff: i64) -> void {
    if col_pos == g_active_count {
        let mut product: i64 = coeff
        let mut i: i32 = 0
        while i < g_num_supports {
            if g_row_sums[i] == 0 { return }
            product = mulmod(product, powmod(g_row_sums[i] as i64, g_row_counts_arr[i] as i64, MOD), MOD)
            i = i + 1
        }
        if (chosen & 1) == 1 { g_total = g_total - product }
        else { g_total = g_total + product }
        return
    }
    let class_size: i32 = g_active_col_counts[col_pos]
    let base_idx: i32 = col_pos * 256
    let mut n_aff: i32 = 0
    let mut idx: i32 = 0
    while idx < g_num_supports {
        if ((g_supports[idx] >> col_pos) & 1) == 1 {
            g_affected[base_idx + n_aff] = idx
            n_aff = n_aff + 1
        }
        idx = idx + 1
    }
    g_n_affected[col_pos] = n_aff

    let mut take: i32 = 0
    while take <= class_size {
        if take > 0 {
            let mut i: i32 = 0
            while i < n_aff {
                g_row_sums[g_affected[base_idx + i]] = g_row_sums[g_affected[base_idx + i]] + take
                i = i + 1
            }
        }
        rec_perm(col_pos + 1, chosen + take, mulmod(coeff, g_comb[class_size * (MAXN + 1) + take] % MOD, MOD))
        if take > 0 {
            let mut i: i32 = 0
            while i < n_aff {
                g_row_sums[g_affected[base_idx + i]] = g_row_sums[g_affected[base_idx + i]] - take
                i = i + 1
            }
        }
        take = take + 1
    }
}

function grouped_permanent(row_selected: i32, col_selected: i32) -> i64 {
    let key: i64 = ((row_selected as i64) << 20) | (col_selected as i64)
    let out: ptr<i64> = calloc(1, 8)
    if perm_cache_lookup(key, out) == 1 {
        let cached: i64 = out[0]
        free(out)
        return cached
    }
    free(out)

    # Build active col classes
    g_active_count = 0
    let mut cc: i32 = 0
    while cc < g_col_class_count {
        let remaining: i32 = g_col_class_count_arr[cc] - ((col_selected >> cc) & 1)
        if remaining > 0 {
            g_active_col_classes[g_active_count] = cc
            g_active_col_counts[g_active_count] = remaining
            g_active_count = g_active_count + 1
        }
        cc = cc + 1
    }

    # Build row groups indexed by support bitmask
    let row_group_counts: ptr<i32> = calloc(256, 4)
    row_group_counts[(1 << g_active_count) - 1] = 1
    let mut rc: i32 = 0
    while rc < g_row_class_count {
        let remaining: i32 = g_row_class_count_arr[rc] - ((row_selected >> rc) & 1)
        if remaining > 0 {
            let mut support: i32 = 0
            let orig: i32 = g_row_supports[rc]
            let mut nc: i32 = 0
            while nc < g_active_count {
                let old_col: i32 = g_active_col_classes[nc]
                if ((orig >> old_col) & 1) == 1 {
                    support = support | (1 << nc)
                }
                nc = nc + 1
            }
            row_group_counts[support] = row_group_counts[support] + remaining
        }
        rc = rc + 1
    }

    # Collect supports and counts
    g_num_supports = 0
    g_row_total = 0
    let mut s: i32 = 0
    while s < 256 {
        if row_group_counts[s] > 0 {
            g_supports[g_num_supports] = s
            g_row_counts_arr[g_num_supports] = row_group_counts[s]
            g_row_sums[g_num_supports] = 0
            g_row_total = g_row_total + row_group_counts[s]
            g_num_supports = g_num_supports + 1
        }
        s = s + 1
    }

    g_total = 0
    rec_perm(0, 0, 1)
    if (g_row_total & 1) == 1 { g_total = 0 - g_total }
    g_total = g_total % MOD
    if g_total < 0 { g_total = g_total + MOD }

    perm_cache_insert(key, g_total)
    free(row_group_counts)
    return g_total
}

function P_func(n: i32, mod: i64) -> i64 {
    # Clear permanent cache
    memset(g_perm_key, 0, PERM_CACHE_CAP * 8)
    memset(g_perm_val, 0, PERM_CACHE_CAP * 8)
    memset(g_perm_used, 0, PERM_CACHE_CAP)

    if n < 2 { return 0 }
    let m: i32 = n / 2

    # Build coprimality matrix
    let odds: ptr<i32> = calloc(m as i64, 4)
    let evens: ptr<i32> = calloc(m as i64, 4)
    let mut i: i32 = 0
    while i < m {
        odds[i] = 2 * i + 1
        evens[i] = 2 * (i + 1)
        i = i + 1
    }

    let matrix: ptr<i32> = calloc((MAXN * MAXN) as i64, 4)
    let mut i2: i32 = 0
    while i2 < m {
        let mut j: i32 = 0
        while j < m {
            if gcd_ll(odds[i2] as i64, evens[j] as i64) == 1 {
                matrix[i2 * MAXN + j] = 1
            } else {
                matrix[i2 * MAXN + j] = 0
            }
            j = j + 1
        }
        i2 = i2 + 1
    }

    # Row masks for rows 1..m-1
    let row_masks: ptr<i32> = calloc(MAXN as i64, 4)
    let mut row: i32 = 1
    while row < m {
        let mut mask: i32 = 0
        let mut col: i32 = 0
        while col < m {
            if matrix[row * MAXN + col] != 0 { mask = mask | (1 << col) }
            col = col + 1
        }
        row_masks[row - 1] = mask
        row = row + 1
    }

    # Col masks for all columns
    let col_masks: ptr<i32> = calloc(MAXN as i64, 4)
    let mut col2: i32 = 0
    while col2 < m {
        let mut mask: i32 = 0
        let mut row2: i32 = 0
        while row2 < m {
            if matrix[row2 * MAXN + col2] != 0 { mask = mask | (1 << row2) }
            row2 = row2 + 1
        }
        col_masks[col2] = mask
        col2 = col2 + 1
    }

    # Group rows by mask
    g_row_class_count = 0
    let row_seen: ptr<i32> = calloc(131072, 4)
    memset(row_seen, -1, 131072 * 4)
    let mut idx: i32 = 0
    while idx < m - 1 {
        let mask: i32 = row_masks[idx]
        if row_seen[mask] < 0 {
            row_seen[mask] = g_row_class_count
            g_row_class_rep[g_row_class_count] = idx
            g_row_class_count_arr[g_row_class_count] = 1
            g_row_class_count = g_row_class_count + 1
        } else {
            g_row_class_count_arr[row_seen[mask]] = g_row_class_count_arr[row_seen[mask]] + 1
        }
        idx = idx + 1
    }

    # Group cols by mask
    g_col_class_count = 0
    let col_seen: ptr<i32> = calloc(131072, 4)
    memset(col_seen, -1, 131072 * 4)
    idx = 0
    while idx < m {
        let mask: i32 = col_masks[idx]
        if col_seen[mask] < 0 {
            col_seen[mask] = g_col_class_count
            g_col_class_rep[g_col_class_count] = idx
            g_col_class_count_arr[g_col_class_count] = 1
            g_col_class_count = g_col_class_count + 1
        } else {
            g_col_class_count_arr[col_seen[mask]] = g_col_class_count_arr[col_seen[mask]] + 1
        }
        idx = idx + 1
    }

    # class_entry: [row_class][col_class]
    let mut rc2: i32 = 0
    while rc2 < g_row_class_count {
        let mut cc2: i32 = 0
        while cc2 < g_col_class_count {
            g_class_entry[rc2 * MAXN + cc2] = matrix[(g_row_class_rep[rc2] + 1) * MAXN + g_col_class_rep[cc2]]
            cc2 = cc2 + 1
        }
        rc2 = rc2 + 1
    }

    # row_supports: support over col classes
    rc2 = 0
    while rc2 < g_row_class_count {
        let mut support: i32 = 0
        let mut cc2: i32 = 0
        while cc2 < g_col_class_count {
            if matrix[(g_row_class_rep[rc2] + 1) * MAXN + g_col_class_rep[cc2]] != 0 {
                support = support | (1 << cc2)
            }
            cc2 = cc2 + 1
        }
        g_row_supports[rc2] = support
        rc2 = rc2 + 1
    }

    init_comb(m)

    # Enumerate combinations
    let mut answer: i64 = 0
    let rcc: i32 = g_row_class_count
    let ccc: i32 = g_col_class_count

    let row_subset: ptr<i32> = calloc(20, 4)
    let col_subset: ptr<i32> = calloc(20, 4)
    let det_mat: ptr<i64> = calloc(400, 8)

    let mut size: i32 = 0
    while size <= ccc && size <= rcc {
        let mut sign: i64 = 1
        if (size & 1) == 1 { sign = -1 }

        # Initialize row subset
        let mut i3: i32 = 0
        while i3 < size {
            row_subset[i3] = i3
            i3 = i3 + 1
        }

        let mut row_done: bool = false
        while !row_done {
            # Process current row subset
            let mut row_mask: i32 = 0
            let mut row_mult: i64 = 1
            let mut i4: i32 = 0
            while i4 < size {
                row_mask = row_mask | (1 << row_subset[i4])
                row_mult = mulmod(row_mult, g_row_class_count_arr[row_subset[i4]] as i64, mod)
                i4 = i4 + 1
            }

            # Initialize col subset
            let mut i5: i32 = 0
            while i5 < size {
                col_subset[i5] = i5
                i5 = i5 + 1
            }

            let mut col_done: bool = false
            while !col_done {
                let mut col_mask: i32 = 0
                let mut col_mult: i64 = 1
                let mut i6: i32 = 0
                while i6 < size {
                    col_mask = col_mask | (1 << col_subset[i6])
                    col_mult = mulmod(col_mult, g_col_class_count_arr[col_subset[i6]] as i64, mod)
                    i6 = i6 + 1
                }

                # Build det matrix
                let mut i7: i32 = 0
                while i7 < size {
                    let mut j7: i32 = 0
                    while j7 < size {
                        det_mat[i7 * size + j7] = g_class_entry[row_subset[i7] * MAXN + col_subset[j7]] as i64
                        j7 = j7 + 1
                    }
                    i7 = i7 + 1
                }

                let det: i64 = determinant_mod(det_mat, size, mod)
                if det != 0 {
                    let perm: i64 = grouped_permanent(row_mask, col_mask)
                    let term: i64 = mulmod(row_mult, col_mult, mod)
                    let term2: i64 = mulmod(term, mulmod(det, det, mod), mod)
                    let term3: i64 = mulmod(term2, mulmod(perm, perm, mod), mod)
                    answer = answer + sign * term3
                }

                # Next col subset
                if size == 0 { col_done = true }
                else {
                    let mut pos: i32 = size - 1
                    while pos >= 0 && col_subset[pos] == ccc - size + pos {
                        pos = pos - 1
                    }
                    if pos < 0 { col_done = true }
                    else {
                        col_subset[pos] = col_subset[pos] + 1
                        let mut i8v: i32 = pos + 1
                        while i8v < size {
                            col_subset[i8v] = col_subset[i8v - 1] + 1
                            i8v = i8v + 1
                        }
                    }
                }
            }

            # Next row subset
            if size == 0 { row_done = true }
            else {
                let mut pos: i32 = size - 1
                while pos >= 0 && row_subset[pos] == rcc - size + pos {
                    pos = pos - 1
                }
                if pos < 0 { row_done = true }
                else {
                    row_subset[pos] = row_subset[pos] + 1
                    let mut i9: i32 = pos + 1
                    while i9 < size {
                        row_subset[i9] = row_subset[i9 - 1] + 1
                        i9 = i9 + 1
                    }
                }
            }
        }
        size = size + 1
    }

    answer = answer % mod
    if answer < 0 { answer = answer + mod }

    free(odds)
    free(evens)
    free(matrix)
    free(row_masks)
    free(col_masks)
    free(row_seen)
    free(col_seen)
    free(row_subset)
    free(col_subset)
    free(det_mat)
    return answer
}

function main() -> i32 {
    # Allocate global arrays
    g_comb = calloc(((MAXN + 1) * (MAXN + 1)) as i64, 8)
    g_row_class_rep = calloc(MAXN as i64, 4)
    g_row_class_count_arr = calloc(MAXN as i64, 4)
    g_col_class_rep = calloc(MAXN as i64, 4)
    g_col_class_count_arr = calloc(MAXN as i64, 4)
    g_class_entry = calloc((MAXN * MAXN) as i64, 4)
    g_row_supports = calloc(MAXN as i64, 4)
    g_perm_key = calloc(PERM_CACHE_CAP, 8)
    g_perm_val = calloc(PERM_CACHE_CAP, 8)
    g_perm_used = calloc(PERM_CACHE_CAP, 1)
    g_active_col_classes = calloc(MAXN as i64, 4)
    g_active_col_counts = calloc(MAXN as i64, 4)
    g_supports = calloc(256, 4)
    g_row_counts_arr = calloc(256, 4)
    g_row_sums = calloc(256, 4)
    g_affected = calloc((MAXN * 256) as i64, 4)
    g_n_affected = calloc(MAXN as i64, 4)

    let ans: i64 = P_func(34, MOD)
    printf("%lld\n", ans)

    free(g_comb)
    free(g_row_class_rep)
    free(g_row_class_count_arr)
    free(g_col_class_rep)
    free(g_col_class_count_arr)
    free(g_class_entry)
    free(g_row_supports)
    free(g_perm_key)
    free(g_perm_val)
    free(g_perm_used)
    free(g_active_col_classes)
    free(g_active_col_counts)
    free(g_supports)
    free(g_row_counts_arr)
    free(g_row_sums)
    free(g_affected)
    free(g_n_affected)
    return 0
}
