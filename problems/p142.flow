# Project Euler 142
# Find x+y+z where x>y>z>0 and six pairwise ± sums/diffs are square.

function isqrt(n: i64) -> i64 {
    if n <= 0 { return 0 }
    let mut x: i64 = n
    let mut y: i64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

function is_square(n: i64) -> bool {
    if n <= 0 { return false }
    let r: i64 = isqrt(n)
    return r * r == n
}

function main() -> i32 {
    let mut a: i64 = 3
    while true {
        let mut b: i64 = 1
        if a % 2 == 0 { b = 2 }
        while b < a {
            let x: i64 = (a * a + b * b) / 2
            let y: i64 = a * a - x
            if x <= y { break }
            let mut c: i64 = isqrt(x) + 1
            while true {
                let z: i64 = c * c - x
                if y <= z { break }
                if is_square(x - z) && is_square(y + z) && is_square(y - z) {
                    printf("%lld\n", x + y + z)
                    return 0
                }
                c = c + 1
            }
            b = b + 2
        }
        a = a + 1
    }
    return 1
}
