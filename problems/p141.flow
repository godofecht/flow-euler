# Project Euler 141
# Sum of progressive squares below 10^12.

import euler.nt { isqrt }

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function is_square(n: i64) -> bool {
    let r: i64 = isqrt(n)
    return r * r == n
}

function contains(arr: ptr<i64>, n: i64, v: i64) -> bool {
    for i in 0..n {
        if arr[i] == v { return true }
    }
    return false
}

function main() -> i32 {
    let limit: i64 = 1000000000000
    let arr: ptr<i64> = calloc(5000, 8)
    if arr == null { return 1 }
    let mut cnt: i64 = 0

    let zmax: i64 = (limit |> isqrt |> isqrt) + 2  # ~1000; safer cube root
    # cube root of limit
    let mut z: i64 = 2
    while z * z * z <= limit {
        let mut y: i64 = 1
        while y < z {
            if z * z * z * y + y * y > limit { break }
            let den: i64 = y * z * z * z
            let mut x: i64 = 1
            while den > 0 && x <= limit / den {
                let n: i64 = z * z * z * x * x * y + x * y * y
                if n > limit { break }
                if is_square(n) {
                    if !contains(arr, cnt, n) {
                        arr[cnt] = n
                        cnt = cnt + 1
                    }
                }
                x = x + 1
            }
            y = y + 1
        }
        z = z + 1
    }

    let mut total: i64 = 0
    for i in 0..cnt {
        total = total + arr[i]
    }
    printf("%lld\n", total)
    free(arr)
    return 0
}
