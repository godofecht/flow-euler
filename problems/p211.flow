# Project Euler 211
# Sum of n < 64e6 where sigma2(n) is perfect square.

import euler.nt { isqrt }

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function main() -> i32 {
    let LIMIT: i64 = 64000000
    let sig: ptr<i64> = calloc(LIMIT, 8)
    if sig == null { return 1 }
    let mut i: i64 = 1
    while i < LIMIT {
        let sq: i64 = i * i
        let mut j: i64 = i
        while j < LIMIT {
            sig[j] = sig[j] + sq
            j = j + i
        }
        i = i + 1
    }
    let mut total: i64 = 0
    i = 1
    while i < LIMIT {
        let s: i64 = sig[i]
        let r: i64 = isqrt(s)
        if r * r == s {
            total = total + i
        }
        i = i + 1
    }
    printf("%lld\n", total)
    free(sig)
    return 0
}
