# Project Euler 299
# Count parallelograms / incenters with perimeter < 10^8.

import euler.nt { gcd, isqrt }

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function count_incenter(limit: i64) -> i64 {
    let target: i64 = limit - 1
    let mut total: i64 = 0
    let CAP: i64 = 100000
    let sa: ptr<i64> = calloc(CAP, 8)
    let sb: ptr<i64> = calloc(CAP, 8)
    let sc: ptr<i64> = calloc(CAP, 8)
    let mut sp: i64 = 0
    sa[0] = 3; sb[0] = 4; sc[0] = 5; sp = 1
    while sp > 0 {
        sp = sp - 1
        let a: i64 = sa[sp]
        let b: i64 = sb[sp]
        let c: i64 = sc[sp]
        let s: i64 = a + b
        if s > target { continue }
        total = total + target / s
        let a1: i64 = a - 2 * b + 2 * c
        let b1: i64 = 2 * a - b + 2 * c
        let c1: i64 = 2 * a - 2 * b + 3 * c
        let a2: i64 = a + 2 * b + 2 * c
        let b2: i64 = 2 * a + b + 2 * c
        let c2: i64 = 2 * a + 2 * b + 3 * c
        let a3: i64 = -a + 2 * b + 2 * c
        let b3: i64 = -2 * a + b + 2 * c
        let c3: i64 = -2 * a + 2 * b + 3 * c
        if a1 + b1 <= target {
            sa[sp] = a1; sb[sp] = b1; sc[sp] = c1; sp = sp + 1
        }
        if a2 + b2 <= target {
            sa[sp] = a2; sb[sp] = b2; sc[sp] = c2; sp = sp + 1
        }
        if a3 + b3 <= target {
            sa[sp] = a3; sb[sp] = b3; sc[sp] = c3; sp = sp + 1
        }
    }
    free(sa); free(sb); free(sc)
    return 2 * total
}

function count_parallel(limit: i64) -> i64 {
    let max_b: i64 = (limit - 1) / 2
    let mut total: i64 = 0
    let umax: i64 = isqrt(2 * max_b) + 1
    let mut u: i64 = 1
    while u <= umax {
        let disc: i64 = 2 * max_b - u * u
        if disc < 0 { break }
        let v_max: i64 = (isqrt(disc) - u) / 2
        if v_max >= 1 {
            let uu: i64 = u * u
            let mut v: i64 = 1
            while v <= v_max {
                if gcd(u, v) == 1 {
                    let base_b: i64 = uu + 2 * v * v + 2 * u * v
                    total = total + max_b / base_b
                }
                v = v + 1
            }
        }
        u = u + 2
    }
    return total
}

function main() -> i32 {
    let limit: i64 = 100000000
    printf("%lld\n", count_incenter(limit) + count_parallel(limit))
    return 0
}
