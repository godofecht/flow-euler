# Project Euler 502
# Counting Castles — height/width generating-function recurrence mod 10^9+7.
# Ported from C to pure Flow.

import euler.nt { mod_pow }

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function malloc(n: i64) -> ptr<void>
}

const MOD: i64 = 1000000007
const INV2: i64 = 500000004
const P1: i64 = 998244353
const P2: i64 = 1004535809
const P3: i64 = 469762049

let mut g_inv_p1_mod_p2: i64 = -1
let mut g_inv_p12_mod_p3: i64 = -1
let mut g_P12_lo: i64 = 0
let mut g_P12_hi: i64 = 0

function mod_inv(a: i64, mod: i64) -> i64 {
    return mod_pow(a, mod - 2, mod)
}

function ntt(a: ptr<i64>, n: i64, invert: i32, mod: i64, root: i64) -> void {
    let mut j: i64 = 0
    let mut i: i64 = 1
    while i < n {
        let mut bit: i64 = n >> 1
        while (j & bit) != 0 {
            j = j ^ bit
            bit = bit >> 1
        }
        j = j ^ bit
        if i < j {
            let tmp: i64 = a[i]
            a[i] = a[j]
            a[j] = tmp
        }
        i = i + 1
    }
    let mut length: i64 = 2
    while length <= n {
        let wlen: i64 = mod_pow(root, (mod - 1) / length, mod)
        let mut wl: i64 = wlen
        if invert == 1 { wl = mod_pow(wlen, mod - 2, mod) }
        let half: i64 = length >> 1
        i = 0
        while i < n {
            let mut w: i64 = 1
            let mut jj: i64 = 0
            while jj < half {
                let u: i64 = a[i + jj]
                let v: i64 = ((a[i + jj + half] as i128) * (w as i128) % (mod as i128)) as i64
                let mut x: i64 = u + v
                if x >= mod { x = x - mod }
                let mut y: i64 = u - v
                if y < 0 { y = y + mod }
                a[i + jj] = x
                a[i + jj + half] = y
                w = ((w as i128) * (wl as i128) % (mod as i128)) as i64
                jj = jj + 1
            }
            i = i + length
        }
        length = length << 1
    }
    if invert == 1 {
        let inv_n: i64 = mod_pow(n, mod - 2, mod)
        i = 0
        while i < n {
            a[i] = ((a[i] as i128) * (inv_n as i128) % (mod as i128)) as i64
            i = i + 1
        }
    }
}

function convolve_one(a: ptr<i64>, n1: i64, b: ptr<i64>, n2: i64, mod: i64, root: i64, out_n: ptr<i64>) -> ptr<i64> {
    let need: i64 = n1 + n2 - 1
    let mut n: i64 = 1
    while n < need { n = n << 1 }
    let fa: ptr<i64> = calloc(n, 8) as ptr<i64>
    let fb: ptr<i64> = calloc(n, 8) as ptr<i64>
    let mut i: i64 = 0
    while i < n1 { fa[i] = a[i] % mod; i = i + 1 }
    i = 0
    while i < n2 { fb[i] = b[i] % mod; i = i + 1 }
    ntt(fa, n, 0, mod, root)
    ntt(fb, n, 0, mod, root)
    i = 0
    while i < n {
        fa[i] = ((fa[i] as i128) * (fb[i] as i128) % (mod as i128)) as i64
        i = i + 1
    }
    ntt(fa, n, 1, mod, root)
    out_n[0] = need
    let res: ptr<i64> = malloc(need * 8) as ptr<i64>
    i = 0
    while i < need { res[i] = fa[i]; i = i + 1 }
    free(fa as ptr<void>)
    free(fb as ptr<void>)
    return res
}

function crt3(a1: i64, a2: i64, a3: i64) -> i64 {
    if g_inv_p1_mod_p2 < 0 {
        g_inv_p1_mod_p2 = mod_inv(P1 % P2, P2)
        let p12: i128 = (P1 as i128) * (P2 as i128)
        g_P12_lo = (p12 & ((1 as i128) << 63) - 1) as i64
        g_P12_hi = (p12 >> 63) as i64
        g_inv_p12_mod_p3 = mod_inv((p12 % (P3 as i128)) as i64, P3)
    }
    let mut t1: i64 = ((a2 - a1) % P2)
    if t1 < 0 { t1 = t1 + P2 }
    t1 = ((t1 as i128) * (g_inv_p1_mod_p2 as i128) % (P2 as i128)) as i64
    let x2: i128 = (a1 as i128) + (P1 as i128) * (t1 as i128)
    let mut t2: i64 = ((a3 - (x2 % (P3 as i128)) as i64) % P3)
    if t2 < 0 { t2 = t2 + P3 }
    t2 = ((t2 as i128) * (g_inv_p12_mod_p3 as i128) % (P3 as i128)) as i64
    let p12: i128 = ((g_P12_hi as i128) << 63) + (g_P12_lo as i128)
    let x: i128 = x2 + p12 * (t2 as i128)
    let mut r: i64 = (x % (MOD as i128)) as i64
    if r < 0 { r = r + MOD }
    return r
}

function convolve_mod(a: ptr<i64>, n1: i64, b: ptr<i64>, n2: i64, out_n: ptr<i64>) -> ptr<i64> {
    if n1 == 0 || n2 == 0 { out_n[0] = 0; return null as ptr<i64> }
    let o1p: ptr<i64> = calloc(1, 8) as ptr<i64>
    let o2p: ptr<i64> = calloc(1, 8) as ptr<i64>
    let o3p: ptr<i64> = calloc(1, 8) as ptr<i64>
    let c1: ptr<i64> = convolve_one(a, n1, b, n2, P1, 3, o1p)
    let c2: ptr<i64> = convolve_one(a, n1, b, n2, P2, 3, o2p)
    let c3: ptr<i64> = convolve_one(a, n1, b, n2, P3, 3, o3p)
    let need: i64 = n1 + n2 - 1
    let res: ptr<i64> = malloc(need * 8) as ptr<i64>
    let mut i: i64 = 0
    while i < need { res[i] = crt3(c1[i], c2[i], c3[i]); i = i + 1 }
    free(c1 as ptr<void>)
    free(c2 as ptr<void>)
    free(c3 as ptr<void>)
    free(o1p as ptr<void>)
    free(o2p as ptr<void>)
    free(o3p as ptr<void>)
    out_n[0] = need
    return res
}

function poly_mul_trunc(a: ptr<i64>, na: i64, b: ptr<i64>, nb: i64, n: i64) -> ptr<i64> {
    let onp: ptr<i64> = calloc(1, 8) as ptr<i64>
    let c: ptr<i64> = convolve_mod(a, na, b, nb, onp)
    let on: i64 = onp[0]
    free(onp as ptr<void>)
    let res: ptr<i64> = calloc(n, 8) as ptr<i64>
    let mut i: i64 = 0
    while i < n && i < on { res[i] = c[i]; i = i + 1 }
    free(c as ptr<void>)
    return res
}

function inv_series(q: ptr<i64>, n: i64) -> ptr<i64> {
    let mut g: ptr<i64> = calloc(n, 8) as ptr<i64>
    g[0] = mod_inv(q[0], MOD)
    let mut m: i64 = 1
    while m < n {
        let m2: i64 = m * 2
        let mut m2c: i64 = m2
        if m2c > n { m2c = n }
        let fg: ptr<i64> = poly_mul_trunc(q, m2c, g, m, m2c)
        let mut i: i64 = 0
        while i < m2c {
            fg[i] = (MOD - fg[i]) % MOD
            i = i + 1
        }
        fg[0] = (fg[0] + 2) % MOD
        let ng: ptr<i64> = poly_mul_trunc(g, m, fg, m2c, m2c)
        free(g as ptr<void>)
        free(fg as ptr<void>)
        g = ng
        m = m2c
    }
    return g
}

function build_PQ_mod(h: i64, y: i64, deg_limit: i64, P_out: ptr<ptr<i64> >, Pn_out: ptr<i64>, Q_out: ptr<ptr<i64> >, Qn_out: ptr<i64>) -> void {
    if h <= 0 {
        P_out[0] = calloc(1, 8) as ptr<i64>
        Pn_out[0] = 1
        Q_out[0] = malloc(8) as ptr<i64>
        Q_out[0][0] = 1
        Qn_out[0] = 1
        return
    }
    let y_mod: i64 = if y == 1 { 1 } else { MOD - 1 }
    let cap: i64 = deg_limit + 1
    let mut P: ptr<i64> = calloc(cap, 8) as ptr<i64>
    let mut Q: ptr<i64> = calloc(cap, 8) as ptr<i64>
    P[1] = y_mod
    Q[0] = 1
    Q[1] = MOD - 1
    let mut plen: i64 = if deg_limit >= 1 { 2 } else { 1 }
    let mut qlen: i64 = 2
    if h == 1 {
        P_out[0] = P
        Pn_out[0] = plen
        Q_out[0] = Q
        Qn_out[0] = qlen
        return
    }
    let mut step: i64 = 2
    while step <= h {
        let old_len: i64 = plen
        let mut new_len: i64 = old_len + 1
        if new_len > cap { new_len = cap }
        let nP: ptr<i64> = calloc(new_len, 8) as ptr<i64>
        let nQ: ptr<i64> = calloc(new_len, 8) as ptr<i64>
        nQ[0] = 1
        let mut i: i64 = 1
        while i < new_len {
            let pv: i64 = if i - 1 < plen { P[i - 1] } else { 0 }
            let qv: i64 = if i - 1 < qlen { Q[i - 1] } else { 0 }
            let s: i64 = (pv + qv) % MOD
            let p_i: i64 = if i < old_len { P[i] } else { 0 }
            if y == 1 {
                nP[i] = (p_i + s) % MOD
            } else {
                let v: i64 = (p_i + s) % MOD
                nP[i] = if v != 0 { MOD - v } else { 0 }
            }
            let q_i: i64 = if i < old_len { Q[i] } else { 0 }
            let mut qvv: i64 = q_i - s
            if qvv < 0 { qvv = qvv + MOD }
            nQ[i] = qvv
            i = i + 1
        }
        free(P as ptr<void>)
        free(Q as ptr<void>)
        P = nP
        Q = nQ
        plen = new_len
        qlen = new_len
        step = step + 1
    }
    P_out[0] = P
    Pn_out[0] = plen
    Q_out[0] = Q
    Qn_out[0] = qlen
}

function series_coeff_mod(P: ptr<i64>, Pn: i64, Q: ptr<i64>, Qn: i64, w: i64) -> i64 {
    let n: i64 = w + 1
    if w < 2048 {
        let f: ptr<i64> = calloc(n, 8) as ptr<i64>
        let mut i: i64 = 0
        while i < n {
            let mut val: i128 = if i < Pn { P[i] as i128 } else { 0 }
            let mut j: i64 = 1
            while j <= i && j < Qn {
                val = val - (Q[j] as i128) * (f[i - j] as i128)
                j = j + 1
            }
            let mut vi: i64 = (val % (MOD as i128)) as i64
            if vi < 0 { vi = vi + MOD }
            f[i] = vi
            i = i + 1
        }
        let ans: i64 = f[w]
        free(f as ptr<void>)
        return ans
    }
    let Qtrunc: ptr<i64> = calloc(n, 8) as ptr<i64>
    let mut i: i64 = 0
    while i < n && i < Qn { Qtrunc[i] = Q[i]; i = i + 1 }
    let invQ: ptr<i64> = inv_series(Qtrunc, n)
    free(Qtrunc as ptr<void>)
    let Ptrunc: ptr<i64> = calloc(n, 8) as ptr<i64>
    i = 0
    while i < n && i < Pn { Ptrunc[i] = P[i]; i = i + 1 }
    let prod: ptr<i64> = poly_mul_trunc(Ptrunc, n, invQ, n, n)
    let ans2: i64 = prod[w]
    free(invQ as ptr<void>)
    free(Ptrunc as ptr<void>)
    free(prod as ptr<void>)
    return ans2
}

function kitamasa(init: ptr<i64>, coef: ptr<i64>, d: i64, k: i64) -> i64 {
    if k < d { return init[k] }
    let mut pol: ptr<i64> = calloc(d, 8) as ptr<i64>
    pol[0] = 1
    let mut base: ptr<i64> = calloc(d, 8) as ptr<i64>
    if d > 1 { base[1] = 1 }
    let mut e: i64 = k
    while e != 0 {
        if e % 2 == 1 {
            let tmp: ptr<i64> = calloc(2 * d - 1, 8) as ptr<i64>
            let mut i: i64 = 0
            while i < d {
                if pol[i] != 0 {
                    let mut j: i64 = 0
                    while j < d {
                        tmp[i + j] = (tmp[i + j] + ((pol[i] as i128) * (base[j] as i128) % (MOD as i128)) as i64) % MOD
                        j = j + 1
                    }
                }
                i = i + 1
            }
            let mut i2: i64 = 2 * d - 2
            while i2 >= d {
                let t: i64 = tmp[i2]
                if t != 0 {
                    let mut j: i64 = 0
                    while j < d {
                        tmp[i2 - 1 - j] = (tmp[i2 - 1 - j] + ((t as i128) * (coef[j] as i128) % (MOD as i128)) as i64) % MOD
                        j = j + 1
                    }
                }
                i2 = i2 - 1
            }
            let mut i3: i64 = 0
            while i3 < d { pol[i3] = tmp[i3]; i3 = i3 + 1 }
            free(tmp as ptr<void>)
        }
        let tmp2: ptr<i64> = calloc(2 * d - 1, 8) as ptr<i64>
        let mut i: i64 = 0
        while i < d {
            if base[i] != 0 {
                let mut j: i64 = 0
                while j < d {
                    tmp2[i + j] = (tmp2[i + j] + ((base[i] as i128) * (base[j] as i128) % (MOD as i128)) as i64) % MOD
                    j = j + 1
                }
            }
            i = i + 1
        }
        let mut i2: i64 = 2 * d - 2
        while i2 >= d {
            let t: i64 = tmp2[i2]
            if t != 0 {
                let mut j: i64 = 0
                while j < d {
                    tmp2[i2 - 1 - j] = (tmp2[i2 - 1 - j] + ((t as i128) * (coef[j] as i128) % (MOD as i128)) as i64) % MOD
                    j = j + 1
                }
            }
            i2 = i2 - 1
        }
        let mut i3: i64 = 0
        while i3 < d { base[i3] = tmp2[i3]; i3 = i3 + 1 }
        free(tmp2 as ptr<void>)
        e = e / 2
    }
    let mut ans: i64 = 0
    let mut i: i64 = 0
    while i < d {
        ans = (ans + ((pol[i] as i128) * (init[i] as i128) % (MOD as i128)) as i64) % MOD
        i = i + 1
    }
    free(pol as ptr<void>)
    free(base as ptr<void>)
    return ans
}

function coeff_large_w_small_h(w: i64, h: i64, y: i64) -> i64 {
    let Pp: ptr<ptr<i64> > = calloc(1, 8) as ptr<ptr<i64> >
    let Pnp: ptr<i64> = calloc(1, 8) as ptr<i64>
    let Qp: ptr<ptr<i64> > = calloc(1, 8) as ptr<ptr<i64> >
    let Qnp: ptr<i64> = calloc(1, 8) as ptr<i64>
    build_PQ_mod(h, y, h, Pp, Pnp, Qp, Qnp)
    let P: ptr<i64> = Pp[0]
    let Pn: i64 = Pnp[0]
    let Q: ptr<i64> = Qp[0]
    let Qn: i64 = Qnp[0]
    free(Pp as ptr<void>)
    free(Pnp as ptr<void>)
    free(Qp as ptr<void>)
    free(Qnp as ptr<void>)
    let f: ptr<i64> = malloc((h + 1) * 8) as ptr<i64>
    let mut n: i64 = 0
    while n <= h {
        let mut val: i128 = if n < Pn { P[n] as i128 } else { 0 }
        let mut j: i64 = 1
        while j <= n && j < Qn {
            val = val - (Q[j] as i128) * (f[n - j] as i128)
            j = j + 1
        }
        let mut vi: i64 = (val % (MOD as i128)) as i64
        if vi < 0 { vi = vi + MOD }
        f[n] = vi
        n = n + 1
    }
    if w <= h {
        let ans: i64 = f[w]
        free(P as ptr<void>)
        free(Q as ptr<void>)
        free(f as ptr<void>)
        return ans
    }
    let coef: ptr<i64> = malloc(h * 8) as ptr<i64>
    let mut i: i64 = 1
    while i <= h {
        let qv: i64 = if i < Qn { Q[i] } else { 0 }
        coef[i - 1] = (MOD - qv) % MOD
        i = i + 1
    }
    let init: ptr<i64> = malloc(h * 8) as ptr<i64>
    i = 0
    while i < h {
        init[i] = f[i + 1]
        i = i + 1
    }
    let ans2: i64 = kitamasa(init, coef, h, w - 1)
    free(P as ptr<void>)
    free(Q as ptr<void>)
    free(f as ptr<void>)
    free(coef as ptr<void>)
    free(init as ptr<void>)
    return ans2
}

function poly_mul_small(a: ptr<i64>, na: i64, b: ptr<i64>, nb: i64, limit: i64, out_n: ptr<i64>) -> ptr<i64> {
    let mut need: i64 = na + nb - 1
    if need > limit { need = limit }
    let res: ptr<i64> = calloc(need, 8) as ptr<i64>
    let mut i: i64 = 0
    while i < na {
        if a[i] != 0 {
            let mut j: i64 = 0
            while j < nb {
                let ij: i64 = i + j
                if ij >= limit { break }
                res[ij] = (res[ij] + ((a[i] as i128) * (b[j] as i128) % (MOD as i128)) as i64) % MOD
                j = j + 1
            }
        }
        i = i + 1
    }
    out_n[0] = need
    return res
}

function poly_add_small(a: ptr<i64>, na: i64, b: ptr<i64>, nb: i64, limit: i64) -> ptr<i64> {
    let res: ptr<i64> = calloc(limit, 8) as ptr<i64>
    let mut i: i64 = 0
    while i < limit {
        let av: i64 = if i < na { a[i] } else { 0 }
        let bv: i64 = if i < nb { b[i] } else { 0 }
        res[i] = (av + bv) % MOD
        i = i + 1
    }
    return res
}

struct Mat {
    m00p: ptr<i64>, m00n: i64,
    m01p: ptr<i64>, m01n: i64,
    m10p: ptr<i64>, m10n: i64,
    m11p: ptr<i64>, m11n: i64
}

function mat_mul(A: Mat, B: Mat, limit: i64) -> Mat {
    let onp: ptr<i64> = calloc(1, 8) as ptr<i64>
    let t1: ptr<i64> = poly_mul_small(A.m00p, A.m00n, B.m00p, B.m00n, limit, onp)
    let n1: i64 = onp[0]
    let t2: ptr<i64> = poly_mul_small(A.m01p, A.m01n, B.m10p, B.m10n, limit, onp)
    let n2: i64 = onp[0]
    let s00: ptr<i64> = poly_add_small(t1, n1, t2, n2, limit)
    free(t1 as ptr<void>)
    free(t2 as ptr<void>)

    let t3: ptr<i64> = poly_mul_small(A.m00p, A.m00n, B.m01p, B.m01n, limit, onp)
    let n3: i64 = onp[0]
    let t4: ptr<i64> = poly_mul_small(A.m01p, A.m01n, B.m11p, B.m11n, limit, onp)
    let n4: i64 = onp[0]
    let s01: ptr<i64> = poly_add_small(t3, n3, t4, n4, limit)
    free(t3 as ptr<void>)
    free(t4 as ptr<void>)

    let t5: ptr<i64> = poly_mul_small(A.m10p, A.m10n, B.m00p, B.m00n, limit, onp)
    let n5: i64 = onp[0]
    let t6: ptr<i64> = poly_mul_small(A.m11p, A.m11n, B.m10p, B.m10n, limit, onp)
    let n6: i64 = onp[0]
    let s10: ptr<i64> = poly_add_small(t5, n5, t6, n6, limit)
    free(t5 as ptr<void>)
    free(t6 as ptr<void>)

    let t7: ptr<i64> = poly_mul_small(A.m10p, A.m10n, B.m01p, B.m01n, limit, onp)
    let n7: i64 = onp[0]
    let t8: ptr<i64> = poly_mul_small(A.m11p, A.m11n, B.m11p, B.m11n, limit, onp)
    let n8: i64 = onp[0]
    let s11: ptr<i64> = poly_add_small(t7, n7, t8, n8, limit)
    free(t7 as ptr<void>)
    free(t8 as ptr<void>)

    free(onp as ptr<void>)
    return Mat { m00p: s00, m00n: limit, m01p: s01, m01n: limit, m10p: s10, m10n: limit, m11p: s11, m11n: limit }
}

function mat_free(M: Mat) -> void {
    free(M.m00p as ptr<void>)
    free(M.m01p as ptr<void>)
    free(M.m10p as ptr<void>)
    free(M.m11p as ptr<void>)
}

function mat_pow(M0: Mat, e0: i64, limit: i64) -> Mat {
    let mut I: Mat = Mat { m00p: null, m00n: 0, m01p: null, m01n: 0, m10p: null, m10n: 0, m11p: null, m11n: 0 }
    let p00: ptr<i64> = calloc(limit, 8) as ptr<i64>
    p00[0] = 1
    let p11: ptr<i64> = calloc(limit, 8) as ptr<i64>
    p11[0] = 1
    let p01: ptr<i64> = calloc(limit, 8) as ptr<i64>
    let p10: ptr<i64> = calloc(limit, 8) as ptr<i64>
    I = Mat { m00p: p00, m00n: limit, m01p: p01, m01n: limit, m10p: p10, m10n: limit, m11p: p11, m11n: limit }
    let mut base: Mat = M0
    let mut base_owned: bool = false
    let mut e: i64 = e0
    while e != 0 {
        if e % 2 == 1 {
            let nI: Mat = mat_mul(I, base, limit)
            mat_free(I)
            I = nI
        }
        let nB: Mat = mat_mul(base, base, limit)
        if base_owned { mat_free(base) }
        base = nB
        base_owned = true
        e = e / 2
    }
    if base_owned { mat_free(base) }
    return I
}

function coeff_large_h_small_w(w: i64, h: i64, y: i64) -> i64 {
    if h <= 0 { return 0 }
    let limit: i64 = w + 1
    let y_mod: i64 = if y == 1 { 1 } else { MOD - 1 }
    let P: ptr<i64> = calloc(limit, 8) as ptr<i64>
    let Q: ptr<i64> = calloc(limit, 8) as ptr<i64>
    if w >= 1 {
        P[1] = y_mod
        Q[1] = MOD - 1
    }
    Q[0] = 1
    if h == 1 {
        let ans: i64 = series_coeff_mod(P, limit, Q, limit, w)
        free(P as ptr<void>)
        free(Q as ptr<void>)
        return ans
    }
    let y_one_plus_x: ptr<i64> = calloc(limit, 8) as ptr<i64>
    y_one_plus_x[0] = y_mod
    if limit >= 2 { y_one_plus_x[1] = y_mod }
    let y_x: ptr<i64> = calloc(limit, 8) as ptr<i64>
    if limit >= 2 { y_x[1] = y_mod }
    let minus_x: ptr<i64> = calloc(limit, 8) as ptr<i64>
    if limit >= 2 { minus_x[1] = MOD - 1 }
    let one_minus_x: ptr<i64> = calloc(limit, 8) as ptr<i64>
    one_minus_x[0] = 1
    if limit >= 2 { one_minus_x[1] = MOD - 1 }
    let A: Mat = Mat { m00p: y_one_plus_x, m00n: limit, m01p: y_x, m01n: limit, m10p: minus_x, m10n: limit, m11p: one_minus_x, m11n: limit }
    let Mp: Mat = mat_pow(A, h - 1, limit)
    mat_free(A)
    let onp: ptr<i64> = calloc(1, 8) as ptr<i64>
    let t1: ptr<i64> = poly_mul_small(Mp.m00p, limit, P, limit, limit, onp)
    let n1: i64 = onp[0]
    let t2: ptr<i64> = poly_mul_small(Mp.m01p, limit, Q, limit, limit, onp)
    let n2: i64 = onp[0]
    let Pn: ptr<i64> = poly_add_small(t1, n1, t2, n2, limit)
    free(t1 as ptr<void>)
    free(t2 as ptr<void>)
    let t3: ptr<i64> = poly_mul_small(Mp.m10p, limit, P, limit, limit, onp)
    let n3: i64 = onp[0]
    let t4: ptr<i64> = poly_mul_small(Mp.m11p, limit, Q, limit, limit, onp)
    let n4: i64 = onp[0]
    let Qn: ptr<i64> = poly_add_small(t3, n3, t4, n4, limit)
    free(t3 as ptr<void>)
    free(t4 as ptr<void>)
    free(onp as ptr<void>)
    mat_free(Mp)
    free(P as ptr<void>)
    free(Q as ptr<void>)
    let ans: i64 = series_coeff_mod(Pn, limit, Qn, limit, w)
    free(Pn as ptr<void>)
    free(Qn as ptr<void>)
    return ans
}

function coeff_C_mod(w: i64, h: i64, y: i64) -> i64 {
    if h <= 0 { return 0 }
    if w <= 200 && h > 2000 { return coeff_large_h_small_w(w, h, y) }
    if h <= 200 && w > 2000 { return coeff_large_w_small_h(w, h, y) }
    let Pp: ptr<ptr<i64> > = calloc(1, 8) as ptr<ptr<i64> >
    let Pnp: ptr<i64> = calloc(1, 8) as ptr<i64>
    let Qp: ptr<ptr<i64> > = calloc(1, 8) as ptr<ptr<i64> >
    let Qnp: ptr<i64> = calloc(1, 8) as ptr<i64>
    let mut deg: i64 = w
    if deg < 0 { deg = 0 }
    build_PQ_mod(h, y, deg, Pp, Pnp, Qp, Qnp)
    let P: ptr<i64> = Pp[0]
    let Pn: i64 = Pnp[0]
    let Q: ptr<i64> = Qp[0]
    let Qn: i64 = Qnp[0]
    free(Pp as ptr<void>)
    free(Pnp as ptr<void>)
    free(Qp as ptr<void>)
    free(Qnp as ptr<void>)
    let ans: i64 = series_coeff_mod(P, Pn, Q, Qn, w)
    free(P as ptr<void>)
    free(Q as ptr<void>)
    return ans
}

function E_leq_mod(w: i64, h: i64) -> i64 {
    if h <= 0 { return 0 }
    let T: i64 = coeff_C_mod(w, h, 1)
    let S: i64 = coeff_C_mod(w, h, -1)
    return (((T + S) % MOD) as i128 * (INV2 as i128) % (MOD as i128)) as i64
}

function F_mod(w: i64, h: i64) -> i64 {
    let a: i64 = E_leq_mod(w, h)
    let b: i64 = E_leq_mod(w, h - 1)
    let mut r: i64 = a - b
    if r < 0 { r = r + MOD }
    return r
}

function main() -> i32 {
    let a: i64 = F_mod(1000000000000, 100)
    let b: i64 = F_mod(10000, 10000)
    let c: i64 = F_mod(100, 1000000000000)
    printf("%lld\n", (a + b + c) % MOD)
    return 0
}
