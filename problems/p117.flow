# Project Euler 117
# Ways to tile length 50 using black units and red(2), green(3), blue(4) mixed.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function main() -> i32 {
    let n: i32 = 50
    let a: ptr<i64> = calloc((n + 1) as i64, 8)
    if a == null { return 1 }
    a[0] = 1
    let mut i: i32 = 1
    while i <= n {
        a[i] = a[i - 1]
        if i >= 2 { a[i] = a[i] + a[i - 2] }
        if i >= 3 { a[i] = a[i] + a[i - 3] }
        if i >= 4 { a[i] = a[i] + a[i - 4] }
        i = i + 1
    }
    printf("%lld\n", a[n])
    free(a)
    return 0
}
