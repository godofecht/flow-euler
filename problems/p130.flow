# Project Euler 130
# Sum of first twenty-five composites n with gcd(n,10)=1 and (n-1) divisible by A(n).

import euler.nt { is_prime, mod_pow }

function main() -> i32 {
    let mut total: i64 = 0
    let mut count: i32 = 0
    let mut n: i64 = 91
    while count < 25 {
        if n % 2 != 0 && n % 5 != 0 && !is_prime(n) {
            # R(n-1) ≡ 0 (mod n) ⇔ 10^{n-1} ≡ 1 (mod 9n)
            if mod_pow(10, n - 1, 9 * n) == 1 {
                total = total + n
                count = count + 1
            }
        }
        n = n + 2
    }
    printf("%lld\n", total)
    return 0
}
