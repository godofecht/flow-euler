# Project Euler 130
# Sum of first twenty-five composites n with gcd(n,10)=1 and (n-1) divisible by A(n).

function mod_pow(base: i64, exp: i64, mod: i64) -> i64 {
    let mut r: i64 = 1
    let mut b: i64 = base % mod
    let mut e: i64 = exp
    while e > 0 {
        if e % 2 == 1 { r = (r * b) % mod }
        b = (b * b) % mod
        e = e / 2
    }
    return r
}

function is_prime(n: i64) -> bool {
    if n < 2 { return false }
    if n % 2 == 0 { return n == 2 }
    let mut d: i64 = 3
    while d * d <= n {
        if n % d == 0 { return false }
        d = d + 2
    }
    return true
}

function main() -> i32 {
    let mut total: i64 = 0
    let mut count: i32 = 0
    let mut n: i64 = 91
    while count < 25 {
        if n % 2 != 0 && n % 5 != 0 && !is_prime(n) {
            # R(n-1) ≡ 0 (mod n) ⇔ 10^{n-1} ≡ 1 (mod 9n)
            if mod_pow(10, n - 1, 9 * n) == 1 {
                total = total + n
                count = count + 1
            }
        }
        n = n + 2
    }
    printf("%lld\n", total)
    return 0
}
