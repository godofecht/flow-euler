# Project Euler 003
# Largest prime factor of 600851475143.
#
# Trial division with an early even strip and odd steps — Flow's i64
# and while syntax keep the algorithm obvious without sacrificing speed.

function largest_prime_factor(n0: i64) -> i64 {
    let mut n: i64 = n0
    let mut last: i64 = 1

    while n % 2 == 0 {
        last = 2
        n = n / 2
    }

    let mut p: i64 = 3
    while p * p <= n {
        while n % p == 0 {
            last = p
            n = n / p
        }
        p = p + 2
    }

    if n > 1 {
        last = n
    }
    return last
}

function main() -> i32 {
    printf("%lld\n", largest_prime_factor(600851475143))
    return 0
}
