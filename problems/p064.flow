# Project Euler 064
# How many continued fractions for N ≤ 10000 have an odd period?

function is_square(n: i64) -> bool {
    let mut r: i64 = 1
    while r * r < n { r = r + 1 }
    return r * r == n
}

function period(n: i64) -> i32 {
    # continued fraction period of sqrt(n)
    let a0: i64 = 0
    let mut r: i64 = 1
    while r * r <= n { r = r + 1 }
    r = r - 1
    # a0 = floor(sqrt(n))
    let mut m: i64 = 0
    let mut d: i64 = 1
    let mut a: i64 = r
    let mut period: i32 = 0
    # repeat until a == 2*a0
    while a != 2 * r {
        m = d * a - m
        d = (n - m * m) / d
        a = (r + m) / d
        period = period + 1
    }
    return period
}

function main() -> i32 {
    let mut count: i64 = 0
    for n in 2..10001 {
        if !is_square(n) {
            if period(n) % 2 == 1 {
                count = count + 1
            }
        }
    }
    printf("%lld\n", count)
    return 0
}
