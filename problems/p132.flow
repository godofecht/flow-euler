# Project Euler 132
# Sum of first forty prime factors of R(10^9).

function mod_pow(base: i64, exp: i64, mod: i64) -> i64 {
    let mut r: i64 = 1
    let mut b: i64 = base % mod
    let mut e: i64 = exp
    while e > 0 {
        if e % 2 == 1 { r = (r * b) % mod }
        b = (b * b) % mod
        e = e / 2
    }
    return r
}

function main() -> i32 {
    let digits: i64 = 1000000000
    let mut total: i64 = 0
    let mut left: i32 = 40
    let mut n: i64 = 7
    while left > 0 {
        let mut prime: bool = true
        let mut d: i64 = 3
        while d * d <= n {
            if n % d == 0 { prime = false; break }
            d = d + 2
        }
        if prime {
            if mod_pow(10, digits, 9 * n) == 1 {
                total = total + n
                left = left - 1
            }
        }
        n = n + 2
    }
    printf("%lld\n", total)
    return 0
}
