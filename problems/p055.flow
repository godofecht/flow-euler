# Project Euler 055
# How many Lychrel numbers below ten thousand?

import euler.digits { Digits, digits_one, digits_set_u64, digits_reverse_add, digits_is_palindrome }

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function main() -> i32 {
    let maxd: i32 = 80
    let mut d: Digits = digits_one(maxd as i64)
    let tmp: ptr<i32> = calloc(maxd as i64, 4)
    if d.data == null || tmp == null {
        if tmp != null { free(tmp) }
        if d.data != null { free(d.data) }
        return 1
    }

    let mut lychrel: i64 = 0
    for n in 1..10000 {
        digits_set_u64(&d, n as i64)

        let mut found: bool = false
        for iter in 0..50 {
            digits_reverse_add(&d, tmp)
            if digits_is_palindrome(d) {
                found = true
                break
            }
        }

        if !found {
            lychrel = lychrel + 1
        }
    }

    printf("%lld\n", lychrel)
    free(tmp)
    free(d.data)
    return 0
}
