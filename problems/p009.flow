# Project Euler 009
# Special Pythagorean triplet: a + b + c = 1000, a² + b² = c².
# Return the product a·b·c.

function solve(perimeter: i64) -> i64 {
    let mut a: i64 = 1
    while a < perimeter / 3 {
        let mut b: i64 = a + 1
        while b < perimeter / 2 {
            let c: i64 = perimeter - a - b
            if b >= c {
                break
            }
            if a * a + b * b == c * c {
                return a * b * c
            }
            b = b + 1
        }
        a = a + 1
    }
    return 0
}

function main() -> i32 {
    printf("%lld\n", solve(1000))
    return 0
}
