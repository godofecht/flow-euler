# Project Euler 182
# Sum of encryption exponents e with minimal unconcealed messages.

import euler.nt { gcd }

function main() -> i32 {
    let p: i64 = 1009
    let q: i64 = 3643
    let phi: i64 = (p - 1) * (q - 1)
    let mut best: i64 = 1000000000000000000
    let mut sum: i64 = 0
    let mut e: i64 = 2
    while e < phi {
        if gcd(e, phi) == 1 {
            let unc: i64 = (1 + gcd(e - 1, p - 1)) * (1 + gcd(e - 1, q - 1))
            if unc < best {
                best = unc
                sum = e
            } elif unc == best {
                sum = sum + e
            }
        }
        e = e + 1
    }
    printf("%lld\n", sum)
    return 0
}
