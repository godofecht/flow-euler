# Project Euler 955
# Finding Triangles — index of 70th triangular term (i128 arithmetic).

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

let mut rng: i64 = 123456789

function rnd(modv: i64) -> i64 {
    rng = rng * 6364136223846793005 + 1
    let mut v: i64 = rng
    if v < 0 { v = -v }
    if modv <= 0 { return 0 }
    return v % modv
}

function igcd128(a0: i128, b0: i128) -> i128 {
    let mut a: i128 = a0
    let mut b: i128 = b0
    if a < (0 as i128) { a = -a }
    if b < (0 as i128) { b = -b }
    while b != (0 as i128) {
        let t: i128 = a % b
        a = b
        b = t
    }
    return a
}

function modmul128(a: i128, b: i128, n: i128) -> i128 {
    return a * b % n
}

function modpow128(base0: i128, exp0: i64, n: i128) -> i128 {
    let mut r: i128 = 1
    let mut b: i128 = base0 % n
    let mut e: i64 = exp0
    while e > 0 {
        if (e & 1) != 0 { r = modmul128(r, b, n) }
        b = modmul128(b, b, n)
        e = e >> 1
    }
    return r
}

function is_prime128(n: i128) -> i64 {
    if n < (2 as i128) { return 0 }
    let mut sp: i64 = 2
    while sp <= 29 {
        let p: i128 = sp as i128
        if n % p == (0 as i128) {
            if n == p { return 1 }
            return 0
        }
        if sp == 2 { sp = 3 }
        elif sp == 3 { sp = 5 }
        elif sp == 5 { sp = 7 }
        elif sp == 7 { sp = 11 }
        elif sp == 11 { sp = 13 }
        elif sp == 13 { sp = 17 }
        elif sp == 17 { sp = 19 }
        elif sp == 19 { sp = 23 }
        elif sp == 23 { sp = 29 }
        else { break }
    }
    let mut d: i128 = n - (1 as i128)
    let mut s: i64 = 0
    while (d & (1 as i128)) == (0 as i128) {
        s = s + 1
        d = d >> 1
    }
    let bases: [i64; 7] = [2, 325, 9375, 28178, 450775, 9780504, 1795265022]
    let mut i: i64 = 0
    while i < 7 {
        let a: i128 = (bases[i] as i128) % n
        if a != (0 as i128) {
            let mut x: i128 = modpow128(a, (d as i64), n)
            # d may exceed i64 — use i128 exp
            # Fix: recompute with i128 exponent loop
            x = 1
            let mut bb: i128 = a
            let mut ee: i128 = d
            while ee > (0 as i128) {
                if (ee & (1 as i128)) != (0 as i128) { x = modmul128(x, bb, n) }
                bb = modmul128(bb, bb, n)
                ee = ee >> 1
            }
            if x != (1 as i128) && x != n - (1 as i128) {
                let mut ok: i64 = 0
                let mut j: i64 = 1
                while j < s {
                    x = modmul128(x, x, n)
                    if x == n - (1 as i128) {
                        ok = 1
                        break
                    }
                    j = j + 1
                }
                if ok == 0 { return 0 }
            }
        }
        i = i + 1
    }
    return 1
}

function pollard128(n: i128) -> i128 {
    if (n & (1 as i128)) == (0 as i128) { return 2 as i128 }
    if n % (3 as i128) == (0 as i128) { return 3 as i128 }
    while true {
        let nm3: i64 = 1000000007
        let mut x: i128 = (2 + rnd(nm3)) as i128 % n
        let mut y: i128 = x
        let c: i128 = (1 + rnd(nm3)) as i128 % n
        let mut d: i128 = 1
        while d == (1 as i128) {
            x = (modmul128(x, x, n) + c) % n
            y = (modmul128(y, y, n) + c) % n
            y = (modmul128(y, y, n) + c) % n
            let mut diff: i128 = x - y
            if diff < (0 as i128) { diff = -diff }
            d = igcd128(diff, n)
        }
        if d != n { return d }
    }
    return 0 as i128
}

function factor_rec(n: i128, ps: ptr<i128>, es: ptr<i64>, k: ptr<i64>) -> void {
    if n == (1 as i128) { return }
    if is_prime128(n) != 0 {
        let mut i: i64 = 0
        while i < k[0] {
            if ps[i] == n {
                es[i] = es[i] + 1
                return
            }
            i = i + 1
        }
        ps[k[0]] = n
        es[k[0]] = 1
        k[0] = k[0] + 1
        return
    }
    let d: i128 = pollard128(n)
    factor_rec(d, ps, es, k)
    factor_rec(n / d, ps, es, k)
}

function next_triangle_jump(a_tri: i128, out_k: ptr<i128>, out_a: ptr<i128>) -> void {
    let M: i128 = (2 as i128) * a_tri
    let mut ps: ptr<i128> = calloc(64, 16)
    let mut es: ptr<i64> = calloc(64, 8)
    let mut fk: i64 = 0
    factor_rec(M, ps, es, &fk)
    let mut divs: ptr<i128> = calloc(50000, 16)
    let mut nd: i64 = 1
    divs[0] = 1
    let mut i: i64 = 0
    while i < fk {
        let old: i64 = nd
        let mut pe: i128 = 1
        let mut e: i64 = 0
        while e < es[i] {
            pe = pe * ps[i]
            let mut j: i64 = 0
            while j < old {
                divs[nd] = divs[j] * pe
                nd = nd + 1
                j = j + 1
            }
            e = e + 1
        }
        i = i + 1
    }
    i = 0
    while i < nd {
        let mut j: i64 = i + 1
        while j < nd {
            if divs[j] < divs[i] {
                let t: i128 = divs[i]
                divs[i] = divs[j]
                divs[j] = t
            }
            j = j + 1
        }
        i = i + 1
    }
    i = 0
    while i < nd {
        let x: i128 = divs[i]
        let y: i128 = M / x
        if ((x - y) & (1 as i128)) != (0 as i128) {
            let k: i128 = (x - y - (1 as i128)) / (2 as i128)
            if k > (0 as i128) {
                out_k[0] = k
                out_a[0] = a_tri + k * (k + (1 as i128)) / (2 as i128)
                free(divs)
                free(ps)
                free(es)
                return
            }
        }
        i = i + 1
    }
    free(divs)
    free(ps)
    free(es)
    out_k[0] = -1 as i128
    out_a[0] = -1 as i128
}

function main() -> i32 {
    let mut n: i128 = 0
    let mut a: i128 = 3
    let mut i: i64 = 0
    while i < 69 {
        let mut step: i128 = 0
        let mut na: i128 = 0
        next_triangle_jump(a, &step, &na)
        n = n + step
        a = na
        i = i + 1
    }
    printf("%lld\n", n as i64)
    return 0
}
