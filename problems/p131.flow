# Project Euler 131
# Count primes p < 10^6 such that n^3 + n^2 p is a perfect cube for some n.

import euler.nt { is_prime }

function main() -> i32 {
    let limit: i64 = 1000000
    let mut count: i64 = 0
    let mut a: i64 = 1
    while true {
        let p: i64 = 3 * a * a + 3 * a + 1
        if p >= limit { break }
        if is_prime(p) { count = count + 1 }
        a = a + 1
    }
    printf("%lld\n", count)
    return 0
}
