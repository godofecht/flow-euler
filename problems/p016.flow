# Project Euler 016
# Sum of digits of 2^1000.
# Digits grow in an array — no bigint library required.

import euler.digits { Digits, digits_one, digits_mul_u32, digits_sum }

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function main() -> i32 {
    let mut d: Digits = digits_one(400)
    if d.data == null {
        return 1
    }

    for exp in 0..1000 {
        digits_mul_u32(&d, 2)
    }

    printf("%lld\n", digits_sum(d))
    free(d.data)
    return 0
}
