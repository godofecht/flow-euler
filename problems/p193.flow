# Project Euler 193
# Count squarefree numbers below 2^50 via Möbius inversion.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function main() -> i32 {
    let N: i64 = 1
    N = N << 50
    # lim = floor(sqrt(N)) = 2^25
    let lim: i64 = 1
    lim = lim << 25
    let mu: ptr<i8> = calloc(lim + 1, 1)
    let prime: ptr<i8> = calloc(lim + 1, 1)
    if mu == null || prime == null { return 1 }
    let mut i: i64 = 0
    while i <= lim {
        mu[i] = 1
        prime[i] = 1
        i = i + 1
    }
    prime[0] = 0
    prime[1] = 0
    i = 2
    while i <= lim {
        if prime[i] == 1 {
            let mut j: i64 = i * i
            while j <= lim {
                prime[j] = 0
                j = j + i
            }
            j = i
            while j <= lim {
                mu[j] = (0 - mu[j]) as i8
                j = j + i
            }
            let sq: i64 = i * i
            j = sq
            while j <= lim {
                mu[j] = 0
                j = j + sq
            }
        }
        i = i + 1
    }
    let mut S: i64 = 0
    let mut d: i64 = 1
    while d <= lim {
        let m: i64 = mu[d] as i64
        if m != 0 {
            S = S + m * (N / (d * d))
        }
        d = d + 1
    }
    printf("%lld\n", S)
    free(prime)
    free(mu)
    return 0
}
