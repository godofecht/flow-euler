# Project Euler 020
# Sum of digits in 100!

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function main() -> i32 {
    let digits: ptr<i32> = calloc(200, 4)
    if digits == null {
        return 1
    }
    digits[0] = 1
    let mut len: i32 = 1

    let mut n: i32 = 2
    while n <= 100 {
        let mut carry: i32 = 0
        let mut i: i32 = 0
        while i < len {
            let v: i32 = digits[i] * n + carry
            digits[i] = v % 10
            carry = v / 10
            i = i + 1
        }
        while carry > 0 {
            digits[len] = carry % 10
            carry = carry / 10
            len = len + 1
        }
        n = n + 1
    }

    let mut total: i64 = 0
    let mut i: i32 = 0
    while i < len {
        total = total + (digits[i] as i64)
        i = i + 1
    }
    printf("%lld\n", total)
    free(digits)
    return 0
}
