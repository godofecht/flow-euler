# Project Euler 521
# Smallest Prime Factor — S(10^12) mod 10^9 via filtered tables.

import euler.nt { isqrt }

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

const MOD: i64 = 1000000000

function initial_sum(x: i64) -> i64 {
    if x < 2 { return 0 }
    return (x * (x + 1) / 2 - 1) % MOD
}

function main() -> i32 {
    let n: i64 = 1000000000000
    let root: i64 = isqrt(n)
    let count_s: ptr<i64> = calloc(root + 1, 8)
    let sum_s: ptr<i64> = calloc(root + 1, 8)
    let count_l: ptr<i64> = calloc(root + 1, 8)
    let sum_l: ptr<i64> = calloc(root + 1, 8)
    if count_s == null || sum_s == null || count_l == null || sum_l == null { return 1 }
    let mut x: i64 = 1
    while x <= root {
        count_s[x] = x - 1
        sum_s[x] = initial_sum(x)
        x = x + 1
    }
    let mut d: i64 = 1
    while d <= root {
        let xv: i64 = n / d
        count_l[d] = xv - 1
        sum_l[d] = initial_sum(xv)
        d = d + 1
    }
    let mut answer: i64 = 0
    let mut p: i64 = 2
    while p <= root {
        let count_before: i64 = count_s[p - 1]
        if count_s[p] == count_before {
            p = p + 1
            continue
        }
        let sum_before: i64 = sum_s[p - 1]
        answer = (answer + p * ((count_l[p] - count_before) % MOD + MOD) % MOD) % MOD
        let p2: i64 = p * p
        let mut large_stop: i64 = n / p2
        if large_stop > root { large_stop = root }
        d = 1
        while d <= large_stop {
            let q: i64 = n / (d * p)
            let mut q_count: i64 = 0
            let mut q_sum: i64 = 0
            if q <= root {
                q_count = count_s[q]
                q_sum = sum_s[q]
            } else {
                let idx: i64 = n / q
                q_count = count_l[idx]
                q_sum = sum_l[idx]
            }
            count_l[d] = count_l[d] - (q_count - count_before)
            sum_l[d] = (sum_l[d] - p * ((q_sum - sum_before) % MOD + MOD) % MOD) % MOD
            if sum_l[d] < 0 { sum_l[d] = sum_l[d] + MOD }
            d = d + 1
        }
        if p2 <= root {
            x = root
            while x >= p2 {
                let q2: i64 = x / p
                count_s[x] = count_s[x] - (count_s[q2] - count_before)
                sum_s[x] = (sum_s[x] - p * ((sum_s[q2] - sum_before) % MOD + MOD) % MOD) % MOD
                if sum_s[x] < 0 { sum_s[x] = sum_s[x] + MOD }
                x = x - 1
            }
        }
        p = p + 1
    }
    let ans: i64 = (answer + sum_l[1]) % MOD
    printf("%lld\n", ans)
    free(count_s); free(sum_s); free(count_l); free(sum_l)
    return 0
}
