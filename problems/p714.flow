# Project Euler 714
# Duodigits.  d(n) is the smallest positive multiple of n whose decimal
# form uses at most two distinct digits; D(k) = sum of d(n) for n <= k.
#
# For each n and each of the 45 digit pairs {a,b}, BFS over remainders
# mod n: states are remainders, edges append a digit, so numbers are
# enumerated in increasing (length, value) order and the first remainder
# 0 is that pair's minimum.  The running best length caps later searches.
# The sum is kept exactly in i128 and printed with 13 significant digits.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

const N: i64 = 50000

function main() -> i32 {
    let seen: ptr<i64> = calloc(N + 2, 8)
    let prv: ptr<i64> = calloc(N + 2, 8)
    let dg: ptr<i64> = calloc(N + 2, 8)
    let qq: ptr<i64> = calloc(N + 2, 8)
    let buf: ptr<i64> = calloc(64, 8)
    let pa: ptr<i64> = calloc(45, 8)
    let pb: ptr<i64> = calloc(45, 8)

    let mut np: i64 = 0
    let mut aa: i64 = 0
    while aa < 10 {
        let mut bb: i64 = aa + 1
        while bb < 10 {
            pa[np] = aa
            pb[np] = bb
            np = np + 1
            bb = bb + 1
        }
        aa = aa + 1
    }

    let mut token: i64 = 0
    let mut total: i128 = 0 as i128

    let mut n: i64 = 1
    while n <= N {
        let mut bestlen: i64 = 1000000
        let mut bestval: i128 = 0 as i128 - (1 as i128)
        let mut p: i64 = 0
        while p < 45 {
            let a: i64 = pa[p]
            let b: i64 = pb[p]
            token = token + 1
            let mut hit: i64 = 0
            let mut hitpar: i64 = 0
            let mut hitdig: i64 = 0
            let mut hitlen: i64 = 0
            let mut cnt: i64 = 0
            # seed with the one-digit numbers (no leading zeros)
            let mut s: i64 = 0
            while s < 2 {
                let mut d: i64 = a
                if s == 1 { d = b }
                if d > 0 && hit == 0 {
                    let r: i64 = d % n
                    if r == 0 {
                        hit = 1
                        hitpar = 0 - 1
                        hitdig = d
                        hitlen = 1
                    } else {
                        if seen[r] != token {
                            seen[r] = token
                            prv[r] = 0 - 1
                            dg[r] = d
                            qq[cnt] = r
                            cnt = cnt + 1
                        }
                    }
                }
                s = s + 1
            }
            # BFS level by level inside one flat queue
            let mut ls: i64 = 0
            let mut le: i64 = cnt
            let mut level: i64 = 1
            while hit == 0 && ls < le && level < bestlen {
                let mut ne: i64 = le
                let mut i: i64 = ls
                while i < le && hit == 0 {
                    let r: i64 = qq[i]
                    let mut t: i64 = 0
                    while t < 2 && hit == 0 {
                        let mut d: i64 = a
                        if t == 1 { d = b }
                        let nr: i64 = (r * 10 + d) % n
                        if nr == 0 {
                            hit = 1
                            hitpar = r
                            hitdig = d
                            hitlen = level + 1
                        } else {
                            if seen[nr] != token {
                                seen[nr] = token
                                prv[nr] = r
                                dg[nr] = d
                                qq[ne] = nr
                                ne = ne + 1
                            }
                        }
                        t = t + 1
                    }
                    i = i + 1
                }
                ls = le
                le = ne
                level = level + 1
            }
            if hit == 1 {
                if hitlen <= 25 {
                    # walk the parent chain and rebuild the value exactly
                    let mut k: i64 = 0
                    buf[k] = hitdig
                    k = k + 1
                    let mut c: i64 = hitpar
                    while c != 0 - 1 {
                        buf[k] = dg[c]
                        k = k + 1
                        c = prv[c]
                    }
                    let mut val: i128 = 0 as i128
                    let mut j: i64 = k - 1
                    while j >= 0 {
                        val = val * (10 as i128) + (buf[j] as i128)
                        j = j - 1
                    }
                    if hitlen < bestlen {
                        bestlen = hitlen
                        bestval = val
                    } else {
                        if hitlen == bestlen {
                            if bestval < (0 as i128) || val < bestval {
                                bestval = val
                            }
                        }
                    }
                } else {
                    # too long to matter for the final minimum (d(n) has
                    # at most 21 digits); keep only the length as a cap
                    if hitlen < bestlen {
                        bestlen = hitlen
                        bestval = 0 as i128 - (1 as i128)
                    }
                }
            }
            p = p + 1
        }
        total = total + bestval
        n = n + 1
    }

    # scientific notation, 13 significant digits (12 after the point)
    let mut tmp: i128 = total
    let mut nd: i64 = 0
    while tmp > (0 as i128) {
        tmp = tmp / (10 as i128)
        nd = nd + 1
    }
    let mut ex: i64 = nd - 1
    let mut mant: i128 = total
    if nd > 13 {
        let mut shift: i64 = nd - 13
        let mut pw: i128 = 1 as i128
        let mut u: i64 = 0
        while u < shift {
            pw = pw * (10 as i128)
            u = u + 1
        }
        mant = (total + pw / (2 as i128)) / pw
        # rounding may carry into a 14th digit
        let mut cap: i128 = 1 as i128
        u = 0
        while u < 13 {
            cap = cap * (10 as i128)
            u = u + 1
        }
        if mant >= cap {
            mant = mant / (10 as i128)
            ex = ex + 1
        }
    } else {
        let mut u: i64 = nd
        while u < 13 {
            mant = mant * (10 as i128)
            u = u + 1
        }
    }
    let m64: i64 = mant as i64
    printf("%lld.%012llde%lld\n", m64 / 1000000000000, m64 % 1000000000000, ex)

    free(seen)
    free(prv)
    free(dg)
    free(qq)
    free(buf)
    free(pa)
    free(pb)
    return 0
}
