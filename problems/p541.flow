# Project Euler 541
# Divisibility of Harmonic Number Denominators — M(137).

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

const P: i64 = 137
const SMAX: i64 = 12
const CAP: i64 = 65536

function modpow(b0: i64, e0: i64, mod: i64) -> i64 {
    let mut r: i64 = 1
    let mut b: i64 = b0 % mod
    let mut e: i64 = e0
    while e > 0 {
        if (e & 1) != 0 { r = ((r as i128) * (b as i128) % (mod as i128)) as i64 }
        b = ((b as i128) * (b as i128) % (mod as i128)) as i64
        e = e >> 1
    }
    return r
}

function inv_mod(a0: i64, mod: i64) -> i64 {
    let mut a: i64 = a0 % mod
    if a < 0 { a = a + mod }
    let mut t: i64 = 0
    let mut newt: i64 = 1
    let mut r: i64 = mod
    let mut newr: i64 = a
    while newr != 0 {
        let q: i64 = r / newr
        let tt: i64 = newt
        newt = t - q * newt
        t = tt
        let rr: i64 = newr
        newr = r - q * newr
        r = rr
    }
    if r != 1 { return 0 }
    if t < 0 { t = t + mod }
    return t
}

function ipow_mod(b: i64, e: i64) -> i64 {
    let mut r: i128 = 1 as i128
    let mut base: i128 = b as i128
    let mut exp: i64 = e
    while exp > 0 {
        if (exp & 1) != 0 { r = r * base }
        base = base * base
        exp = exp >> 1
    }
    return r as i64
}

function hslot(k: i64, keys: ptr<i64>, used: ptr<i8>) -> i64 {
    let mut h: i64 = k % CAP
    if h < 0 { h = h + CAP }
    while used[h] == 1 && keys[h] != k {
        h = h + 1
        if h == CAP { h = 0 }
    }
    return h
}

function pow_sum(m: i64, q: i64, s: i64,
                 binom: ptr<i64>, prefix: ptr<i64>, digit: ptr<i64>,
                 pk: ptr<i64>, pv: ptr<i64>, pu: ptr<i8>) -> i64 {
    if q <= 0 { return 0 }
    let key: i64 = m * 100000 + q * 100 + s
    let slot: i64 = hslot(key, pk, pu)
    if pu[slot] == 1 { return pv[slot] }
    let modv: i64 = ipow_mod(P, s)
    let mut res: i64 = 0
    if q <= P {
        res = prefix[q * (SMAX + 1) + m] % modv
    } else {
        let Q: i64 = q / P
        let R: i64 = q % P
        let mut t: i64 = 0
        while t <= m {
            let term: i128 = (binom[m * (SMAX + 1) + t] as i128)
                * (modpow(P, t, modv) as i128)
                * (pow_sum(t, Q, s, binom, prefix, digit, pk, pv, pu) as i128)
                * (digit[m - t] as i128)
            res = (res + (term % (modv as i128)) as i64) % modv
            t = t + 1
        }
        let base: i64 = (Q * P) % modv
        t = 0
        while t <= m {
            let term: i128 = (binom[m * (SMAX + 1) + t] as i128)
                * (modpow(base, t, modv) as i128)
                * (prefix[R * (SMAX + 1) + (m - t)] as i128)
            res = (res + (term % (modv as i128)) as i64) % modv
            t = t + 1
        }
    }
    pu[slot] = 1
    pk[slot] = key
    pv[slot] = res
    return res
}

function get_cm(s: i64, m: i64, ck: ptr<i64>, cv: ptr<i64>, cu: ptr<i8>) -> i64 {
    let key: i64 = s * 100 + m
    let slot: i64 = hslot(key, ck, cu)
    if cu[slot] == 1 { return cv[slot] }
    let modv: i64 = ipow_mod(P, s)
    let mut sm: i64 = 0
    let mut j: i64 = 1
    while j < P {
        let invj: i64 = inv_mod(j, modv)
        sm = (sm + modpow(invj, m + 1, modv)) % modv
        j = j + 1
    }
    cu[slot] = 1
    ck[slot] = key
    cv[slot] = sm
    return sm
}

function unit_inverse_sum(N: i64, s: i64,
                          binom: ptr<i64>, prefix: ptr<i64>, digit: ptr<i64>,
                          pk: ptr<i64>, pv: ptr<i64>, pu: ptr<i8>,
                          ck: ptr<i64>, cv: ptr<i64>, cu: ptr<i8>,
                          uk: ptr<i64>, uv: ptr<i64>, uu: ptr<i8>) -> i64 {
    if N <= 0 { return 0 }
    let key: i64 = N * 20 + s
    let slot: i64 = hslot(key % CAP, uk, uu)
    if uu[slot] == 1 && uk[slot] == key { return uv[slot] }
    let modv: i64 = ipow_mod(P, s)
    let q: i64 = N / P
    let r: i64 = N % P
    let mut total: i64 = 0
    if q > 0 {
        let mut m: i64 = 0
        while m < s {
            let Sm: i64 = pow_sum(m, q, s, binom, prefix, digit, pk, pv, pu)
            let mut term: i64 = ((modpow(P, m, modv) as i128) * (Sm as i128) % (modv as i128)) as i64
            term = ((term as i128) * (get_cm(s, m, ck, cv, cu) as i128) % (modv as i128)) as i64
            if (m & 1) != 0 { term = (modv - term) % modv }
            total = (total + term) % modv
            m = m + 1
        }
    }
    let base: i64 = q * P
    let mut j: i64 = 1
    while j <= r {
        if j % P != 0 {
            total = (total + inv_mod(base + j, modv)) % modv
        }
        j = j + 1
    }
    uu[slot] = 1
    uk[slot] = key
    uv[slot] = total
    return total
}

function V_val(e: i64, m: i64, mp: i64,
               binom: ptr<i64>, prefix: ptr<i64>, digit: ptr<i64>,
               pk: ptr<i64>, pv: ptr<i64>, pu: ptr<i8>,
               ck: ptr<i64>, cv: ptr<i64>, cu: ptr<i8>,
               uk: ptr<i64>, uv: ptr<i64>, uu: ptr<i8>,
               vk: ptr<i64>, vv: ptr<i64>, vu: ptr<i8>) -> i64 {
    let key: i64 = e * 1000000000000000 + m * 1000 + mp
    let slot: i64 = hslot(key % CAP, vk, vu)
    if vu[slot] == 1 && vk[slot] == key { return vv[slot] }
    let modv: i64 = ipow_mod(P, mp)
    let mut val: i64 = 0
    let mut div: i64 = 1
    let mut t: i64 = 1
    while t <= e {
        let coeff: i64 = ipow_mod(P, e - t)
        let N: i64 = m / div
        val = (val + coeff * unit_inverse_sum(N, mp, binom, prefix, digit, pk, pv, pu, ck, cv, cu, uk, uv, uu)) % modv
        div = div * P
        t = t + 1
    }
    vu[slot] = 1
    vk[slot] = key
    vv[slot] = val
    return val
}

function main() -> i32 {
    let binom: ptr<i64> = calloc((SMAX + 1) * (SMAX + 1), 8)
    let prefix: ptr<i64> = calloc((P + 1) * (SMAX + 1), 8)
    let digit: ptr<i64> = calloc(SMAX + 1, 8)
    let ha_cnt: ptr<i64> = calloc(P, 8)
    let ha_dig: ptr<i64> = calloc(P * P, 8)
    if binom == null || prefix == null || digit == null || ha_cnt == null || ha_dig == null { return 1 }
    let mut n: i64 = 0
    while n <= SMAX {
        binom[n * (SMAX + 1) + 0] = 1
        binom[n * (SMAX + 1) + n] = 1
        let mut k: i64 = 1
        while k < n {
            binom[n * (SMAX + 1) + k] = binom[(n - 1) * (SMAX + 1) + (k - 1)] + binom[(n - 1) * (SMAX + 1) + k]
            k = k + 1
        }
        n = n + 1
    }
    let mut r: i64 = 1
    while r <= P {
        let b: i64 = r - 1
        let mut k: i64 = 0
        while k <= SMAX {
            prefix[r * (SMAX + 1) + k] = prefix[(r - 1) * (SMAX + 1) + k] + ipow_mod(b, k)
            k = k + 1
        }
        r = r + 1
    }
    let mut k: i64 = 0
    while k <= SMAX {
        digit[k] = prefix[P * (SMAX + 1) + k]
        k = k + 1
    }
    let invs: ptr<i64> = calloc(P, 8)
    let ha: ptr<i64> = calloc(P, 8)
    if invs == null || ha == null { return 1 }
    let mut a: i64 = 1
    while a < P {
        invs[a] = inv_mod(a, P)
        a = a + 1
    }
    let mut s: i64 = 0
    a = 1
    while a < P {
        s = (s + invs[a]) % P
        ha[a] = s
        a = a + 1
    }
    ha[0] = 0
    a = 0
    while a < P {
        let v: i64 = ha[a]
        let idx: i64 = ha_cnt[v]
        ha_dig[v * P + idx] = a
        ha_cnt[v] = idx + 1
        a = a + 1
    }
    let pk: ptr<i64> = calloc(CAP, 8)
    let pv: ptr<i64> = calloc(CAP, 8)
    let pu: ptr<i8> = calloc(CAP, 1)
    let ck: ptr<i64> = calloc(CAP, 8)
    let cv: ptr<i64> = calloc(CAP, 8)
    let cu: ptr<i8> = calloc(CAP, 1)
    let uk: ptr<i64> = calloc(CAP, 8)
    let uv: ptr<i64> = calloc(CAP, 8)
    let uu: ptr<i8> = calloc(CAP, 1)
    let vk: ptr<i64> = calloc(CAP, 8)
    let vv: ptr<i64> = calloc(CAP, 8)
    let vu: ptr<i8> = calloc(CAP, 1)
    let A: ptr<i64> = calloc(4096, 8)
    let An: ptr<i64> = calloc(1, 8)
    if pk == null || pv == null || pu == null { return 1 }
    let mut best: i64 = P - 1
    An[0] = 0
    let mut i: i64 = 0
    while i < ha_cnt[0] {
        let m: i64 = ha_dig[0 * P + i]
        if m >= 1 && m < P {
            A[An[0]] = m
            An[0] = An[0] + 1
        }
        i = i + 1
    }
    let mut e: i64 = 1
    while An[0] > 0 {
        let mut maxA: i64 = 0
        i = 0
        while i < An[0] {
            if A[i] > maxA { maxA = A[i] }
            i = i + 1
        }
        best = P * maxA + (P - 1)
        let nextA: ptr<i64> = calloc(4096, 8)
        let mut nn: i64 = 0
        i = 0
        while i < An[0] {
            let q: i64 = A[i]
            let val: i64 = V_val(e, q, e + 1, binom, prefix, digit, pk, pv, pu, ck, cv, cu, uk, uv, uu, vk, vv, vu)
            let pe: i64 = ipow_mod(P, e)
            let d: i64 = (val / pe) % P
            let target: i64 = (P - d) % P
            let mut j: i64 = 0
            while j < ha_cnt[target] {
                let digit_a: i64 = ha_dig[target * P + j]
                let child: i64 = q * P + digit_a
                let mut dup: i32 = 0
                let mut t: i64 = 0
                while t < nn {
                    if nextA[t] == child { dup = 1; break }
                    t = t + 1
                }
                if dup == 0 {
                    nextA[nn] = child
                    nn = nn + 1
                }
                j = j + 1
            }
            i = i + 1
        }
        i = 0
        while i < nn { A[i] = nextA[i]; i = i + 1 }
        An[0] = nn
        free(nextA)
        e = e + 1
        if e > 30 { break }
    }
    printf("%lld\n", best)
    free(binom); free(prefix); free(digit); free(ha_cnt); free(ha_dig)
    free(invs); free(ha); free(pk); free(pv); free(pu)
    free(ck); free(cv); free(cu); free(uk); free(uv); free(uu)
    free(vk); free(vv); free(vu); free(A); free(An)
    return 0
}
