# Project Euler 191
# Prize strings of length 30: no 3 consecutive A, at most one L.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function main() -> i32 {
    # dp[day+1][late][abs_streak]
    let dp: ptr<i64> = calloc(31 * 2 * 3, 8)
    if dp == null { return 1 }
    dp[0 * 2 * 3 + 0 * 3 + 0] = 1
    let mut day: i32 = 0
    while day < 30 {
        let mut late: i32 = 0
        while late < 2 {
            let mut astr: i32 = 0
            while astr < 3 {
                let v: i64 = dp[day * 2 * 3 + late * 3 + astr]
                if v != 0 {
                    # O
                    dp[(day + 1) * 2 * 3 + late * 3 + 0] = dp[(day + 1) * 2 * 3 + late * 3 + 0] + v
                    # L
                    if late == 0 {
                        dp[(day + 1) * 2 * 3 + 1 * 3 + 0] = dp[(day + 1) * 2 * 3 + 1 * 3 + 0] + v
                    }
                    # A
                    if astr < 2 {
                        dp[(day + 1) * 2 * 3 + late * 3 + (astr + 1)] = dp[(day + 1) * 2 * 3 + late * 3 + (astr + 1)] + v
                    }
                }
                astr = astr + 1
            }
            late = late + 1
        }
        day = day + 1
    }
    let mut total: i64 = 0
    let mut late2: i32 = 0
    while late2 < 2 {
        let mut astr2: i32 = 0
        while astr2 < 3 {
            total = total + dp[30 * 2 * 3 + late2 * 3 + astr2]
            astr2 = astr2 + 1
        }
        late2 = late2 + 1
    }
    printf("%lld\n", total)
    free(dp)
    return 0
}
