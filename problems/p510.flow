# Project Euler 510
# Tangent Circles — parameterized (m,n) families, N = 10^9.

function gcd(a0: i64, b0: i64) -> i64 {
    let mut a: i64 = a0
    let mut b: i64 = b0
    while b != 0 {
        let t: i64 = a % b
        a = b
        b = t
    }
    return a
}

function triangle(n: i64) -> i64 {
    return n * (n + 1) / 2
}

function main() -> i32 {
    let limit: i64 = 1000000000
    let mut result: i64 = 0
    let mut n: i64 = 1
    while (n + 1) * (n + 1) * n * n <= limit {
        let n2: i64 = n * n
        let mut m: i64 = 1
        while m <= n {
            if gcd(m, n) == 1 {
                let m2: i64 = m * m
                let sum2: i64 = (m + n) * (m + n)
                let b0: i64 = sum2 * n2
                if b0 > limit {
                    break
                }
                let a0: i64 = sum2 * m2
                let c0: i64 = m2 * n2
                let multiples: i64 = limit / b0
                result = result + (a0 + b0 + c0) * triangle(multiples)
            }
            m = m + 1
        }
        n = n + 1
    }
    printf("%lld\n", result)
    return 0
}
