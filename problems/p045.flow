# Project Euler 045
# Next triangle number after 40755 that is also pentagonal and hexagonal.

function isqrt(n: i64) -> i64 {
    if n < 0 { return 0 }
    if n < 2 { return n }
    let mut x: i64 = n
    let mut y: i64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

function is_pent(x: i64) -> bool {
    let target: i64 = 24 * x + 1
    let s: i64 = isqrt(target)
    if s * s != target { return false }
    return (s + 1) % 6 == 0
}

function hex(n: i64) -> i64 {
    return n * (2 * n - 1)
}

function main() -> i32 {
    let mut n: i64 = 144
    while true {
        let h: i64 = hex(n)
        if is_pent(h) {
            printf("%lld\n", h)
            return 0
        }
        n = n + 1
    }
    return 0
}
