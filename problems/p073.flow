# Project Euler 073
# How many fractions lie between 1/3 and 1/2 for d ≤ 12,000?

import euler.nt { gcd }

function main() -> i32 {
    let limit: i64 = 12000
    let mut count: i64 = 0
    for d in 1..(limit + 1) {
        # 1/3 < n/d < 1/2 => d/3 < n < d/2
        let hi: i64 = (d - 1) / 2
        for n in (d / 3 + 1)..(hi + 1) {
            if gcd(n, d) == 1 { count = count + 1 }
        }
    }
    printf("%lld\n", count)
    return 0
}
