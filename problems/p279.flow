# Project Euler 279
# Count triangles with angles 60/90/120 and perimeter <= 10^8.

import euler.nt { gcd, isqrt }

function search90(limit: i64) -> i64 {
    let mut result: i64 = 0
    let last: i64 = isqrt(limit / 2)
    let mut m: i64 = 2
    while m < last {
        let mut n: i64 = (m % 2) + 1
        while n < m {
            if gcd(m, n) == 1 {
                let a: i64 = m * m - n * n
                let b: i64 = 2 * m * n
                let c: i64 = m * m + n * n
                let total: i64 = a + b + c
                if total > limit { break }
                result = result + limit / total
            }
            n = n + 2
        }
        m = m + 1
    }
    return result
}

function search60(limit: i64) -> i64 {
    let last: i64 = isqrt(limit * 3 / 2)
    let mut result: i64 = 0
    let mut m: i64 = 2
    while m < last {
        let mut n: i64 = 1
        while 2 * n <= m {
            if gcd(m, n) == 1 {
                let a: i64 = m * m - m * n + n * n
                let b: i64 = 2 * m * n - n * n
                let c: i64 = m * m - n * n
                let mut total: i64 = a + b + c
                if a % 3 == 0 && b % 3 == 0 && c % 3 == 0 {
                    total = total / 3
                }
                if total > 3 * limit { break }
                if total <= limit {
                    result = result + limit / total
                }
            }
            n = n + 1
        }
        m = m + 1
    }
    return result
}

function search120(limit: i64) -> i64 {
    let mut result: i64 = 0
    let last: i64 = isqrt(limit * 3 / 2)
    let mut m: i64 = 2
    while m < last {
        let mut n: i64 = 1
        while 2 * n <= m {
            if gcd(m, n) == 1 {
                let a: i64 = m * m + m * n + n * n
                let b: i64 = 2 * m * n + n * n
                let c: i64 = m * m - n * n
                if b > c { break }
                let mut total: i64 = a + b + c
                if a % 3 == 0 && b % 3 == 0 && c % 3 == 0 {
                    total = total / 3
                }
                if total > 3 * limit { break }
                result = result + limit / total
            }
            n = n + 1
        }
        m = m + 1
    }
    return result
}

function main() -> i32 {
    let limit: i64 = 100000000
    printf("%lld\n", search60(limit) + search90(limit) + search120(limit))
    return 0
}
