# Project Euler 075
# How many values of L ≤ 1,500,000 can form exactly one integer sided right triangle?

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function gcd(a0: i64, b0: i64) -> i64 {
    let mut a: i64 = a0
    let mut b: i64 = b0
    while b != 0 {
        let t: i64 = a % b
        a = b
        b = t
    }
    return a
}

function main() -> i32 {
    let limit: i64 = 1500000
    let counts: ptr<i32> = calloc(limit + 1, 4)
    if counts == null { return 1 }

    # generate primitives via m>n>0, m-n odd, gcd=1
    let mut m: i64 = 2
    while 2 * m * (m + 1) <= limit {
        let mut n: i64 = 1 + (m % 2)  # opposite parity
        while n < m {
            if gcd(m, n) == 1 {
                let a: i64 = m * m - n * n
                let b: i64 = 2 * m * n
                let c: i64 = m * m + n * n
                let peri: i64 = a + b + c
                let mut L: i64 = peri
                while L <= limit {
                    counts[L as i32] = counts[L as i32] + 1
                    L = L + peri
                }
            }
            n = n + 2
        }
        m = m + 1
    }

    let mut ans: i64 = 0
    let mut i: i64 = 1
    while i <= limit {
        if counts[i as i32] == 1 {
            ans = ans + 1
        }
        i = i + 1
    }
    printf("%lld\n", ans)
    free(counts)
    return 0
}
