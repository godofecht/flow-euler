# Project Euler 765: Trillionaire
# Optimal betting strategy via fair-coin martingale bound.
# Pure Flow port of the native C helper. GMP big integers are replaced by
# a base-10000 big integer library implemented in Flow.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function malloc(n: i64) -> ptr<void>
}

const BASE: i64 = 10000

struct Big {
    data: ptr<i32>,
    len: i32
}

function big_norm(data: ptr<i32>, len: i32) -> Big {
    let mut n: i32 = len
    while n > 1 {
        if data[n - 1] != 0 {
            break
        }
        n = n - 1
    }
    return Big { data: data, len: n }
}

function big_from_i32(val: i32) -> Big {
    let data: ptr<i32> = malloc(4)
    data[0] = val
    return Big { data: data, len: 1 }
}

function big_is_zero(a: Big) -> i32 {
    if a.len == 1 {
        if a.data[0] == 0 {
            return 1
        }
    }
    return 0
}

function big_cmp(a: Big, b: Big) -> i32 {
    if a.len != b.len {
        if a.len > b.len {
            return 1
        }
        return -1
    }
    let mut i: i32 = a.len - 1
    while i >= 0 {
        if a.data[i] != b.data[i] {
            if a.data[i] > b.data[i] {
                return 1
            }
            return -1
        }
        i = i - 1
    }
    return 0
}

function big_add(a: Big, b: Big) -> Big {
    let mut max_len: i32 = a.len
    if b.len > max_len {
        max_len = b.len
    }
    let data: ptr<i32> = malloc(((max_len + 1) as i64) * 4)
    let mut carry: i32 = 0
    let mut i: i32 = 0
    while i < max_len {
        let mut sum: i32 = carry
        if i < a.len {
            sum = sum + a.data[i]
        }
        if i < b.len {
            sum = sum + b.data[i]
        }
        data[i] = sum % (BASE as i32)
        carry = sum / (BASE as i32)
        i = i + 1
    }
    data[max_len] = carry
    return big_norm(data, max_len + 1)
}

function big_sub(a: Big, b: Big) -> Big {
    let data: ptr<i32> = malloc((a.len as i64) * 4)
    let mut borrow: i32 = 0
    let mut i: i32 = 0
    while i < a.len {
        let mut diff: i32 = a.data[i] - borrow
        if i < b.len {
            diff = diff - b.data[i]
        }
        if diff < 0 {
            diff = diff + (BASE as i32)
            borrow = 1
        } else {
            borrow = 0
        }
        data[i] = diff
        i = i + 1
    }
    return big_norm(data, a.len)
}

function big_mul_small(a: Big, m: i32) -> Big {
    let data: ptr<i32> = malloc(((a.len + 1) as i64) * 4)
    let mut carry: i64 = 0
    let mut i: i32 = 0
    while i < a.len {
        let prod: i64 = (a.data[i] as i64) * (m as i64) + carry
        data[i] = (prod % BASE) as i32
        carry = prod / BASE
        i = i + 1
    }
    data[a.len] = carry as i32
    return big_norm(data, a.len + 1)
}

function big_mul(a: Big, b: Big) -> Big {
    let total: i32 = a.len + b.len
    let result: ptr<i64> = calloc((total as i64), 8)
    let mut i: i32 = 0
    while i < a.len {
        let mut j: i32 = 0
        while j < b.len {
            result[i + j] = result[i + j] + (a.data[i] as i64) * (b.data[j] as i64)
            j = j + 1
        }
        i = i + 1
    }
    let data: ptr<i32> = malloc((total as i64) * 4)
    let mut carry: i64 = 0
    let mut k: i32 = 0
    while k < total {
        let val: i64 = result[k] + carry
        data[k] = (val % BASE) as i32
        carry = val / BASE
        k = k + 1
    }
    free(result)
    return big_norm(data, total)
}

function big_div_small(a: Big, d: i32) -> Big {
    let data: ptr<i32> = malloc((a.len as i64) * 4)
    let mut rem: i64 = 0
    let mut i: i32 = a.len - 1
    while i >= 0 {
        let cur: i64 = rem * BASE + (a.data[i] as i64)
        data[i] = (cur / (d as i64)) as i32
        rem = cur % (d as i64)
        i = i - 1
    }
    return big_norm(data, a.len)
}

function big_to_double(a: Big) -> f64 {
    let mut result: f64 = 0.0
    let mut i: i32 = a.len - 1
    while i >= 0 {
        result = result * (BASE as f64) + (a.data[i] as f64)
        i = i - 1
    }
    return result
}

function main() -> i32 {
    let n: i32 = 1000

    # total_paths = 2^n
    let mut total_paths: Big = big_from_i32(1)
    let mut i: i32 = 0
    while i < n {
        total_paths = big_mul_small(total_paths, 2)
        i = i + 1
    }

    # budget_paths = total_paths / 10^12 (divide by 10 twelve times)
    let mut budget_paths: Big = total_paths
    let mut j: i32 = 0
    while j < 12 {
        budget_paths = big_div_small(budget_paths, 10)
        j = j + 1
    }

    # Compute C(n, k) for k = 0..n
    let comb: ptr<Big> = malloc(((n + 1) as i64) * 16)
    comb[0] = big_from_i32(1)
    let mut k: i32 = 1
    while k <= n {
        let mul_val: Big = big_mul_small(comb[k - 1], n - k + 1)
        comb[k] = big_div_small(mul_val, k)
        k = k + 1
    }

    # Compute suffix[k] = sum_{j>=k} C(n, j)
    let suffix: ptr<Big> = malloc(((n + 2) as i64) * 16)
    suffix[n + 1] = big_from_i32(0)
    let mut k2: i32 = n
    while k2 >= 0 {
        suffix[k2] = big_add(suffix[k2 + 1], comb[k2])
        k2 = k2 - 1
    }

    # Find k0: largest k such that suffix[k] > budget_paths and budget_paths >= suffix[k+1]
    let mut k0: i32 = -1
    let mut k3: i32 = n
    while k3 >= 0 {
        if big_cmp(suffix[k3], budget_paths) > 0 {
            if big_cmp(budget_paths, suffix[k3 + 1]) >= 0 {
                k0 = k3
                break
            }
        }
        k3 = k3 - 1
    }

    # rem = budget_paths - suffix[k0 + 1]
    let rem: Big = big_sub(budget_paths, suffix[k0 + 1])

    # Precompute pow2[i] = 2^i, pow3[i] = 3^i
    let pow2: ptr<Big> = malloc(((n + 1) as i64) * 16)
    let pow3: ptr<Big> = malloc(((n + 1) as i64) * 16)
    pow2[0] = big_from_i32(1)
    pow3[0] = big_from_i32(1)
    let mut i4: i32 = 1
    while i4 <= n {
        pow2[i4] = big_mul_small(pow2[i4 - 1], 2)
        pow3[i4] = big_mul_small(pow3[i4 - 1], 3)
        i4 = i4 + 1
    }

    # den = 5^n
    let mut den: Big = big_from_i32(1)
    let mut i5: i32 = 0
    while i5 < n {
        den = big_mul_small(den, 5)
        i5 = i5 + 1
    }

    # num = sum over k>=k0+1 of C(n,k)*3^k*2^(n-k) + rem*3^k0*2^(n-k0)
    let mut num: Big = big_from_i32(0)
    let mut k4: i32 = k0 + 1
    while k4 <= n {
        let term: Big = big_mul(comb[k4], pow3[k4])
        let term2: Big = big_mul(term, pow2[n - k4])
        num = big_add(num, term2)
        k4 = k4 + 1
    }

    if big_is_zero(rem) == 0 {
        let term: Big = big_mul(rem, pow3[k0])
        let term2: Big = big_mul(term, pow2[n - k0])
        num = big_add(num, term2)
    }

    # scaled_num = num * 10^10 (multiply by 10 ten times)
    let mut scaled_num: Big = num
    let mut i6: i32 = 0
    while i6 < 10 {
        scaled_num = big_mul_small(scaled_num, 10)
        i6 = i6 + 1
    }

    # q = scaled_num / den (divide by 5 n times since den = 5^n)
    let mut q: Big = scaled_num
    let mut i7: i32 = 0
    while i7 < n {
        q = big_div_small(q, 5)
        i7 = i7 + 1
    }

    # r = scaled_num - q * den
    let q_den: Big = big_mul(q, den)
    let r: Big = big_sub(scaled_num, q_den)

    # if 2*r >= den: q += 1
    let r2: Big = big_mul_small(r, 2)
    if big_cmp(r2, den) >= 0 {
        q = big_add(q, big_from_i32(1))
    }

    # result = q / 10^10 as double
    let q_double: f64 = big_to_double(q)
    let result: f64 = q_double / 1e10
    printf("%.10f\n", result)

    return 0
}
