# Project Euler 058
# Side length of the square spiral when the ratio of primes on both
# diagonals first falls below 10%.

function is_prime(n: i64) -> bool {
    if n < 2 { return false }
    if n < 4 { return true }
    if n % 2 == 0 || n % 3 == 0 { return false }
    let mut i: i64 = 5
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 { return false }
        i = i + 6
    }
    return true
}

function main() -> i32 {
    let mut primes: i64 = 0
    let mut total: i64 = 1  # center 1
    let mut layer: i64 = 1
    while true {
        let side: i64 = 2 * layer + 1
        let sq: i64 = side * side
        let step: i64 = side - 1
        # four corners: sq, sq-step, sq-2step, sq-3step (sq is always odd square, not prime)
        let c1: i64 = sq - step
        let c2: i64 = sq - 2 * step
        let c3: i64 = sq - 3 * step
        if is_prime(c1) { primes = primes + 1 }
        if is_prime(c2) { primes = primes + 1 }
        if is_prime(c3) { primes = primes + 1 }
        total = total + 4
        if primes * 10 < total {
            printf("%lld\n", side)
            return 0
        }
        layer = layer + 1
    }
    return 0
}
