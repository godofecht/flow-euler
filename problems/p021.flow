# Project Euler 021
# Sum of amicable numbers under 10000.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function main() -> i32 {
    let limit: i64 = 10000
    let sumdiv: ptr<i64> = calloc(limit, 8)
    if sumdiv == null {
        return 1
    }

    for i in 1..limit {
        let mut j: i64 = 2 * i
        while j < limit {
            sumdiv[j] = sumdiv[j] + i
            j = j + i
        }
    }

    let mut total: i64 = 0
    for i in 2..limit {
        let b: i64 = sumdiv[i]
        if b > i && b < limit && sumdiv[b] == i {
            total = total + i + b
        } elif b >= limit {
            # need sum of divisors of b if b is outside table
            let mut sb: i64 = 1
            let mut d: i64 = 2
            while d * d <= b {
                if b % d == 0 {
                    sb = sb + d
                    if d * d != b {
                        sb = sb + b / d
                    }
                }
                d = d + 1
            }
            if sb == i {
                total = total + i
            }
        }
    }

    printf("%lld\n", total)
    free(sumdiv)
    return 0
}
