# Project Euler 543
# Prime-Sum Numbers — sum S(F_r) for r=3..44 via Lehmer pi.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

const CAP: i64 = 1048576
const SIEVE_LIM: i64 = 5000000

function isqrt(n: i64) -> i64 {
    if n <= 0 { return 0 }
    let mut x: i64 = n
    let mut y: i64 = (x + 1) / 2
    while y < x {
        x = y
        y = (x + n / x) / 2
    }
    return x
}

function hslot(key: i64, keys: ptr<i64>, used: ptr<i8>) -> i64 {
    let mut h: i64 = key % CAP
    if h < 0 { h = h + CAP }
    while used[h] == 1 && keys[h] != key {
        h = h + 1
        if h == CAP { h = 0 }
    }
    return h
}

function phi_lehmer(n: i64, a: i64, gk: ptr<i64>, gv: ptr<i64>, gu: ptr<i8>,
                    pk: ptr<i64>, pv: ptr<i64>, pu: ptr<i8>, primes: ptr<i64>, np: i64) -> i64

function pi_lehmer(x: i64, gk: ptr<i64>, gv: ptr<i64>, gu: ptr<i8>,
                    pk: ptr<i64>, pv: ptr<i64>, pu: ptr<i8>,
                    primes: ptr<i64>, np: i64, pi_arr: ptr<i64>, lim: i64) -> i64 {
    if x <= lim {
        return pi_arr[x]
    }
    let s: i64 = hslot(x, pk, pu)
    if pu[s] == 1 { return pv[s] }
    let a: i64 = pi_lehmer(isqrt(isqrt(x)), gk, gv, gu, pk, pv, pu, primes, np, pi_arr, lim)
    let b: i64 = pi_lehmer(isqrt(x), gk, gv, gu, pk, pv, pu, primes, np, pi_arr, lim)
    let c: i64 = pi_lehmer(isqrt(isqrt(isqrt(x))), gk, gv, gu, pk, pv, pu, primes, np, pi_arr, lim)
    let mut result: i64 = phi_lehmer(x, a, gk, gv, gu, pk, pv, pu, primes, np)
    result = result + ((b + a - 2) * (b - a + 1)) / 2
    let mut i: i64 = a + 1
    while i <= b {
        let w: i64 = x / primes[i - 1]
        result = result - pi_lehmer(w, gk, gv, gu, pk, pv, pu, primes, np, pi_arr, lim)
        if i <= c {
            let bi: i64 = pi_lehmer(isqrt(w), gk, gv, gu, pk, pv, pu, primes, np, pi_arr, lim)
            let mut j: i64 = i
            while j <= bi {
                result = result - pi_lehmer(w / primes[j - 1], gk, gv, gu, pk, pv, pu, primes, np, pi_arr, lim) - j + 1
                j = j + 1
            }
        }
        i = i + 1
    }
    pu[s] = 1
    pk[s] = x
    pv[s] = result
    return result
}

function phi_lehmer(n: i64, a: i64, gk: ptr<i64>, gv: ptr<i64>, gu: ptr<i8>,
                    pk: ptr<i64>, pv: ptr<i64>, pu: ptr<i8>, primes: ptr<i64>, np: i64) -> i64 {
    if n <= 0 { return 0 }
    let key: i64 = n * 1000000 + a
    let s: i64 = hslot(key, gk, gu)
    if gu[s] == 1 { return gv[s] }
    let mut result: i64 = 0
    if a == 0 {
        result = n
    } elif a == 1 {
        result = n - n / 2
    } else {
        result = phi_lehmer(n, a - 1, gk, gv, gu, pk, pv, pu, primes, np)
            - phi_lehmer(n / primes[a - 1], a - 1, gk, gv, gu, pk, pv, pu, primes, np)
    }
    gu[s] = 1
    gk[s] = key
    gv[s] = result
    return result
}

function primePi(x: i64, gk: ptr<i64>, gv: ptr<i64>, gu: ptr<i8>,
                 pk: ptr<i64>, pv: ptr<i64>, pu: ptr<i8>,
                 primes: ptr<i64>, np: i64, pi_arr: ptr<i64>, lim: i64) -> i64 {
    if x <= 0 { return 0 }
    return pi_lehmer(x, gk, gv, gu, pk, pv, pu, primes, np, pi_arr, lim)
}

function S(n: i64, gk: ptr<i64>, gv: ptr<i64>, gu: ptr<i8>,
           pk: ptr<i64>, pv: ptr<i64>, pu: ptr<i8>,
           primes: ptr<i64>, np: i64, pi_arr: ptr<i64>, lim: i64) -> i64 {
    let mut res: i64 = primePi(n, gk, gv, gu, pk, pv, pu, primes, np, pi_arr, lim)
    if n >= 4 {
        res = res + n / 2 - 1
        res = res + primePi(n - 2, gk, gv, gu, pk, pv, pu, primes, np, pi_arr, lim) - 1
    }
    if n >= 6 {
        let half: i64 = n / 2
        res = res + (half - 2) * (n + 1) - (half + 1) * half + 6
    }
    return res
}

function fib(n: i64) -> i64 {
    let mut v1: i128 = 1 as i128
    let mut v2: i128 = 1 as i128
    let mut v3: i128 = 0 as i128
    let mut bit: i64 = 1
    while (bit << 1) <= n { bit = bit << 1 }
    bit = bit >> 1
    while bit > 0 {
        let calc: i128 = v2 * v2
        let nv1: i128 = v1 * v1 + calc
        let nv2: i128 = (v1 + v3) * v2
        let nv3: i128 = calc + v3 * v3
        v1 = nv1
        v2 = nv2
        v3 = nv3
        if (n & bit) != 0 {
            v1 = v1 + v2
            v3 = v2
            v2 = v1 - v2
        }
        bit = bit >> 1
    }
    return v2 as i64
}

function main() -> i32 {
    let sieve: ptr<i8> = calloc(SIEVE_LIM + 1, 1)
    if sieve == null { return 1 }
    let mut i: i64 = 2
    while i <= SIEVE_LIM {
        sieve[i] = 1
        i = i + 1
    }
    i = 2
    while i * i <= SIEVE_LIM {
        if sieve[i] == 1 {
            let mut j: i64 = i * i
            while j <= SIEVE_LIM {
                sieve[j] = 0
                j = j + i
            }
        }
        i = i + 1
    }
    let primes: ptr<i64> = calloc(400000, 8)
    let pi_arr: ptr<i64> = calloc(SIEVE_LIM + 1, 8)
    if primes == null || pi_arr == null { free(sieve); return 1 }
    let mut np: i64 = 0
    i = 2
    while i <= SIEVE_LIM {
        if sieve[i] == 1 {
            primes[np] = i
            np = np + 1
        }
        i = i + 1
    }
    let mut cnt: i64 = 0
    i = 1
    while i <= SIEVE_LIM {
        while cnt < np && primes[cnt] <= i { cnt = cnt + 1 }
        pi_arr[i] = cnt
        i = i + 1
    }
    let lim: i64 = isqrt(SIEVE_LIM)
    let gk: ptr<i64> = calloc(CAP, 8)
    let gv: ptr<i64> = calloc(CAP, 8)
    let gu: ptr<i8> = calloc(CAP, 1)
    let pk: ptr<i64> = calloc(CAP, 8)
    let pv: ptr<i64> = calloc(CAP, 8)
    let pu: ptr<i8> = calloc(CAP, 1)
    if gk == null || gv == null || gu == null || pk == null || pv == null || pu == null {
        free(sieve); free(primes); free(pi_arr)
        return 1
    }
    let mut total: i64 = 0
    let mut r: i64 = 3
    while r <= 44 {
        let fn: i64 = fib(r)
        total = total + S(fn, gk, gv, gu, pk, pv, pu, primes, np, pi_arr, lim)
        r = r + 1
    }
    printf("%lld\n", total)
    free(sieve); free(primes); free(pi_arr)
    free(gk); free(gv); free(gu); free(pk); free(pv); free(pu)
    return 0
}
