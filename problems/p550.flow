# Project Euler 550
# Divisor Game — Grundy by Omega + FWHT XOR power.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

const MOD: i64 = 987654321

function modpow(base0: i64, exp0: i64, mod: i64) -> i64 {
    let mut result: i64 = 1
    let mut base: i64 = base0 % mod
    let mut exp: i64 = exp0
    while exp > 0 {
        if (exp & 1) != 0 {
            result = ((result as i128) * (base as i128) % (mod as i128)) as i64
        }
        base = ((base as i128) * (base as i128) % (mod as i128)) as i64
        exp = exp >> 1
    }
    return result
}

function fwht(a: ptr<i64>, n: i64) -> void {
    let mut h: i64 = 1
    while h < n {
        let step: i64 = h << 1
        let mut i: i64 = 0
        while i < n {
            let mut j: i64 = i
            while j < i + h {
                let x: i64 = a[j]
                let y: i64 = a[j + h]
                let mut s: i64 = x + y
                if s >= MOD { s = s - MOD }
                let mut d: i64 = x - y
                if d < 0 { d = d + MOD }
                a[j] = s
                a[j + h] = d
                j = j + 1
            }
            i = i + step
        }
        h = step
    }
}

function compute_h(max_om: i64, h: ptr<i64>) -> i64 {
    h[1] = 0
    let mut max_g: i64 = 0
    let mut t: i64 = 2
    while t <= max_om {
        let mut mex: i64 = 0
        let mut found: i32 = 0
        while found == 0 {
            found = 1
            let mut i: i64 = 1
            while i < t {
                let mut j: i64 = 1
                while j < t {
                    if (h[i] ^ h[j]) == mex {
                        found = 0
                        break
                    }
                    j = j + 1
                }
                if found == 0 { break }
                i = i + 1
            }
            if found == 0 { mex = mex + 1 }
        }
        h[t] = mex
        if mex > max_g { max_g = mex }
        t = t + 1
    }
    return max_g
}

function f(n: i64, k: i64) -> i64 {
    let spf: ptr<i32> = calloc(n + 1, 4)
    let omega: ptr<i8> = calloc(n + 1, 1)
    let primes: ptr<i32> = calloc(700000, 4)
    let counts: ptr<i64> = calloc(32, 8)
    if spf == null || omega == null || primes == null || counts == null {
        if spf != null { free(spf) }
        if omega != null { free(omega) }
        if primes != null { free(primes) }
        if counts != null { free(counts) }
        return 0
    }
    let mut np: i64 = 0
    let mut max_om: i64 = 0
    let mut i: i64 = 2
    while i <= n {
        if spf[i] == 0 {
            spf[i] = i as i32
            primes[np] = i as i32
            np = np + 1
            omega[i] = 1
            counts[1] = counts[1] + 1
            max_om = 1
        } else {
            let oi: i64 = omega[i] as i64
            counts[oi] = counts[oi] + 1
            if oi > max_om { max_om = oi }
        }
        let mut j: i64 = 0
        while j < np {
            let p: i64 = primes[j] as i64
            let ip: i64 = i * p
            if ip > n { break }
            spf[ip] = p as i32
            if p == spf[i] as i64 {
                omega[ip] = (omega[i] as i64 + 1) as i8
            } else {
                omega[ip] = 1
            }
            if p == spf[i] as i64 { break }
            j = j + 1
        }
        i = i + 1
    }
    let h: ptr<i64> = calloc(32, 8)
    if h == null {
        free(spf); free(omega); free(primes); free(counts)
        return 0
    }
    let max_g: i64 = compute_h(max_om, h)
    let mut size: i64 = 1
    while size <= max_g {
        size = size << 1
    }
    let freq: ptr<i64> = calloc(size, 8)
    if freq == null {
        free(h); free(spf); free(omega); free(primes); free(counts)
        return 0
    }
    let mut t: i64 = 1
    while t <= max_om {
        freq[h[t]] = (freq[h[t]] + counts[t]) % MOD
        t = t + 1
    }
    fwht(freq, size)
    let mut losing: i64 = 0
    let mut idx: i64 = 0
    while idx < size {
        losing = (losing + modpow(freq[idx], k, MOD)) % MOD
        idx = idx + 1
    }
    losing = (losing * modpow(size, MOD - 2, MOD)) % MOD
    let total: i64 = modpow(n - 1, k, MOD)
    let mut ans: i64 = (total - losing) % MOD
    if ans < 0 { ans = ans + MOD }
    free(freq); free(h); free(spf); free(omega); free(primes); free(counts)
    return ans
}

function main() -> i32 {
    printf("%lld\n", f(10000000, 1000000000000))
    return 0
}
