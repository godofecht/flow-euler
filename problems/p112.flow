# Project Euler 112
# Least n such that the proportion of bouncy numbers is exactly 99%.

function is_bouncy(n0: i64) -> bool {
    let mut n: i64 = n0
    let mut prev: i64 = n % 10
    n = n / 10
    let mut inc: bool = false
    let mut dec: bool = false
    while n > 0 {
        let d: i64 = n % 10
        if d < prev { inc = true }
        if d > prev { dec = true }
        if inc && dec { return true }
        prev = d
        n = n / 10
    }
    return false
}

function main() -> i32 {
    let mut bouncy: i64 = 0
    let mut n: i64 = 1
    while true {
        if is_bouncy(n) {
            bouncy = bouncy + 1
        }
        if n > 100 && bouncy * 100 == n * 99 {
            printf("%lld\n", n)
            return 0
        }
        n = n + 1
        if n > 10000000 {
            printf("0\n")
            return 1
        }
    }
    return 0
}
