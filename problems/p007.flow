# Project Euler 007
# The 10001st prime number.

function is_prime(n: i64) -> bool {
    if n < 2 {
        return false
    }
    if n < 4 {
        return true
    }
    if n % 2 == 0 || n % 3 == 0 {
        return false
    }
    let mut i: i64 = 5
    while i * i <= n {
        if n % i == 0 || n % (i + 2) == 0 {
            return false
        }
        i = i + 6
    }
    return true
}

function nth_prime(n: i64) -> i64 {
    let mut count: i64 = 0
    let mut candidate: i64 = 1
    while count < n {
        candidate = candidate + 1
        if is_prime(candidate) {
            count = count + 1
        }
    }
    return candidate
}

function main() -> i32 {
    printf("%lld\n", nth_prime(10001))
    return 0
}
