# Project Euler 007
# The 10001st prime number.

import euler.nt { is_prime }

function nth_prime(n: i64) -> i64 {
    let mut count: i64 = 0
    let mut candidate: i64 = 1
    while count < n {
        candidate = candidate + 1
        if is_prime(candidate) {
            count = count + 1
        }
    }
    return candidate
}

function main() -> i32 {
    printf("%lld\n", nth_prime(10001))
    return 0
}
