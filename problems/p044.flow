# Project Euler 044
# Minimize |Pj − Pk| for pentagonal numbers where Pj+Pk and |Pj−Pk|
# are also pentagonal.

import euler.nt { isqrt }

function is_pent(x: i64) -> bool {
    let target: i64 = 24 * x + 1
    let s: i64 = isqrt(target)
    if s * s != target { return false }
    return (s + 1) % 6 == 0
}

function pent(n: i64) -> i64 {
    return n * (3 * n - 1) / 2
}

function main() -> i32 {
    let mut best: i64 = 0
    let mut found: bool = false
    for k in 2..3000 {
        if found { break }
        let pk: i64 = pent(k)
        for j in 1..k {
            let pj: i64 = pent(j)
            let diff: i64 = pk - pj
            let sum: i64 = pk + pj
            if is_pent(diff) && is_pent(sum) {
                best = diff
                found = true
                break
            }
        }
    }
    printf("%lld\n", best)
    return 0
}
