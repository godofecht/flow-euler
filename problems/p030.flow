# Project Euler 030
# Sum of all numbers that can be written as the sum of fifth powers of their digits.

function pow5(d: i64) -> i64 {
    return d * d * d * d * d
}

function digit_fifth_sum(n0: i64) -> i64 {
    let mut n: i64 = n0
    let mut s: i64 = 0
    while n > 0 {
        s = s + pow5(n % 10)
        n = n / 10
    }
    return s
}

function main() -> i32 {
    # Upper bound: 6*9^5 = 354294; 7 digits can't reach themselves
    let mut total: i64 = 0
    for n in 2..354295 {
        if digit_fifth_sum(n) == n {
            total = total + n
        }
    }
    printf("%lld\n", total)
    return 0
}
