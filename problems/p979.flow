# Project Euler 979
# Hyperbolic frog on {7,3} heptagon tiling.
# Count length-20 closed walks on the adjacency graph.
# Port of the C reference solver to pure Flow.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function memset(p: ptr<void>, c: i64, n: i64) -> ptr<void>
}

const MAXLAYERS: i64 = 11
const MAXNODES: i64 = 120000
const MAXDEG: i64 = 8
const LWIDTH: i64 = 80000

# flat arrays: types[MAXLAYERS][LWIDTH], parent1, parent2
let mut g_types: ptr<i64> = null
let mut g_type_len: ptr<i64> = null
let mut g_parent1: ptr<i64> = null
let mut g_parent2: ptr<i64> = null
let mut g_offsets: ptr<i64> = null
let mut g_adj: ptr<i64> = null
let mut g_deg: ptr<i64> = null

function tidx(layer: i64, j: i64) -> i64 {
    return layer * LWIDTH + j
}

function aidx(u: i64, d: i64) -> i64 {
    return u * MAXDEG + d
}

function build_layers(max_layer: i64) -> void {
    g_types[tidx(0, 0)] = 0
    g_type_len[0] = 1

    if max_layer == 0 { return }

    let mut i: i64 = 0
    while i < 7 {
        g_types[tidx(1, i)] = 0
        g_parent1[tidx(1, i)] = 0
        g_parent2[tidx(1, i)] = -1
        i = i + 1
    }
    g_type_len[1] = 7

    let mut k: i64 = 2
    while k <= max_layer {
        let m: i64 = g_type_len[k - 1]
        let mut cur_idx: i64 = 0
        let mut j: i64 = 0
        while j < m {
            let t: i64 = g_types[tidx(k - 1, j)]
            if t == 0 {
                # I -> I I II
                g_types[tidx(k, cur_idx)] = 0
                g_parent1[tidx(k, cur_idx)] = j
                g_parent2[tidx(k, cur_idx)] = -1
                cur_idx = cur_idx + 1
                g_types[tidx(k, cur_idx)] = 0
                g_parent1[tidx(k, cur_idx)] = j
                g_parent2[tidx(k, cur_idx)] = -1
                cur_idx = cur_idx + 1
                g_types[tidx(k, cur_idx)] = 1
                g_parent1[tidx(k, cur_idx)] = j
                g_parent2[tidx(k, cur_idx)] = (j + 1) % m
                cur_idx = cur_idx + 1
            } else {
                # II -> I II
                g_types[tidx(k, cur_idx)] = 0
                g_parent1[tidx(k, cur_idx)] = j
                g_parent2[tidx(k, cur_idx)] = -1
                cur_idx = cur_idx + 1
                g_types[tidx(k, cur_idx)] = 1
                g_parent1[tidx(k, cur_idx)] = j
                g_parent2[tidx(k, cur_idx)] = (j + 1) % m
                cur_idx = cur_idx + 1
            }
            j = j + 1
        }
        g_type_len[k] = cur_idx
        k = k + 1
    }
}

function add_edge(u: i64, v: i64) -> void {
    g_adj[aidx(u, g_deg[u])] = v
    g_deg[u] = g_deg[u] + 1
    g_adj[aidx(v, g_deg[v])] = u
    g_deg[v] = g_deg[v] + 1
}

function build_adjacency(max_layer: i64) -> void {
    memset(g_deg as ptr<void>, 0, MAXNODES * 8)

    let mut total_nodes: i64 = 0
    let mut k: i64 = 0
    while k <= max_layer {
        g_offsets[k] = total_nodes
        total_nodes = total_nodes + g_type_len[k]
        k = k + 1
    }

    let origin: i64 = g_offsets[0]

    k = 1
    while k <= max_layer {
        let off: i64 = g_offsets[k]
        let m: i64 = g_type_len[k]
        let mut i: i64 = 0
        while i < m {
            add_edge(off + i, off + (i + 1) % m)
            i = i + 1
        }
        k = k + 1
    }

    if max_layer >= 1 {
        let off1: i64 = g_offsets[1]
        let mut i: i64 = 0
        while i < g_type_len[1] {
            add_edge(origin, off1 + i)
            i = i + 1
        }
    }

    k = 2
    while k <= max_layer {
        let off: i64 = g_offsets[k]
        let poff: i64 = g_offsets[k - 1]
        let mut i: i64 = 0
        while i < g_type_len[k] {
            add_edge(off + i, poff + g_parent1[tidx(k, i)])
            let p: i64 = g_parent2[tidx(k, i)]
            if p != -1 {
                add_edge(off + i, poff + p)
            }
            i = i + 1
        }
        k = k + 1
    }
}

function main() -> i32 {
    g_types = calloc(MAXLAYERS * LWIDTH, 8) as ptr<i64>
    g_type_len = calloc(MAXLAYERS, 8) as ptr<i64>
    g_parent1 = calloc(MAXLAYERS * LWIDTH, 8) as ptr<i64>
    g_parent2 = calloc(MAXLAYERS * LWIDTH, 8) as ptr<i64>
    g_offsets = calloc(MAXLAYERS, 8) as ptr<i64>
    g_adj = calloc(MAXNODES * MAXDEG, 8) as ptr<i64>
    g_deg = calloc(MAXNODES, 8) as ptr<i64>

    let n: i64 = 20
    if n == 0 {
        printf("%lld\n", 1)
        return 0
    }

    let max_layer: i64 = n / 2
    build_layers(max_layer)
    build_adjacency(max_layer)

    let mut N: i64 = 0
    let mut k: i64 = 0
    while k <= max_layer {
        N = N + g_type_len[k]
        k = k + 1
    }
    let origin: i64 = g_offsets[0]

    let dp: ptr<i64> = calloc(N, 8)
    let ndp: ptr<i64> = calloc(N, 8)
    dp[origin] = 1

    let mut step: i64 = 0
    let mut cur_dp: ptr<i64> = dp
    let mut cur_ndp: ptr<i64> = ndp
    while step < n {
        memset(cur_ndp as ptr<void>, 0, N * 8)
        let mut u: i64 = 0
        while u < N {
            if cur_dp[u] != 0 {
                let mut di: i64 = 0
                while di < g_deg[u] {
                    cur_ndp[g_adj[aidx(u, di)]] = cur_ndp[g_adj[aidx(u, di)]] + cur_dp[u]
                    di = di + 1
                }
            }
            u = u + 1
        }
        let tmp: ptr<i64> = cur_dp
        cur_dp = cur_ndp
        cur_ndp = tmp
        step = step + 1
    }

    printf("%lld\n", cur_dp[origin])
    return 0
}
