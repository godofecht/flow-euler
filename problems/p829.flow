# Project Euler 829
# Integral Fusion - sum_{n=2..31} M(n) where M(n) is smallest integer whose
# factor tree has the same shape as T(n!!).
# Uses Miller-Rabin, Pollard rho, shape trees, and min-heap sequence generation.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function malloc(n: i64) -> ptr<void>
    function realloc(p: ptr<void>, n: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function sqrt(x: f64) -> f64
}

struct Factor {
    p: u64,
    e: i32
}

# Pre-allocated global buffers to avoid millions of per-call malloc/free.
let mut g_sp: ptr<u64> = null
let mut g_bases: ptr<u64> = null
let mut g_cvals: ptr<u64> = null
let mut g_fac: ptr<Factor> = null
let mut g_fstack: ptr<u64> = null
let mut g_val_ptr: ptr<u64> = null
let mut g_data_ptr: ptr<i32> = null
let mut g_best_d: i64 = 0

# ---- Miller-Rabin ----

function mulmod_u64(a: u64, b: u64, m: u64) -> u64 {
    return ((a as i128 * b as i128) % (m as i128)) as u64
}

function powmod_u64(a0: u64, d0: u64, n: u64) -> u64 {
    let mut r: u64 = 1
    let mut a: u64 = a0 % n
    let mut d: u64 = d0
    while d != 0 {
        if d % 2 == 1 { r = mulmod_u64(r, a, n) }
        a = mulmod_u64(a, a, n)
        d = d >> 1
    }
    return r
}

function is_prime_u64(n: u64) -> bool {
    if n < 2 { return false }
    let mut i: i32 = 0
    while i < 12 {
        if n == g_sp[i] { return true }
        if n % g_sp[i] == 0 { return false }
        i = i + 1
    }
    let mut d: u64 = n - 1
    let mut s: i32 = 0
    while d % 2 == 0 { d = d / 2; s = s + 1 }
    let mut bi: i32 = 0
    while bi < 7 {
        let a: u64 = g_bases[bi] % n
        if a == 0 { bi = bi + 1; continue }
        let mut x: u64 = powmod_u64(a, d, n)
        if x == 1 || x == n - 1 { bi = bi + 1; continue }
        let mut found: bool = false
        let mut j: i32 = 0
        while j < s - 1 {
            x = mulmod_u64(x, x, n)
            if x == n - 1 { found = true; break }
            j = j + 1
        }
        if !found { return false }
        bi = bi + 1
    }
    return true
}

function gcd_u64(a0: u64, b0: u64) -> u64 {
    let mut a: u64 = a0
    let mut b: u64 = b0
    while b != 0 {
        let t: u64 = a % b
        a = b
        b = t
    }
    return a
}

function pollard_rho_u64(n: u64) -> u64 {
    if n % 2 == 0 { return 2 }
    if n % 3 == 0 { return 3 }
    let mut ci: i32 = 0
    while ci < 9 {
        let c: u64 = g_cvals[ci]
        let mut y: u64 = 2
        let mut x: u64 = 0
        let mut ys: u64 = 0
        let mut g: u64 = 1
        let mut q: u64 = 1
        let mut r: u64 = 1
        let m: u64 = 128
        while g == 1 {
            x = y
            let mut i2: u64 = 0
            while i2 < r {
                y = (mulmod_u64(y, y, n) + c) % n
                i2 = i2 + 1
            }
            let mut k: u64 = 0
            while k < r && g == 1 {
                ys = y
                let lim: u64 = if m < r - k { m } else { r - k }
                let mut i3: u64 = 0
                while i3 < lim {
                    y = (mulmod_u64(y, y, n) + c) % n
                    let diff: u64 = if x > y { x - y } else { y - x }
                    q = mulmod_u64(q, diff, n)
                    i3 = i3 + 1
                }
                g = gcd_u64(q, n)
                k = k + m
            }
            r = r << 1
        }
        if g == n {
            g = 1
            y = ys
            while g == 1 {
                y = (mulmod_u64(y, y, n) + c) % n
                let diff: u64 = if x > y { x - y } else { y - x }
                g = gcd_u64(diff, n)
            }
        }
        if 1 < g && g < n {
            return g
        }
        ci = ci + 1
    }
    let mut d: u64 = 5
    while d <= 1000000 && d * d <= n {
        if n % d == 0 { return d }
        d = d + 2
    }
    return n
}

function factorize_u64(n0: u64, out: ptr<Factor>) -> i32 {
    let mut n: u64 = n0
    let mut nf: i32 = 0
    let mut i: i32 = 0
    while i < 12 {
        if n % g_sp[i] == 0 {
            let mut e: i32 = 0
            while n % g_sp[i] == 0 { n = n / g_sp[i]; e = e + 1 }
            out[nf].p = g_sp[i]
            out[nf].e = e
            nf = nf + 1
        }
        i = i + 1
    }
    let mut sp2: i32 = 0
    if n > 1 { g_fstack[sp2] = n; sp2 = sp2 + 1 }
    while sp2 > 0 {
        sp2 = sp2 - 1
        let m: u64 = g_fstack[sp2]
        if m == 1 { continue }
        if is_prime_u64(m) {
            let mut found: bool = false
            let mut i2: i32 = 0
            while i2 < nf {
                if out[i2].p == m { out[i2].e = out[i2].e + 1; found = true; break }
                i2 = i2 + 1
            }
            if !found { out[nf].p = m; out[nf].e = 1; nf = nf + 1 }
            continue
        }
        let d: u64 = pollard_rho_u64(m)
        if d == m {
            let mut found: bool = false
            let mut i3: i32 = 0
            while i3 < nf {
                if out[i3].p == m { out[i3].e = out[i3].e + 1; found = true; break }
                i3 = i3 + 1
            }
            if !found { out[nf].p = m; out[nf].e = 1; nf = nf + 1 }
            continue
        }
        g_fstack[sp2] = d; sp2 = sp2 + 1
        g_fstack[sp2] = m / d; sp2 = sp2 + 1
    }
    return nf
}

function isqrt_u64(n: u64) -> u64 {
    if n == 0 { return 0 }
    let r: u64 = sqrt(n as f64) as u64
    while r > 0 && r * r > n { r = r - 1 }
    while (r + 1) * (r + 1) <= n { r = r + 1 }
    return r
}

# Branch-and-bound DFS: find the largest divisor of n that is <= sqrt(n),
# without generating all divisors.  Prunes when the current partial divisor
# times the remaining prime-power product cannot beat the best found so far.
# cur * max_rem <= n always holds, so no u64 overflow.
function best_dfs(idx: i32, cur: u64, root: u64, nf: i32, max_rem: u64) -> void {
    if cur > (g_best_d as u64) { g_best_d = cur as i64 }
    if idx >= nf { return }
    if cur * max_rem <= (g_best_d as u64) { return }
    let p: u64 = g_fac[idx].p
    let e: i32 = g_fac[idx].e
    let mut pe_full: u64 = 1
    let mut j: i32 = 0
    while j < e { pe_full = pe_full * p; j = j + 1 }
    let next_rem: u64 = max_rem / pe_full
    let mut pe: u64 = pe_full
    let mut k: i32 = e
    while k >= 0 {
        if cur <= root / pe {
            best_dfs(idx + 1, cur * pe, root, nf, next_rem)
        }
        pe = pe / p
        k = k - 1
    }
}

function best_divisor_le_sqrt(n: u64) -> u64 {
    let nf: i32 = factorize_u64(n, g_fac)
    # Sort factors by prime descending for tighter pruning.
    let mut i: i32 = 1
    while i < nf {
        let key_p: u64 = g_fac[i].p
        let key_e: i32 = g_fac[i].e
        let mut j: i32 = i - 1
        while j >= 0 && g_fac[j].p < key_p {
            g_fac[j + 1].p = g_fac[j].p
            g_fac[j + 1].e = g_fac[j].e
            j = j - 1
        }
        g_fac[j + 1].p = key_p
        g_fac[j + 1].e = key_e
        i = i + 1
    }
    let root: u64 = isqrt_u64(n)
    g_best_d = 1
    best_dfs(0, 1, root, nf, n)
    return g_best_d as u64
}

# ---- Shape tree ----

struct ShapeNode {
    is_leaf: i32,
    left: ptr<ShapeNode>,
    right: ptr<ShapeNode>
}

let mut leaf_node: ptr<ShapeNode> = null

function new_shape(is_leaf: i32, l: ptr<ShapeNode>, r: ptr<ShapeNode>) -> ptr<ShapeNode> {
    let n: ptr<ShapeNode> = malloc(24) as ptr<ShapeNode>
    n[0].is_leaf = is_leaf
    n[0].left = l
    n[0].right = r
    return n
}

function shape_eq(a: ptr<ShapeNode>, b: ptr<ShapeNode>) -> bool {
    if a == b { return true }
    if a[0].is_leaf != b[0].is_leaf { return false }
    if a[0].is_leaf != 0 { return true }
    return shape_eq(a[0].left, b[0].left) && shape_eq(a[0].right, b[0].right)
}

struct SCacheEntry {
    key: u64,
    val: ptr<ShapeNode>
}

let mut scache: ptr<SCacheEntry> = null
let mut scache_count: i32 = 0

function get_shape(n: u64) -> ptr<ShapeNode> {
    let mut i: i32 = 0
    while i < scache_count {
        if scache[i].key == n { return scache[i].val }
        i = i + 1
    }
    let result: ptr<ShapeNode>
    if is_prime_u64(n) {
        result = leaf_node
    } else {
        let d: u64 = best_divisor_le_sqrt(n)
        let mut a: u64 = d
        let mut b: u64 = n / d
        if a > b { let t: u64 = a; a = b; b = t }
        result = new_shape(0, get_shape(a), get_shape(b))
    }
    if scache_count < 8192 {
        scache[scache_count].key = n
        scache[scache_count].val = result
        scache_count = scache_count + 1
    }
    return result
}

function count_leaves(sh: ptr<ShapeNode>) -> i32 {
    if sh[0].is_leaf != 0 { return 1 }
    return count_leaves(sh[0].left) + count_leaves(sh[0].right)
}

function shape_matches(n: u64, sh: ptr<ShapeNode>) -> bool {
    if sh[0].is_leaf != 0 { return is_prime_u64(n) }
    if is_prime_u64(n) { return false }
    let d: u64 = best_divisor_le_sqrt(n)
    let mut a: u64 = d
    let mut b: u64 = n / d
    if a > b { let t: u64 = a; a = b; b = t }
    return shape_eq(get_shape(a), sh[0].left) && shape_eq(get_shape(b), sh[0].right)
}

function next_prime(p: u64) -> u64 {
    if p < 2 { return 2 }
    if p == 2 { return 3 }
    let mut c: u64 = p + 2
    while !is_prime_u64(c) { c = c + 2 }
    return c
}

# ---- Min-heap ----

struct HeapEntry {
    val: u64,
    data: i32
}

# ---- Seq struct ----

struct Seq {
    sh: ptr<ShapeNode>,
    maxval: u64,
    next_prime_val: u64,
    left_idx: i32,
    right_idx: i32,
    heap: ptr<HeapEntry>,
    heap_size: i32,
    heap_cap: i32,
    seen_keys: ptr<i64>,
    seen_count: i32,
    seen_cap: i32,
    values: ptr<u64>,
    val_count: i32,
    val_cap: i32
}

let mut seqs: ptr<ptr<Seq> > = null
let mut seqs_count: i32 = 0

function find_seq(sh: ptr<ShapeNode>) -> ptr<Seq> {
    let mut i: i32 = 0
    while i < seqs_count {
        if seqs[i][0].sh == sh { return seqs[i] }
        i = i + 1
    }
    return null
}

# Forward declarations needed for mutual recursion
# get_value is called by ensure_right_ge, try_push, next_candidate
# next_value is called by get_value
# next_candidate is called by next_value

function hpush(s: ptr<Seq>, val: u64, data: i32) -> void {
    if s[0].heap_size >= s[0].heap_cap {
        s[0].heap_cap = s[0].heap_cap * 2
        s[0].heap = realloc(s[0].heap as ptr<void>, (s[0].heap_cap as i64) * 16) as ptr<HeapEntry>
    }
    let pos: i32 = s[0].heap_size
    s[0].heap_size = s[0].heap_size + 1
    s[0].heap[pos].val = val
    s[0].heap[pos].data = data
    let mut p: i32 = pos
    while p > 0 {
        let pp: i32 = (p - 1) / 2
        if s[0].heap[pp].val <= s[0].heap[p].val { break }
        let t: HeapEntry = s[0].heap[pp]
        s[0].heap[pp] = s[0].heap[p]
        s[0].heap[p] = t
        p = pp
    }
}

function hpop(s: ptr<Seq>, val: ptr<u64>, data: ptr<i32>) -> void {
    val[0] = s[0].heap[0].val
    data[0] = s[0].heap[0].data
    s[0].heap_size = s[0].heap_size - 1
    if s[0].heap_size > 0 {
        s[0].heap[0] = s[0].heap[s[0].heap_size]
        let mut pos: i32 = 0
        let mut cont: bool = true
        while cont {
            let l: i32 = 2 * pos + 1
            let r: i32 = 2 * pos + 2
            let mut sm: i32 = pos
            if l < s[0].heap_size && s[0].heap[l].val < s[0].heap[sm].val { sm = l }
            if r < s[0].heap_size && s[0].heap[r].val < s[0].heap[sm].val { sm = r }
            if sm == pos {
                cont = false
            } else {
                let t: HeapEntry = s[0].heap[pos]
                s[0].heap[pos] = s[0].heap[sm]
                s[0].heap[sm] = t
                pos = sm
            }
        }
    }
}

# Open-addressing hash set for (i,j) pairs.  Key = i*1000000+j (>= 0).
# Stored value = key + 1 so that 0 (from calloc) means empty.
function seen_contains(s: ptr<Seq>, i: i32, j: i32) -> bool {
    let key: i64 = (i as i64) * 1000000 + (j as i64)
    let stored: i64 = key + 1
    let mask: i64 = (s[0].seen_cap as i64) - 1
    let mut h: i64 = (key ^ (key >> 16)) & mask
    while true {
        let v: i64 = s[0].seen_keys[h]
        if v == 0 { return false }
        if v == stored { return true }
        h = (h + 1) & mask
    }
    return false
}

function seen_add(s: ptr<Seq>, i: i32, j: i32) -> void {
    let key: i64 = (i as i64) * 1000000 + (j as i64)
    let stored: i64 = key + 1
    let mask: i64 = (s[0].seen_cap as i64) - 1
    let mut h: i64 = (key ^ (key >> 16)) & mask
    while true {
        let v: i64 = s[0].seen_keys[h]
        if v == 0 {
            s[0].seen_keys[h] = stored
            s[0].seen_count = s[0].seen_count + 1
            if s[0].seen_count * 2 >= s[0].seen_cap {
                # Resize: rehash into a new table.
                let old_keys: ptr<i64> = s[0].seen_keys
                let old_cap: i32 = s[0].seen_cap
                s[0].seen_cap = s[0].seen_cap * 2
                s[0].seen_keys = calloc(s[0].seen_cap as i64, 8) as ptr<i64>
                s[0].seen_count = 0
                let new_mask: i64 = (s[0].seen_cap as i64) - 1
                let mut k: i32 = 0
                while k < old_cap {
                    let ov: i64 = old_keys[k]
                    if ov != 0 {
                        let ok: i64 = ov - 1
                        let mut nh: i64 = (ok ^ (ok >> 16)) & new_mask
                        while s[0].seen_keys[nh] != 0 {
                            nh = (nh + 1) & new_mask
                        }
                        s[0].seen_keys[nh] = ov
                        s[0].seen_count = s[0].seen_count + 1
                    }
                    k = k + 1
                }
                free(old_keys as ptr<void>)
            }
            return
        }
        if v == stored { return }
        h = (h + 1) & mask
    }
}

# Mutual recursion: get_value, next_value, next_candidate, ensure_right_ge, try_push

function get_value(sh: ptr<ShapeNode>, idx: i32) -> u64

function ensure_right_ge(s: ptr<Seq>, x: u64) -> i32 {
    let rs: ptr<Seq> = find_seq(s[0].sh[0].right)
    if rs == null { return -1 }
    if rs[0].val_count == 0 {
        let v: u64 = get_value(s[0].sh[0].right, 0)
        if v == 0 || v > s[0].maxval { return -1 }
    }
    while rs[0].values[rs[0].val_count - 1] < x {
        let v: u64 = get_value(s[0].sh[0].right, rs[0].val_count)
        if v == 0 || v > s[0].maxval { break }
    }
    if rs[0].values[rs[0].val_count - 1] < x { return -1 }
    let mut lo: i32 = 0
    let mut hi: i32 = rs[0].val_count - 1
    while lo < hi {
        let mid: i32 = (lo + hi) / 2
        if rs[0].values[mid] < x { lo = mid + 1 } else { hi = mid }
    }
    return lo
}

function try_push(s: ptr<Seq>, i: i32, j: i32) -> void {
    if seen_contains(s, i, j) { return }
    let a: u64 = get_value(s[0].sh[0].left, i)
    let b: u64 = get_value(s[0].sh[0].right, j)
    if a == 0 || b == 0 { return }
    if a > b { return }
    let prod: u64 = a * b
    if prod > s[0].maxval { return }
    seen_add(s, i, j)
    hpush(s, prod, i * 1000000 + j)
}

function next_candidate(s: ptr<Seq>) -> u64 {
    if s[0].left_idx == 0 && s[0].heap_size == 0 {
        let a0: u64 = get_value(s[0].sh[0].left, 0)
        if a0 == 0 { return 0 }
        let j0: i32 = ensure_right_ge(s, a0)
        if j0 >= 0 { try_push(s, 0, j0) }
        s[0].left_idx = 1
    }

    let val_ptr: ptr<u64> = g_val_ptr
    let data_ptr: ptr<i32> = g_data_ptr

    while true {
        if s[0].heap_size == 0 {
            let a: u64 = get_value(s[0].sh[0].left, s[0].left_idx)
            if a == 0 { return 0 }
            if a * a > s[0].maxval {
                return 0
            }
            let j0: i32 = ensure_right_ge(s, a)
            if j0 < 0 { return 0 }
            try_push(s, s[0].left_idx, j0)
            s[0].left_idx = s[0].left_idx + 1
            continue
        }
        hpop(s, val_ptr, data_ptr)
        let prod: u64 = val_ptr[0]
        let ij: i32 = data_ptr[0]
        let i: i32 = ij / 1000000
        let j: i32 = ij % 1000000

        # Maybe add more i values
        while true {
            let a: u64 = get_value(s[0].sh[0].left, s[0].left_idx)
            if a == 0 { break }
            if a * a > prod && s[0].heap_size > 0 { break }
            let j0: i32 = ensure_right_ge(s, a)
            if j0 >= 0 { try_push(s, s[0].left_idx, j0) }
            s[0].left_idx = s[0].left_idx + 1
        }

        try_push(s, i, j + 1)
        return prod
    }
    return 0
}

function next_value(s: ptr<Seq>) -> u64 {
    if s[0].sh[0].is_leaf != 0 {
        let p: u64 = s[0].next_prime_val
        if p > s[0].maxval { return 0 }
        s[0].next_prime_val = next_prime(p)
        return p
    }
    let last: u64 = if s[0].val_count > 0 { s[0].values[s[0].val_count - 1] } else { 0 }
    while true {
        let cand: u64 = next_candidate(s)
        if cand == 0 { return 0 }
        if last != 0 && cand == last { continue }
        if shape_matches(cand, s[0].sh) { return cand }
    }
    return 0
}

function get_value(sh: ptr<ShapeNode>, idx: i32) -> u64 {
    let s: ptr<Seq> = find_seq(sh)
    if s == null { return 0 }
    while s[0].val_count <= idx {
        let v: u64 = next_value(s)
        if v == 0 { return 0 }
        if s[0].val_count >= s[0].val_cap {
            s[0].val_cap = s[0].val_cap * 2
            s[0].values = realloc(s[0].values as ptr<void>, (s[0].val_cap as i64) * 8) as ptr<u64>
        }
        s[0].values[s[0].val_count] = v
        s[0].val_count = s[0].val_count + 1
    }
    return s[0].values[idx]
}

# Collect all unique subshapes
let mut all_shapes_arr: ptr<ptr<ShapeNode> > = null
let mut all_shapes_arr_count: i32 = 0
let mut all_shapes_arr_cap: i32 = 0

function collect_shape(sh: ptr<ShapeNode>) -> void {
    let mut i: i32 = 0
    while i < all_shapes_arr_count {
        if all_shapes_arr[i] == sh { return }
        i = i + 1
    }
    if all_shapes_arr_count >= all_shapes_arr_cap {
        if all_shapes_arr_cap == 0 { all_shapes_arr_cap = 64 } else { all_shapes_arr_cap = all_shapes_arr_cap * 2 }
        all_shapes_arr = realloc(all_shapes_arr as ptr<void>, (all_shapes_arr_cap as i64) * 8) as ptr<ptr<ShapeNode> >
    }
    all_shapes_arr[all_shapes_arr_count] = sh
    all_shapes_arr_count = all_shapes_arr_count + 1
    if sh[0].is_leaf == 0 {
        collect_shape(sh[0].left)
        collect_shape(sh[0].right)
    }
}

function double_factorial(n: i32) -> u64 {
    let mut r: u64 = 1
    let mut k: i32 = n
    while k > 1 {
        r = r * (k as u64)
        k = k - 2
    }
    return r
}

function main() -> i32 {
    leaf_node = new_shape(1, null, null)

    # Initialize pre-allocated global buffers.
    g_sp = calloc(12, 8) as ptr<u64>
    g_sp[0]=2; g_sp[1]=3; g_sp[2]=5; g_sp[3]=7; g_sp[4]=11; g_sp[5]=13
    g_sp[6]=17; g_sp[7]=19; g_sp[8]=23; g_sp[9]=29; g_sp[10]=31; g_sp[11]=37
    g_bases = calloc(7, 8) as ptr<u64>
    g_bases[0]=2; g_bases[1]=325; g_bases[2]=9375; g_bases[3]=28178
    g_bases[4]=450775; g_bases[5]=9780504; g_bases[6]=1795265022
    g_cvals = calloc(9, 8) as ptr<u64>
    g_cvals[0]=1; g_cvals[1]=3; g_cvals[2]=5; g_cvals[3]=7; g_cvals[4]=11
    g_cvals[5]=13; g_cvals[6]=17; g_cvals[7]=19; g_cvals[8]=23
    g_fac = calloc(20, 16) as ptr<Factor>
    g_fstack = calloc(64, 8) as ptr<u64>
    g_val_ptr = calloc(1, 8) as ptr<u64>
    g_data_ptr = calloc(1, 4) as ptr<i32>

    let max_n: i32 = 31
    let maxval: u64 = double_factorial(max_n)

    # Shape cache
    scache = calloc(8192, 16) as ptr<SCacheEntry>
    scache_count = 0

    let targets: ptr<ptr<ShapeNode> > = calloc(32, 8) as ptr<ptr<ShapeNode> >
    let mut n: i32 = 2
    while n <= max_n {
        targets[n] = get_shape(double_factorial(n))
        n = n + 1
    }

    all_shapes_arr = null
    all_shapes_arr_count = 0
    all_shapes_arr_cap = 0
    n = 2
    while n <= max_n {
        collect_shape(targets[n])
        n = n + 1
    }

    # Sort by leaf count (insertion sort)
    let mut i: i32 = 1
    while i < all_shapes_arr_count {
        let key: ptr<ShapeNode> = all_shapes_arr[i]
        let mut j: i32 = i - 1
        while j >= 0 && count_leaves(all_shapes_arr[j]) > count_leaves(key) {
            all_shapes_arr[j + 1] = all_shapes_arr[j]
            j = j - 1
        }
        all_shapes_arr[j + 1] = key
        i = i + 1
    }

    # Create sequences
    seqs = malloc((all_shapes_arr_count as i64) * 8) as ptr<ptr<Seq> >
    seqs_count = 0
    i = 0
    while i < all_shapes_arr_count {
        let s: ptr<Seq> = calloc(1, 80) as ptr<Seq>
        s[0].sh = all_shapes_arr[i]
        s[0].maxval = maxval
        s[0].next_prime_val = 2
        s[0].left_idx = 0
        s[0].heap_cap = 4096
        s[0].heap = malloc((s[0].heap_cap as i64) * 16) as ptr<HeapEntry>
        s[0].heap_size = 0
        s[0].seen_cap = 256
        s[0].seen_keys = calloc(s[0].seen_cap as i64, 8) as ptr<i64>
        s[0].seen_count = 0
        s[0].val_cap = 256
        s[0].values = malloc((s[0].val_cap as i64) * 8) as ptr<u64>
        s[0].val_count = 0
        seqs[seqs_count] = s
        seqs_count = seqs_count + 1
        i = i + 1
    }

    let mut total: u64 = 0
    n = 2
    while n <= max_n {
        let m: u64 = get_value(targets[n], 0)
        total = total + m
        n = n + 1
    }

    printf("%lld\n", total as i64)
    return 0
}
