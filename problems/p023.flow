# Project Euler 023
# Sum of all positive integers which cannot be written as the sum of two
# abundant numbers.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
}

function main() -> i32 {
    let limit: i32 = 28123
    let sumdiv: ptr<i32> = calloc((limit + 1) as i64, 4)
    if sumdiv == null {
        return 1
    }

    let mut i: i32 = 1
    while i <= limit {
        let mut j: i32 = 2 * i
        while j <= limit {
            sumdiv[j] = sumdiv[j] + i
            j = j + i
        }
        i = i + 1
    }

    let abundant: ptr<i32> = calloc((limit + 1) as i64, 4)
    let mut acount: i32 = 0
    i = 1
    while i <= limit {
        if sumdiv[i] > i {
            abundant[acount] = i
            acount = acount + 1
        }
        i = i + 1
    }

    let can: ptr<i8> = calloc((limit + 1) as i64, 1)
    let mut a: i32 = 0
    while a < acount {
        let mut b: i32 = a
        while b < acount {
            let s: i32 = abundant[a] + abundant[b]
            if s > limit {
                break
            }
            can[s] = 1
            b = b + 1
        }
        a = a + 1
    }

    let mut total: i64 = 0
    i = 1
    while i <= limit {
        if can[i] == 0 {
            total = total + (i as i64)
        }
        i = i + 1
    }
    printf("%lld\n", total)
    free(can)
    free(abundant)
    free(sumdiv)
    return 0
}
