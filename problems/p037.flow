# Project Euler 037
# Sum of the eleven primes that are truncatable from left to right and
# right to left (not counting single-digit primes).

import euler.nt { is_prime }

function truncatable(n0: i64) -> bool {
    # right truncate
    let mut n: i64 = n0
    while n > 0 {
        if !is_prime(n) { return false }
        n = n / 10
    }
    # left truncate
    let mut p: i64 = 1
    while p * 10 <= n0 {
        p = p * 10
    }
    n = n0
    while p > 1 {
        n = n % p
        p = p / 10
        if !is_prime(n) { return false }
    }
    return true
}

function main() -> i32 {
    let mut total: i64 = 0
    let mut found: i64 = 0
    let mut n: i64 = 11
    while found < 11 {
        if truncatable(n) {
            total = total + n
            found = found + 1
        }
        n = n + 2
    }
    printf("%lld\n", total)
    return 0
}
