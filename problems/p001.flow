# Project Euler 001
# Sum of all multiples of 3 or 5 below 1000.
#
# Inclusion-exclusion with closed-form arithmetic series.
# Each sum is step + 2*step + ... + k*step = step * k*(k+1)/2.

function sum_ap(n: i64, step: i64) -> i64 {
    let k: i64 = (n - 1) / step
    return step * k * (k + 1) / 2
}

function main() -> i32 {
    println(sum_ap(1000, 3) + sum_ap(1000, 5) - sum_ap(1000, 15))
    return 0
}
