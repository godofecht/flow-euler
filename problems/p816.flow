# Project Euler 816 - Shortest distance between points.
# Closest pair of points via O(n log n) divide and conquer.
# 2*10^6 points generated by s_{k+1} = s_k^2 mod 50515093, s_0 = 290797.
# Pure Flow port of native/p816.c.
# Uses parallel arrays (SoA) instead of Point struct.

extern {
    function calloc(n: i64, size: i64) -> ptr<void>
    function free(p: ptr<void>) -> void
    function malloc(n: i64) -> ptr<void>
    function memcpy(dst: ptr<void>, src: ptr<void>, n: i64) -> ptr<void>
    function sqrt(x: f64) -> f64
}

const N: i64 = 2000000
const M: i64 = 50515093

# Global temp buffers for closest_rec (parallel arrays)
let mut temp_x: ptr<i32> = null
let mut temp_y: ptr<i32> = null
let mut temp_id: ptr<i32> = null

function dist2(ax: i32, ay: i32, bx: i32, by: i32) -> i64 {
    let dx: i64 = (ax as i64) - (bx as i64)
    let dy: i64 = (ay as i64) - (by as i64)
    return dx * dx + dy * dy
}

# Brute force closest pair among X[lo..hi] (using X arrays).
function brute(Xx: ptr<i32>, Xy: ptr<i32>, lo: i64, n: i64) -> i64 {
    let mut best: i64 = -1
    let mut i: i64 = 0
    while i < n {
        let mut j: i64 = i + 1
        while j < n {
            let d: i64 = dist2(Xx[lo + i], Xy[lo + i], Xx[lo + j], Xy[lo + j])
            if best < 0 || d < best {
                best = d
            }
            j = j + 1
        }
        i = i + 1
    }
    return best
}

# Sort Y arrays by y-coordinate using insertion sort (small n <= 3).
function sort_y_small(Yx: ptr<i32>, Yy: ptr<i32>, Yid: ptr<i32>, n: i64) -> void {
    let mut i: i64 = 1
    while i < n {
        let key_y: i32 = Yy[i]
        let key_x: i32 = Yx[i]
        let key_id: i32 = Yid[i]
        let mut j: i64 = i
        while j > 0 && Yy[j - 1] > key_y {
            Yy[j] = Yy[j - 1]
            Yx[j] = Yx[j - 1]
            Yid[j] = Yid[j - 1]
            j = j - 1
        }
        Yy[j] = key_y
        Yx[j] = key_x
        Yid[j] = key_id
        i = i + 1
    }
}

# Merge two sorted halves of Y (by y) back into y-order using temp buffer.
# Y[0..nl-1] and Y[nl..yn-1] are both y-sorted.
function merge_y(Yx: ptr<i32>, Yy: ptr<i32>, Yid: ptr<i32>, nl: i64, nr: i64) -> void {
    let yn: i64 = nl + nr
    let mut i: i64 = 0
    let mut j: i64 = 0
    let mut k: i64 = 0
    while i < nl && j < nr {
        if Yy[i] <= Yy[nl + j] {
            temp_x[k] = Yx[i]
            temp_y[k] = Yy[i]
            temp_id[k] = Yid[i]
            k = k + 1
            i = i + 1
        } else {
            temp_x[k] = Yx[nl + j]
            temp_y[k] = Yy[nl + j]
            temp_id[k] = Yid[nl + j]
            k = k + 1
            j = j + 1
        }
    }
    while i < nl {
        temp_x[k] = Yx[i]
        temp_y[k] = Yy[i]
        temp_id[k] = Yid[i]
        k = k + 1
        i = i + 1
    }
    while j < nr {
        temp_x[k] = Yx[nl + j]
        temp_y[k] = Yy[nl + j]
        temp_id[k] = Yid[nl + j]
        k = k + 1
        j = j + 1
    }
    let mut idx: i64 = 0
    while idx < yn {
        Yx[idx] = temp_x[idx]
        Yy[idx] = temp_y[idx]
        Yid[idx] = temp_id[idx]
        idx = idx + 1
    }
}

# Recursive closest pair.
# X arrays are sorted by x. Y arrays are sorted by y.
# lo, hi are inclusive indices into X.
function closest_rec(Xx: ptr<i32>, Xy: ptr<i32>, Xid: ptr<i32>, lo: i64, hi: i64,
                     Yx: ptr<i32>, Yy: ptr<i32>, Yid: ptr<i32>, yn: i64) -> i64 {
    let n: i64 = hi - lo + 1
    if n <= 3 {
        # Sort X[lo..hi] by y into Y (insertion sort).
        let mut i: i64 = 0
        while i < n {
            Yx[i] = Xx[lo + i]
            Yy[i] = Xy[lo + i]
            Yid[i] = Xid[lo + i]
            i = i + 1
        }
        sort_y_small(Yx, Yy, Yid, n)
        return brute(Xx, Xy, lo, n)
    }

    let mid: i64 = lo + n / 2
    let midx: i32 = Xx[mid - 1]

    # Split Y (y-sorted) into YL [id < mid] and YR [id >= mid], both y-sorted.
    let mut nl: i64 = 0
    let mut nr: i64 = 0
    let mut i: i64 = 0
    while i < yn {
        if Yid[i] < mid {
            temp_x[nl] = Yx[i]
            temp_y[nl] = Yy[i]
            temp_id[nl] = Yid[i]
            nl = nl + 1
        }
        i = i + 1
    }
    i = 0
    while i < yn {
        if Yid[i] >= mid {
            temp_x[nl + nr] = Yx[i]
            temp_y[nl + nr] = Yy[i]
            temp_id[nl + nr] = Yid[i]
            nr = nr + 1
        }
        i = i + 1
    }
    # Copy temp back into Y (first nl left, then nr right)
    i = 0
    while i < yn {
        Yx[i] = temp_x[i]
        Yy[i] = temp_y[i]
        Yid[i] = temp_id[i]
        i = i + 1
    }

    let dl: i64 = closest_rec(Xx, Xy, Xid, lo, mid - 1, Yx, Yy, Yid, nl)
    let dr: i64 = closest_rec(Xx, Xy, Xid, mid, hi, Yx + nl, Yy + nl, Yid + nl, nr)
    let mut d: i64 = dl
    if dr < d { d = dr }

    # Merge Y[0..nl-1] and Y[nl..yn-1] (both y-sorted) back into y-order.
    merge_y(Yx, Yy, Yid, nl, nr)

    # Build strip from Y (y-sorted): points within sqrt(d) of midx.
    let mut sc: i64 = 0
    i = 0
    while i < yn {
        let dx: i64 = (Yx[i] as i64) - (midx as i64)
        if dx * dx < d {
            temp_x[sc] = Yx[i]
            temp_y[sc] = Yy[i]
            temp_id[sc] = Yid[i]
            sc = sc + 1
        }
        i = i + 1
    }
    i = 0
    while i < sc {
        let mut j: i64 = i + 1
        while j < sc {
            let dy: i64 = (temp_y[j] as i64) - (temp_y[i] as i64)
            if dy * dy >= d { break }
            let dd: i64 = dist2(temp_x[i], temp_y[i], temp_x[j], temp_y[j])
            if dd < d { d = dd }
            j = j + 1
        }
        i = i + 1
    }
    return d
}

# Heapsort X arrays by x (then y) using parallel arrays.
# Also sorts id array alongside.
function heapsort_x(Xx: ptr<i32>, Xy: ptr<i32>, Xid: ptr<i32>, n: i64) -> void {
    # Build max heap
    let mut start: i64 = n / 2 - 1
    while start >= 0 {
        let mut root: i64 = start
        while root * 2 + 1 < n {
            let child: i64 = root * 2 + 1
            let mut swap: i64 = root
            # Compare by x, then y
            let mut swap_needed: bool = false
            if Xx[child] > Xx[swap] {
                swap_needed = true
            } else {
                if Xx[child] == Xx[swap] && Xy[child] > Xy[swap] {
                    swap_needed = true
                }
            }
            if swap_needed {
                swap = child
            }
            let child2: i64 = child + 1
            if child2 < n {
                let mut needed2: bool = false
                if Xx[child2] > Xx[swap] {
                    needed2 = true
                } else {
                    if Xx[child2] == Xx[swap] && Xy[child2] > Xy[swap] {
                        needed2 = true
                    }
                }
                if needed2 {
                    swap = child2
                }
            }
            if swap == root {
                break
            }
            # Swap
            let tx: i32 = Xx[root]
            let ty: i32 = Xy[root]
            let tid: i32 = Xid[root]
            Xx[root] = Xx[swap]
            Xy[root] = Xy[swap]
            Xid[root] = Xid[swap]
            Xx[swap] = tx
            Xy[swap] = ty
            Xid[swap] = tid
            root = swap
        }
        if start == 0 { break }
        start = start - 1
    }

    # Sort down
    let mut end: i64 = n - 1
    while end > 0 {
        # Swap root and end
        let tx: i32 = Xx[0]
        let ty: i32 = Xy[0]
        let tid: i32 = Xid[0]
        Xx[0] = Xx[end]
        Xy[0] = Xy[end]
        Xid[0] = Xid[end]
        Xx[end] = tx
        Xy[end] = ty
        Xid[end] = tid

        let mut root: i64 = 0
        while root * 2 + 1 < end {
            let child: i64 = root * 2 + 1
            let mut swap: i64 = root
            let mut sn: bool = false
            if Xx[child] > Xx[swap] {
                sn = true
            } else {
                if Xx[child] == Xx[swap] && Xy[child] > Xy[swap] {
                    sn = true
                }
            }
            if sn { swap = child }
            let child2: i64 = child + 1
            if child2 < end {
                let mut sn2: bool = false
                if Xx[child2] > Xx[swap] {
                    sn2 = true
                } else {
                    if Xx[child2] == Xx[swap] && Xy[child2] > Xy[swap] {
                        sn2 = true
                    }
                }
                if sn2 { swap = child2 }
            }
            if swap == root { break }
            let tx2: i32 = Xx[root]
            let ty2: i32 = Xy[root]
            let tid2: i32 = Xid[root]
            Xx[root] = Xx[swap]
            Xy[root] = Xy[swap]
            Xid[root] = Xid[swap]
            Xx[swap] = tx2
            Xy[swap] = ty2
            Xid[swap] = tid2
            root = swap
        }
        end = end - 1
    }
}

# Heapsort Y arrays by y (then x).
function heapsort_y(Yx: ptr<i32>, Yy: ptr<i32>, Yid: ptr<i32>, n: i64) -> void {
    # Build max heap
    let mut start: i64 = n / 2 - 1
    while start >= 0 {
        let mut root: i64 = start
        while root * 2 + 1 < n {
            let child: i64 = root * 2 + 1
            let mut swap: i64 = root
            let mut sn: bool = false
            if Yy[child] > Yy[swap] {
                sn = true
            } else {
                if Yy[child] == Yy[swap] && Yx[child] > Yx[swap] {
                    sn = true
                }
            }
            if sn { swap = child }
            let child2: i64 = child + 1
            if child2 < n {
                let mut sn2: bool = false
                if Yy[child2] > Yy[swap] {
                    sn2 = true
                } else {
                    if Yy[child2] == Yy[swap] && Yx[child2] > Yx[swap] {
                        sn2 = true
                    }
                }
                if sn2 { swap = child2 }
            }
            if swap == root { break }
            let tx: i32 = Yx[root]
            let ty: i32 = Yy[root]
            let tid: i32 = Yid[root]
            Yx[root] = Yx[swap]
            Yy[root] = Yy[swap]
            Yid[root] = Yid[swap]
            Yx[swap] = tx
            Yy[swap] = ty
            Yid[swap] = tid
            root = swap
        }
        if start == 0 { break }
        start = start - 1
    }

    let mut end: i64 = n - 1
    while end > 0 {
        let tx: i32 = Yx[0]
        let ty: i32 = Yy[0]
        let tid: i32 = Yid[0]
        Yx[0] = Yx[end]
        Yy[0] = Yy[end]
        Yid[0] = Yid[end]
        Yx[end] = tx
        Yy[end] = ty
        Yid[end] = tid

        let mut root: i64 = 0
        while root * 2 + 1 < end {
            let child: i64 = root * 2 + 1
            let mut swap: i64 = root
            let mut sn: bool = false
            if Yy[child] > Yy[swap] {
                sn = true
            } else {
                if Yy[child] == Yy[swap] && Yx[child] > Yx[swap] {
                    sn = true
                }
            }
            if sn { swap = child }
            let child2: i64 = child + 1
            if child2 < end {
                let mut sn2: bool = false
                if Yy[child2] > Yy[swap] {
                    sn2 = true
                } else {
                    if Yy[child2] == Yy[swap] && Yx[child2] > Yx[swap] {
                        sn2 = true
                    }
                }
                if sn2 { swap = child2 }
            }
            if swap == root { break }
            let tx2: i32 = Yx[root]
            let ty2: i32 = Yy[root]
            let tid2: i32 = Yid[root]
            Yx[root] = Yx[swap]
            Yy[root] = Yy[swap]
            Yid[root] = Yid[swap]
            Yx[swap] = tx2
            Yy[swap] = ty2
            Yid[swap] = tid2
            root = swap
        }
        end = end - 1
    }
}

function main() -> i32 {
    let Xx: ptr<i32> = malloc(N * 4)
    let Xy: ptr<i32> = malloc(N * 4)
    let Xid: ptr<i32> = malloc(N * 4)
    let Yx: ptr<i32> = malloc(N * 4)
    let Yy: ptr<i32> = malloc(N * 4)
    let Yid: ptr<i32> = malloc(N * 4)
    temp_x = malloc(N * 4)
    temp_y = malloc(N * 4)
    temp_id = malloc(N * 4)

    # Generate points (s_{2i}, s_{2i+1}) where s_0=290797, s_{k+1}=s_k^2 mod 50515093.
    let mut s: i64 = 290797
    let mut i: i64 = 0
    while i < N {
        let s0: i64 = s
        let s1: i64 = (s0 * s0) % M
        Xx[i] = s0 as i32
        Xy[i] = s1 as i32
        s = (s1 * s1) % M
        i = i + 1
    }

    # Sort X by (x, y)
    i = 0
    while i < N {
        Xid[i] = i as i32
        i = i + 1
    }
    heapsort_x(Xx, Xy, Xid, N)

    # Copy X to Y, then sort Y by (y, x)
    i = 0
    while i < N {
        Yx[i] = Xx[i]
        Yy[i] = Xy[i]
        Yid[i] = Xid[i]
        i = i + 1
    }
    heapsort_y(Yx, Yy, Yid, N)

    let d2: i64 = closest_rec(Xx, Xy, Xid, 0, N - 1, Yx, Yy, Yid, N)

    let ans: f64 = sqrt(d2 as f64)
    printf("%.9f\n", ans)

    free(Xx)
    free(Xy)
    free(Xid)
    free(Yx)
    free(Yy)
    free(Yid)
    free(temp_x)
    free(temp_y)
    free(temp_id)
    return 0
}
