# Project Euler 005
# Smallest positive number evenly divisible by 1..20.
#
# LCM via successive gcd — shared helpers from euler.nt.

import euler.nt { gcd, lcm }

function solve(limit: i64) -> i64 {
    let mut result: i64 = 1
    for n in 2..(limit + 1) {
        result = lcm(result, n)
    }
    return result
}

function main() -> i32 {
    printf("%lld\n", solve(20))
    return 0
}
