# Project Euler 210
# Obtuse angled triangles N(10^9).

import euler.nt { isqrt }

function strip_points(n: i64, start: i64, stop: i64) -> i64 {
    let mut total: i64 = 0
    let mut rem: i64 = n - start * start
    let mut x: i64 = start
    while x < stop {
        total = total + 2 * isqrt(rem) + 1
        rem = rem - 2 * x - 1
        x = x + 1
    }
    return total
}

function circle_points_leq(n: i64) -> i64 {
    if n < 0 { return 0 }
    let r: i64 = isqrt(n)
    let m: i64 = isqrt(n / 2)
    let mut total: i64 = (2 * m + 1) * (2 * m + 1)
    let start: i64 = m + 1
    let stop: i64 = r + 1
    total = total + 4 * strip_points(n, start, stop)
    return total
}

function N(r: i64) -> i64 {
    let a: i64 = r / 4
    let N_O: i64 = r * r + r / 2
    let N_C: i64 = (r * (2 * r + 1)) / 4
    let n_total: i64 = a * a - 1
    let n_even: i64 = (a * a - 1) / 2
    let mut N_B: i64 = 0
    if a % 2 == 0 {
        N_B = circle_points_leq(n_even)
    } else {
        N_B = circle_points_leq(n_total) - circle_points_leq(n_even)
    }
    let degenerate: i64 = r - 1
    return N_O + N_C + N_B - degenerate
}

function main() -> i32 {
    printf("%lld\n", N(1000000000))
    return 0
}
